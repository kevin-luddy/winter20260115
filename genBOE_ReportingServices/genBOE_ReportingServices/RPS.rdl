                        <CanGrow>true</CanGrow>
                        <KeepTogether>true</KeepTogether>
                        <Paragraphs>
                          <Paragraph>
                            <TextRuns>
                              <TextRun>
                                <Value>=MonthName(Month(DateAdd("m", CInt(Fields!Month.Value) - 1, CDate(Fields!StartDate.Value))), true) &amp; " " &amp; Year(DateAdd("m", CInt(Fields!Month.Value) - 1, CDate(Fields!StartDate.Value)))</Value>
