<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition">
  <DataSources>
    <DataSource Name="genBOE">
      <DataSourceReference>genBOE</DataSourceReference>
      <rd:DataSourceID>92519530-92e5-4f28-8a0b-22a9c2ed2c2d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Fields>
        <Field Name="WorkspaceName">
          <DataField>WorkspaceName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TotalAll">
          <DataField>TotalAll</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>genBOE</DataSourceName>
        <CommandText>EXECUTE  [dbo].[FinancialLeadershipAcademy_getLaborBOEHours] @WorkapceID</CommandText>
        <QueryParameters>
          <QueryParameter Name="@WorkapceID">
            <Value>=Parameters!WorkspaceID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
    <DataSet Name="getWorkspaceID">
      <Fields>
        <Field Name="WorkspaceID">
          <DataField>WorkspaceID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="WorkspaceName">
          <DataField>WorkspaceName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>genBOE</DataSourceName>
        <CommandText>SELECT -1 AS WorkspaceID, 'All' AS WorkspaceName 
FROM dbo.Workspace

UNION

SELECT W.WorkspaceID, W.WorkspaceName
FROM dbo.Workspace W 
INNER JOIN dbo.WorkspaceStateHistory H ON W.WorkspaceID = H.WorkspaceID
INNER JOIN dbo.WorkspaceStateLU S ON H.CurrentWorkspaceStateID	 = S.WorkspaceStateID
WHERE 
H.CurrentWorkspaceStateID = 0 AND
H.UpdatedWorkspaceStateID = 1 AND
H.UpdateDT &gt;=  '01-01-2014' AND
H.UpdateDT &lt;  '04-01-2014' </CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
