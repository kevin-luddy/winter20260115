<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="genBOE">
      <DataSourceReference>genBOE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>9f307c15-7c34-453c-bbaf-83345923af41</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>genBOE</DataSourceName>
        <CommandText>/*
Need a Workspace Analysis
*/

SELECT 
	(SELECT COUNT (WorkspaceID)	AS [Total Workspaces]				FROM dbo.Workspace					) AS [Total Workspaces],
	(SELECT COUNT (BOEID)		AS [Total BOE]						FROM dbo.BOE						) AS [Total BOE],
	(SELECT COUNT (BOEStateID)	AS [BOE State - Unassigned]			FROM dbo.BOE WHERE BOEStateID = 1	) AS [BOE State - Unassigned],
	(SELECT COUNT (BOEStateID)	AS [BOE State - Draft]				FROM dbo.BOE WHERE BOEStateID = 2	) AS [BOE State - Draft],
	(SELECT COUNT (BOEStateID)	AS [BOE State - Awaiting Approval]	FROM dbo.BOE WHERE BOEStateID = 3	) AS [BOE State - Awaiting Approval],
	(SELECT COUNT (BOEStateID)	AS [BOE State - Approved]			FROM dbo.BOE WHERE BOEStateID = 4	) AS [BOE State - Approved],
W.WorkspaceName AS [Workspace Name],
WSCreatedBy.DisplayName AS [Workspace Created By],
WS.LatestActivityDate AS [Latest Activity Date],
WorkspaceCreatedOn.WorkspaceCreatedOn AS [Workspace Created On],
WSL.WorkspaceState AS [Workspace State],
	 (
		BOECount.[BOE State: None] +
		BOECount.[BOE State: Unassigned] +
		BOECount.[BOE State: Draft] +
		BOECount.[BOE State: Awaiting Approval] +
		BOECount.[BOE State: Approved]
	) AS [Total Number Of BOEs],
BOECount.[BOE State: None],
BOECount.[BOE State: Unassigned],
BOECount.[BOE State: Draft],
BOECount.[BOE State: Awaiting Approval],
BOECount.[BOE State: Approved],
CostVolumeLeadPricer.DisplayName AS [CostVolumeLead/Pricer],
W.TrackingNumber AS [TrackingID],
W.ProposalSubmitDate AS [ProposalSubmittalDate],
CASE W.ContainsTemplate
	WHEN 1 THEN 'Yes'
	WHEN 0 THEN 'No'
	ELSE 'N/A'
END AS [BOE Content Template]

FROM dbo.Workspace W
	INNER JOIN dbo.ETIuser WSCreatedBy ON W.CreatedByETIUserID = WSCreatedBy.ETIUserID
	INNER JOIN dbo.WorkspaceStateLU WSL ON W.WorkspaceStateID = WSL.WorkspaceStateID
	INNER JOIN dbo.ETIuser CostVolumeLeadPricer ON W.CostVolumeLeadPricerUserID = CostVolumeLeadPricer.ETIUserID
	LEFT OUTER JOIN 
	(
		SELECT 
		SUM ([BOE State - None]) AS [BOE State: None],
		SUM ([BOE State - Unassigned]) AS [BOE State: Unassigned],
		SUM ([BOE State - Draft]) AS [BOE State: Draft],
		SUM ([BOE State - Awaiting Approval]) AS [BOE State: Awaiting Approval],
		SUM ([BOE State - Approved]) AS [BOE State: Approved],
		WorkspaceID
		FROM 
			(
			SELECT 
			B.WorkspaceID, 
			CASE WHEN B.BOEStateID = 0 THEN  Count(B.boestateid)  ELSE 0 END AS [BOE State - None],
			CASE WHEN B.BOEStateID = 1 THEN  Count(B.boestateid)  ELSE 0  END AS [BOE State - Unassigned],
			CASE WHEN B.BOEStateID = 2 THEN  Count(B.boestateid)  ELSE 0  END AS [BOE State - Draft],
			CASE WHEN B.BOEStateID = 3 THEN  Count(B.boestateid)  ELSE 0  END AS [BOE State - Awaiting Approval],
			CASE WHEN B.BOEStateID = 4 THEN  Count(B.boestateid)  ELSE 0  END AS [BOE State - Approved]
			FROM dbo.BOE B
				INNER JOIN dbo.BOEStateLU S ON B.BOEStateID = S.BOEStateID
			GROUP BY B.WorkspaceID, B.boestateid
			) AS BOECount_IJ GROUP BY WorkspaceID
	) BOECount ON W.WorkspaceID = BOECount.WorkspaceID
	
	INNER JOIN
	(
	SELECT UpdateDT AS WorkspaceCreatedOn, WorkspaceID AS WorkspaceID
	FROM dbo.WorkspaceStateHistory 
	WHERE CurrentWorkspaceStateID = 0 /*None - First Entry in DB*/
	)	WorkspaceCreatedOn ON W.WorkspaceID = WorkspaceCreatedOn.WorkspaceID
	INNER JOIN
	(
SELECT MAX(WS.LatestActivityDate) AS LatestActivityDate, WS.WorkspaceID AS WorkspaceID
FROM
(
SELECT MAX(X.UpdateDT) AS LatestActivityDate, WS.WorkspaceID
			FROM dbo.BOELaborTypeCustomFieldValueXREF X
				INNER JOIN dbo.BOELaborType LT ON X.BOELaborTypeID = LT.BOELaborTypeID
				INNER JOIN dbo.BOETaskElement TE ON LT.BOETaskElementID = TE.BOETaskElementID
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(X.UpdateDT) AS LatestActivityDate,WS.WorkspaceID
			FROM dbo.BOELaborTypeCustomFieldValueXREF X
		INNER JOIN dbo.CustomFieldValue CFV ON CFV.CustomFieldValueID = X.CustomFieldValueID
			INNER JOIN dbo.CustomField CF ON CFV.CustomFieldID = CF.CustomFieldID
			INNER JOIN dbo.Workspace WS ON CF.WorkspaceID = WS.WorkspaceID
GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(OV.UpdateDT) AS LatestActivityDate,WS.WorkspaceID				
			FROM dbo.OrdinaryVariable OV
				INNER JOIN dbo.BOETaskElement TE ON OV.BOETaskElementID = TE.BOETaskElementID
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(X.UpdateDT) AS LatestActivityDate,WS.WorkspaceID		FROM [dbo].[BOECustomFieldValueXREF] X
			INNER JOIN dbo.BOE B ON X.BOEID = B.BOEID
			INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
GROUP BY WS.WorkspaceID
UNION				
SELECT MAX(X.UpdateDT) AS LatestActivityDate,WS.WorkspaceID		FROM [dbo].[BOECustomFieldValueXREF] X
			INNER JOIN dbo.CustomFieldValue CFV ON CFV.CustomFieldValueID = X.CustomFieldValueID
			INNER JOIN dbo.CustomField CF ON CFV.CustomFieldID = CF.CustomFieldID
			INNER JOIN dbo.Workspace WS ON CF.WorkspaceID = WS.WorkspaceID
GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(LT.UpdateDT) AS LatestActivityDate,WS.WorkspaceID			
FROM dbo.BOELaborType LT 
				INNER JOIN dbo.BOETaskElement TE ON LT.BOETaskElementID = TE.BOETaskElementID
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(BAH.UpdateDT) AS LatestActivityDate,WS.WorkspaceID 
				FROM dbo.BOEApprovalHistory BAH 
				INNER JOIN dbo.BOE B ON BAH.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(BCH.UpdateDT) AS LatestActivityDate,WS.WorkspaceID
				FROM dbo.BOECommentHistory BCH 
				INNER JOIN dbo.BOE B ON BCH.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(X.UpdateDT) AS LatestActivityDate,WS.WorkspaceID
			FROM dbo.BOETaskElementCustomFieldValueXREF X 
				INNER JOIN dbo.BOETaskElement TE ON X.BOETaskElementID = TE.BOETaskElementID 
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(X.UpdateDT) AS LatestActivityDate,WS.WorkspaceID
			FROM dbo.BOETaskElementCustomFieldValueXREF X 
			INNER JOIN dbo.CustomFieldValue CFV ON CFV.CustomFieldValueID = X.CustomFieldValueID
			INNER JOIN dbo.CustomField CF ON CFV.CustomFieldID = CF.CustomFieldID
			INNER JOIN dbo.Workspace WS ON CF.WorkspaceID = WS.WorkspaceID
GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(TE.UpdateDT) AS LatestActivityDate,WS.WorkspaceID
				FROM dbo.BOEUserRoleHistory TE
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(TE.UpdateDT) AS LatestActivityDate,WS.WorkspaceID
				FROM dbo.BOEUserRole TE 
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(TE.UpdateDT) AS LatestActivityDate,WS.WorkspaceID
			FROM dbo.BOETaskElement TE 
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(TE.UpdateDT) AS LatestActivityDate,WS.WorkspaceID
				FROM dbo.BOEComment TE
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(TE.UpdateDT) AS LatestActivityDate,WS.WorkspaceID
				FROM dbo.BOEApproval TE
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(TE.UpdateDT) AS LatestActivityDate,WS.WorkspaceID
				FROM dbo.BOEStateHistory TE
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(X.UpdateDT) AS LatestActivityDate,WS.WorkspaceID
			FROM dbo.MaterialCustomFieldValueXREF X
				INNER JOIN dbo.Material M ON X.MaterialID = M.MaterialID
				INNER JOIN dbo.MaterialTaskElement TE ON M.MaterialTaskElementID = TE.MaterialTaskElementID
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(X.UpdateDT) AS LatestActivityDate,WS.WorkspaceID
			FROM dbo.MaterialCustomFieldValueXREF X
			INNER JOIN dbo.CustomFieldValue CFV ON CFV.CustomFieldValueID = X.CustomFieldValueID
			INNER JOIN dbo.CustomField CF ON CFV.CustomFieldID = CF.CustomFieldID
			INNER JOIN dbo.Workspace WS ON CF.WorkspaceID = WS.WorkspaceID
GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(M.UpdateDT) AS LatestActivityDate,WS.WorkspaceID
			FROM dbo.Material M 
				INNER JOIN dbo.MaterialTaskElement TE ON M.MaterialTaskElementID = TE.MaterialTaskElementID
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(X.UpdateDT) AS LatestActivityDate,WS.WorkspaceID			
				FROM dbo.MaterialTaskElementCustomFieldValueXREF X
				INNER JOIN dbo.MaterialTaskElement TE ON X.MaterialTaskElementID = TE.MaterialTaskElementID
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(X.UpdateDT) AS LatestActivityDate,WS.WorkspaceID			
				FROM dbo.MaterialTaskElementCustomFieldValueXREF X
			INNER JOIN dbo.CustomFieldValue CFV ON CFV.CustomFieldValueID = X.CustomFieldValueID
			INNER JOIN dbo.CustomField CF ON CFV.CustomFieldID = CF.CustomFieldID
			INNER JOIN dbo.Workspace WS ON CF.WorkspaceID = WS.WorkspaceID
GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(TE.UpdateDT) AS LatestActivityDate,WS.WorkspaceID
			FROM dbo.MaterialTaskElement TE
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(X.UpdateDT) AS LatestActivityDate,WS.WorkspaceID
				FROM dbo.ODCTypeCustomFieldValueXREF X
				INNER JOIN dbo.ODCType O ON X.ODCTypeID = O.ODCTypeID
				INNER JOIN dbo.ODCTaskElement TE ON O.ODCTaskElementID = TE.ODCTaskElementID
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(X.UpdateDT) AS LatestActivityDate,WS.WorkspaceID
				FROM dbo.ODCTypeCustomFieldValueXREF X
			INNER JOIN dbo.CustomFieldValue CFV ON CFV.CustomFieldValueID = X.CustomFieldValueID
			INNER JOIN dbo.CustomField CF ON CFV.CustomFieldID = CF.CustomFieldID
			INNER JOIN dbo.Workspace WS ON CF.WorkspaceID = WS.WorkspaceID
GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(T.UpdateDT) AS LatestActivityDate,WS.WorkspaceID         
			FROM dbo.ODCType T 
				INNER JOIN dbo.ODCTaskElement TE ON T.ODCTaskElementID = TE.ODCTaskElementID
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(X.UpdateDT) AS LatestActivityDate,WS.WorkspaceID			
				FROM dbo.ODCTaskElementCustomFieldValueXREF X
				INNER JOIN dbo.ODCTaskElement TE ON X.ODCTaskElementID = TE.ODCTaskElementID
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(X.UpdateDT) AS LatestActivityDate,WS.WorkspaceID			
				FROM dbo.ODCTaskElementCustomFieldValueXREF X
			INNER JOIN dbo.CustomFieldValue CFV ON CFV.CustomFieldValueID = X.CustomFieldValueID
			INNER JOIN dbo.CustomField CF ON CFV.CustomFieldID = CF.CustomFieldID
			INNER JOIN dbo.Workspace WS ON CF.WorkspaceID = WS.WorkspaceID
GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(TE.UpdateDT) AS LatestActivityDate,WS.WorkspaceID          
			FROM dbo.ODCTaskElement TE 
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(X.UpdateDT) AS LatestActivityDate,WS.WorkspaceID
				FROM dbo.TravelTripCustomFieldValueXREF X
				INNER JOIN dbo.TravelTrip T ON X.TravelTripID = T.TravelTripID
				INNER JOIN dbo.TravelTripTaskElement TE ON T.TravelTripTaskElementID = TE.TravelTripTaskElementID
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(X.UpdateDT) AS LatestActivityDate,WS.WorkspaceID
				FROM dbo.TravelTripCustomFieldValueXREF X	
			INNER JOIN dbo.CustomFieldValue CFV ON CFV.CustomFieldValueID = X.CustomFieldValueID
			INNER JOIN dbo.CustomField CF ON CFV.CustomFieldID = CF.CustomFieldID
			INNER JOIN dbo.Workspace WS ON CF.WorkspaceID = WS.WorkspaceID
GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(T.UpdateDT) AS LatestActivityDate,WS.WorkspaceID            
			FROM dbo.TravelTrip T 
				INNER JOIN dbo.TravelTripTaskElement TE ON T.TravelTripTaskElementID = TE.TravelTripTaskElementID
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(X.UpdateDT) AS LatestActivityDate,WS.WorkspaceID				
				FROM dbo.TravelTripTaskElementCustomFieldValueXREF X
				INNER JOIN dbo.TravelTripTaskElement TE ON X.TravelTripTaskElementID = TE.TravelTripTaskElementID
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(X.UpdateDT) AS LatestActivityDate,WS.WorkspaceID			
				FROM dbo.TravelTripTaskElementCustomFieldValueXREF X
		INNER JOIN dbo.CustomFieldValue CFV ON CFV.CustomFieldValueID = X.CustomFieldValueID
			INNER JOIN dbo.CustomField CF ON CFV.CustomFieldID = CF.CustomFieldID
			INNER JOIN dbo.Workspace WS ON CF.WorkspaceID = WS.WorkspaceID
GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(TE.UpdateDT) AS LatestActivityDate,WS.WorkspaceID              
			FROM dbo.TravelTripTaskElement TE 
				INNER JOIN dbo.BOE B ON TE.BOEID = B.BOEID
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(CFV.UpdateDT) AS LatestActivityDate,CF.WorkspaceID 			
FROM dbo.CustomFieldValue CFV 
				INNER JOIN dbo.CustomField CF ON CFV.CustomFieldID = CF.CustomFieldID
	GROUP BY CF.WorkspaceID  
UNION				
SELECT MAX(WBS.UpdateDT) AS LatestActivityDate,W.WorkspaceID
			FROM dbo.WorkBreakdownStructure WBS 
				INNER JOIN dbo.Workspace W ON WBS.WorkspaceID = W.WorkspaceID
	GROUP BY W.WorkspaceID   
UNION				
SELECT MAX(B.UpdateDT) AS LatestActivityDate,WS.WorkspaceID
			FROM dbo.BOE B 
				INNER JOIN dbo.Workspace WS ON B.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID
							
UNION
/*
ADD WHEN RELEASE 2.0 IS PUSHED TO PRODUCTION
*/
SELECT MAX(WH.UpdateDT) AS LatestActivityDate,W.WorkspaceID
			FROM [dbo].[WorkspaceStateHistory] WH 
					INNER JOIN  dbo.Workspace W ON WH.WorkspaceID = W.WorkspaceID
	GROUP BY W.WorkspaceID   
UNION				
SELECT MAX(WUR.UpdateDT) AS LatestActivityDate,W.WorkspaceID
			FROM [dbo].[WorkspaceUserRole] WUR
				INNER JOIN  dbo.Workspace W ON WUR.WorkspaceID = W.WorkspaceID
	GROUP BY W.WorkspaceID   
UNION				
SELECT MAX(WV.UpdateDT) AS LatestActivityDate,W.WorkspaceID
				FROM dbo.WorkspaceVariable  WV
					INNER JOIN dbo.Workspace W ON WV.WorkspaceID = W.WorkspaceID
		GROUP BY W.WorkspaceID   
UNION				
SELECT MAX(C.UpdateDT) AS LatestActivityDate,WS.WorkspaceID
			FROM dbo.CLIN C 
				INNER JOIN dbo.Workspace WS ON C.WorkspaceID = WS.WorkspaceID
	GROUP BY WS.WorkspaceID 
UNION				
SELECT MAX(UpdateDT) AS LatestActivityDate,WorkspaceID 
FROM [dbo].[BOEPotentialRole] 
	GROUP BY WorkspaceID  
UNION				
SELECT MAX(UpdateDT) AS LatestActivityDate,WorkspaceID 
			FROM dbo.WorkspaceUserRole
	GROUP BY WorkspaceID 
UNION				
SELECT MAX(PO.UpdateDT) AS LatestActivityDate,W.WorkspaceID 
			FROM [dbo].[PerformingOrganization] PO
				INNER JOIN dbo.PerformingOrganizationList PL ON PO.PerformingOrganizationListID = PL.PerformingOrganizationListID
				INNER JOIN dbo.Workspace W ON PL.PerformingOrganizationListID = W.PerformingOrganizationListID
	GROUP BY W.WorkspaceID 
UNION				
SELECT MAX(R.UpdateDT) AS LatestActivityDate,W.WorkspaceID 
FROM [dbo].[Resource] R
INNER JOIN dbo.ResourceList RL ON R.ResourceListID = RL.ResourceListID
INNER JOIN dbo.Workspace W ON RL.ResourceListID = W.ResourceListID
GROUP BY W.WorkspaceID 
				
				
UNION				
SELECT MAX(CFV.UpdateDT) AS LatestActivityDate,CF.WorkspaceID 
FROM dbo.CustomFieldValue CFV
	INNER JOIN dbo.CustomField CF ON CFV.CustomFieldID = CF.CustomFieldID
GROUP BY CF.WorkspaceID 
	 
UNION				
		
SELECT MAX(UpdateDT) AS LatestActivityDate,WorkspaceID 
FROM dbo.CustomField 
GROUP BY WorkspaceID
	 
UNION				
		
SELECT MAX(UpdateDT) AS LatestActivityDate,WorkspaceID 
FROM dbo.Workspace 
GROUP BY WorkspaceID 
	 
UNION				
		
	SELECT MAX(PL.UpdateDT) AS LatestActivityDate,W.WorkspaceID 
			FROM dbo.PerformingOrganizationList PL
				INNER JOIN dbo.Workspace W ON PL.PerformingOrganizationListID = W.PerformingOrganizationListID
	GROUP BY W.WorkspaceID  
UNION				
SELECT MAX(RL.UpdateDT) AS LatestActivityDate,W.WorkspaceID
			FROM dbo.ResourceList RL
				INNER JOIN dbo.Workspace W ON RL.ResourceListID = W.ResourceListID
	GROUP BY W.WorkspaceID 	
) WS 
GROUP BY WS.WorkspaceID ) WS ON W.WorkspaceID = WS.WorkspaceID</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Total_Workspaces">
          <DataField>Total Workspaces</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Total_BOE">
          <DataField>Total BOE</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="BOE_State___Unassigned">
          <DataField>BOE State - Unassigned</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="BOE_State___Draft">
          <DataField>BOE State - Draft</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="BOE_State___Awaiting_Approval">
          <DataField>BOE State - Awaiting Approval</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="BOE_State___Approved">
          <DataField>BOE State - Approved</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Workspace_Name">
          <DataField>Workspace Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Workspace_Created_By">
          <DataField>Workspace Created By</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Latest_Activity_Date">
          <DataField>Latest Activity Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Workspace_Created_On">
          <DataField>Workspace Created On</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Workspace_State">
          <DataField>Workspace State</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Total_Number_Of_BOEs">
          <DataField>Total Number Of BOEs</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="BOE_State__None">
          <DataField>BOE State: None</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="BOE_State__Unassigned">
          <DataField>BOE State: Unassigned</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="BOE_State__Draft">
          <DataField>BOE State: Draft</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="BOE_State__Awaiting_Approval">
          <DataField>BOE State: Awaiting Approval</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="BOE_State__Approved">
          <DataField>BOE State: Approved</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CostVolumeLead_Pricer">
          <DataField>CostVolumeLead/Pricer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TrackingID">
          <DataField>TrackingID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProposalSubmittalDate">
          <DataField>ProposalSubmittalDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
