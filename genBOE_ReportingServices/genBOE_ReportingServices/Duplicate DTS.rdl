<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition">
  <DataSources>
    <DataSource Name="genBOE">
      <DataSourceReference>genBOE</DataSourceReference>
      <rd:DataSourceID>53c89ea7-747e-40ed-991a-cb229638db43</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Fields>
        <Field Name="WorkspaceID">
          <DataField>WorkspaceID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="WorkspaceName">
          <DataField>WorkspaceName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>genBOE</DataSourceName>
        <CommandText>DECLARE @Duplicate TABLE 
(
	BOETaskElementID int,
	BOEID int,
	Processed bit DEFAULT 0,
	DeleteMe bit DEFAULT 0,
	KeepMe BIT DEFAULT 0,
	ContainsLaborType BIT DEFAULT 0,
	ContainsLaborSpread BIT DEFAULT 0,
	PROBLEM BIT DEFAULT 0
	
)
INSERT INTO @Duplicate (BOETaskElementID, BOEID, ContainsLaborType,ContainsLaborSpread)
SELECT TE.BOETaskElementID, TE.BOEID,
CASE WHEN LT.BOELaborTypeID IS NOT NULL THEN 1 ELSE 0 END AS ContainsLaborType,
CASE WHEN LS.BOELaborSpreadID IS NOT NULL THEN 1 ELSE 0 END AS ContainsLaborSpread
FROM
	(
	SELECT COUNT (BOETaskElementID) as CT, TaskElementTypeID, BOEID
	FROM dbo.BOETaskElement
	where TaskElementTypeID = 3
	--and BOEID in (select BOEID from dbo.BOE where WorkspaceID =@WorkspaceID)
	group by TaskElementTypeID, BOEID
	HAVING COUNT (BOETaskElementID) &gt; 9
	) B INNER JOIN dbo.BOETaskElement TE ON B.BOEID = TE.BOEID 

LEFT OUTER JOIN dbo.BOELaborType LT ON TE.BOETaskElementID  = LT.BOETaskElementID
LEFT OUTER JOIN dbo.BOELaborSpread LS ON  LT.BOELaborTypeID = LS.BOELaborTypeID
WHERE TE.TaskElementTypeID = 3/*for testing	AND B.BOEID = 18924*/
ORDER BY BOETaskElementID DESC


SELECT DISTINCT
	W.WorkspaceID,
	W.WorkspaceName
--select * from @Duplicate --where ContainsLaborSpread = 1 and DeleteMe = 1 -- BOEID = 18925
FROM @Duplicate D
	INNER JOIN dbo.BOE B ON D.BOEID = B.BOEID
	INNER JOIN dbo.Workspace W ON B.WorkspaceID = W.WorkspaceID
/*
WI 27918
Filter out existing (old/known) dts duplicate workspaces
These are known to the end users/team.

 

Workspace ID Workspace Name 
640 13SCV4W - HOST Sustainment Extension 
1277 Do NOT Use - Test Copy - 2013-02877-GBS SBM DECC Transition CCP-005 
1280 2013-03001 - GEOCOMPASS RCP-007 
1343 DTS Calculation Issue - 2013-03001 - GEOCOMPASS RCP-007Duplicate01 

*/
WHERE W.WorkspaceID NOT IN (640, 1277, 1280, 1343)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
