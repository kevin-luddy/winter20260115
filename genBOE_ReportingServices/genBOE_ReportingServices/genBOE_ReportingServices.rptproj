<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <FullPath>Debug</FullPath>
    <OutputPath>bin\Debug</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>genBOE_ReportingServices</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://localhost/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'DebugLocal' ">
    <FullPath>DebugLocal</FullPath>
    <OutputPath>bin\DebugLocal</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>genBOE_ReportingServices</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://localhost/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <FullPath>Release</FullPath>
    <OutputPath>bin\Release</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>genBOE_ReportingServices</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://localhost/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup>
    <State>$base64$</State>
    <DataSources>@(DataSource)</DataSources>
    <DataSets>@(DataSet)</DataSets>
    <Reports>@(Report)</Reports>
  </PropertyGroup>
  <ItemGroup>
    <DataSet Include="EnvironmentConfigs.rsd" />
  </ItemGroup>
  <ItemGroup>
    <DataSource Include="genBOE.rds" />
  </ItemGroup>
  <ItemGroup>
    <Report Include="BOESummaryReport.rdl" />
    <Report Include="ByCatPricingCode.rdl" />
    <Report Include="ByPricingCode.rdl" />
    <Report Include="Copy BOE Metric Report.rdl" />
    <Report Include="Copy Workspace Metric Report.rdl" />
    <Report Include="Corporate BOE MOQ Type Metrics Report.rdl" />
    <Report Include="CostAnalysisReportRMS.rdl" />
    <Report Include="CreateCompliance_WorkspaceCreationReport.rdl" />
    <Report Include="CreateExcelReport.rdl" />
    <Report Include="Duplicate DTS.rdl" />
    <Report Include="Financial Leadership Academy Report - Labor BOE Count.rdl" />
    <Report Include="Financial Leadership Academy Report - Labor BOE Hours.rdl" />
    <Report Include="Financial Leadership Academy Report - Quoting Method Count.rdl" />
    <Report Include="Financial Leadership Academy Report - Workspace ProposalType.rdl" />
    <Report Include="FlattenedCostAnalysisReport.rdl" />
    <Report Include="genBOE Export BOE.rdl" />
    <Report Include="GenBOE_Analysis.rdl" />
    <Report Include="GenBOE_Summary.rdl" />
    <Report Include="Metric Analysis Report.rdl" />
    <Report Include="MOQ_Equations_Vs_Resource_Spread.rdl" />
    <Report Include="OffloadCostByYear.rdl" />
    <Report Include="OffloadCostSummary.rdl" />
    <Report Include="OffloadDetailedReport.rdl" />
    <Report Include="PreVsPostOffloadTotals.rdl" />
    <Report Include="ProjectCLINCostSummary.rdl" />
    <Report Include="PRP.rdl" />
    <Report Include="RAM.rdl" />
    <Report Include="RPS.rdl" />
    <Report Include="StaffingCurves.rdl" />
    <Report Include="SummaryReportRMS.rdl" />
    <Report Include="SumOfBOEsVariable.rdl" />
    <Report Include="User Access Report.rdl" />
    <Report Include="UsersWithRolesReport.rdl" />
    <Report Include="WorkbenchOffload.rdl" />
    <Report Include="Workspace Output Format Template.rdl" />
    <Report Include="WorkspaceUsers.rdl" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Reporting Services\Microsoft.ReportingServices.MSBuilder.targets" />
</Project>