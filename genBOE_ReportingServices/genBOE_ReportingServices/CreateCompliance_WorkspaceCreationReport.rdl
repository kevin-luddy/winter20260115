  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>genBOE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>CreateCompliance_WorkspaceCreationReport</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Workspace_Creation_Date">
          <DataField>Workspace Creation Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Workspace_ID">
          <DataField>Workspace ID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Workspace_Name">
          <DataField>Workspace Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Workspace_Short_Name">
          <DataField>Workspace Short Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DefaultStartDate">
      <Query>
        <DataSourceName>genBOE</DataSourceName>
        <CommandText>SELECT     DATEADD(year, DATEDIFF(year, - 1, GETDATE()) - 1, 0) AS DefaultStartDate</CommandText>
      </Query>
      <Fields>
        <Field Name="DefaultStartDate">
          <DataField>DefaultStartDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DefaultEndDate">
      <Query>
        <DataSourceName>genBOE</DataSourceName>
        <CommandText>SELECT     DATEADD(ss, - 1, DATEADD(month, DATEDIFF(month, 0, GETDATE()), 0)) AS DefaultEndDate</CommandText>
      </Query>
      <Fields>
        <Field Name="DefaultEndDate">
          <DataField>DefaultEndDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="StartDate">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>DefaultStartDate</DataSetName>
          <ValueField>DefaultStartDate</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>Start Date</Prompt>
    </ReportParameter>
    <ReportParameter Name="EndDate">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <DefaultValue>
        <DataSetReference>
