<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition">
  <DataSources>
    <DataSource Name="genBOE">
      <DataSourceReference>genBOE</DataSourceReference>
      <rd:DataSourceID>247cb9d1-27b2-401a-8a77-57ff2c7d303a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Fields>
        <Field Name="WorkspaceName">
          <DataField>WorkspaceName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WorkspaceShortName">
          <DataField>WorkspaceShortName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WorkspaceTemplate">
          <DataField>WorkspaceTemplate</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WorkspaceTemplateDescription">
          <DataField>WorkspaceTemplateDescription</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>genBOE</DataSourceName>
        <CommandText>SELECT DISTINCT
W.WorkspaceName, 
W.WorkspaceShortName, 
WT.Template AS WorkspaceTemplate, 
WT.TemplateDescription AS WorkspaceTemplateDescription
FROM dbo.Workspace W
INNER JOIN dbo.OutputFormatTemplate WT ON W.TemplateID = WT.TemplateID
ORDER BY WT.Template, W.WorkspaceName</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
