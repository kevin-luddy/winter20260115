  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="genBOE">
      <DataSourceReference>genBOE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>821a7e2a-2540-40a5-97dc-bb4905ccbb46</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>genBOE</DataSourceName>
        <CommandText>/*
List of all the unique users for each workspace
*/

SELECT DISTINCT IJ.WorkspaceName,  IJ.DisplayName, IJ.RoleName, IJ.NTDomain, IJ.NTID
FROM (
SELECT WorkspaceName, u.DisplayName, R.RoleName, U.NTDomain, U.NTID
FROM Workspace WS
	INNER JOIN dbo.WorkspaceUserRole WUR ON WS.WorkspaceID = WUR.WorkspaceID
	INNER JOIN ETIuser U ON WUR.ETIUserID = U.ETIUserID
	INNER JOIN dbo.RoleLU R ON WUR.RoleID = R.RoleID
UNION ALL
SELECT WorkspaceName, PRE.DisplayName, PR_R.RoleName, PRE.NTDomain, PRE.NTID
FROM Workspace WS
	INNER JOIN dbo.BOEPotentialRole PR ON WS.WorkspaceID = PR.WorkspaceID
	INNER JOIN ETIuser PRE ON PR.ETIUserID = PRE.ETIUserID
	INNER JOIN dbo.RoleLU PR_R ON PR.RoleID = PR_R.RoleID
	WHERE PR.UserRemoved = 0	
UNION ALL
SELECT WorkspaceName, BE.DisplayName, BR.RoleName, BE.NTDomain, BE.NTID
FROM Workspace WS
	INNER JOIN DBO.BOE B ON WS.WorkspaceID = B.WorkspaceID
	INNER JOIN BOEUserRole BUR ON B.BOEID = BUR.BOEID
	INNER JOIN ETIuser BE ON BUR.ETIUserID = BE.ETIUserID
	INNER JOIN dbo.RoleLU BR ON BUR.RoleID = BR.RoleID
) IJ 
ORDER BY IJ.WorkspaceName, IJ.RoleName, IJ.DisplayName</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="WorkspaceName">
          <DataField>WorkspaceName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DisplayName">
          <DataField>DisplayName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RoleName">
          <DataField>RoleName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NTDomain">
          <DataField>NTDomain</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NTID">
          <DataField>NTID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
