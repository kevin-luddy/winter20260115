    </ReportItems>
    <Height>1.21in</Height>
    <Style />
  </Body>
  <Width>32.41667in</Width>
  <Page>
    <LeftMargin>1in</LeftMargin>
    <RightMargin>1in</RightMargin>
    <TopMargin>1in</TopMargin>
    <BottomMargin>1in</BottomMargin>
    <Style />
  </Page>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="genBOE">
      <DataSourceReference>genBOE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>b1fd3e5b-e3ee-43fc-9d6f-0a4bf6da0983</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>genBOE</DataSourceName>
        <CommandText>SELECT
(A.VS - B2.LS) LookAtMeIfIAmNotZero,
U.DisplayName AS DisplayName,
U.EmailAddress,
W.WorkspaceName,
B.BOEID,
S.BOEState AS [BOE State],
TE.TaskTitle,
A.VS AS LaborTypeValueSpread, A.BoeTaskElementID AS LaborTypeBOOETaskELementID,
B2.LS AS LaborSpreadValue, -- B.BoeTaskElementID AS LaborTypeBOOETaskELementID,




C.CLINNumber,
WBS.DisplayedWBSNumber,
WBS.WBSTitle,

TE.UpdateDT AS 'Date The Task Element was last updated',
B.UpdateDT AS 'Date the BOE Was Last Updated',
BH.UpdateDT AS 'BOE State History Date',
S3.BOEState AS CurrentState,
S2.BOEState AS UpdatedState

FROM dbo.Workspace W
	INNER JOIN dbo.BOE B ON B.WorkspaceID = W.WorkspaceID
	INNER JOIN dbo.BOEStateHistory BH ON B.BOEID = BH.BOEID
	INNER JOIN dbo.BOEStateLU S2 ON BH.UpdatedBOEStateID = S2.BOEStateID
	INNER JOIN dbo.BOEStateLU S3 ON BH.CurrentBOEStateID = S3.BOEStateID
	INNER JOIN dbo.BOEStateLU S ON B.BOEStateID = S.BOEStateID
	
	INNER JOIN dbo.BOEUserRole BUR ON B.BOEID = BUR.BOEID
	INNER JOIN dbo.ETIuser U ON BUR.ETIUserID = U.ETIUserID
	INNER JOIN dbo.RoleLU R ON BUR.RoleID = R.RoleID AND R.RoleName = 'Author'
	
	
	INNER JOIN dbo.BOETaskElement TE ON B.BOEID = TE.BOEID
	INNER JOIN
(
SELECT SUM (ValueSpread) AS VS, BOETaskElementID 
FROM BOELaborType
GROUP BY BOETaskElementID
) --= 18941
A ON TE.BOETaskElementID = A.BOETaskElementID
INNER JOIN
(
SELECT SUM(LS.LaborSpreadValue) AS LS, TE.BOETaskElementID  
FROM BOELaborSpread LS
INNER JOIN BOELaborType LT ON LS.BOELaborTypeID = LT.BOELaborTypeID
INNER JOIN BOETaskElement TE ON LT.BOETaskElementID = TE.BOETaskElementID
--WHERE TE.BOETaskElementID = 18941
GROUP BY TE.BOETaskElementID
) B2 ON A.BOETaskElementID = B2.BOETaskElementID
--WHERE B2.BOETaskElementID=18941



LEFT OUTER JOIN dbo.WBS_CLIN_BOE_XREF XB ON B.BOEID = XB.BOEID
LEFT OUTER JOIN dbo.CLIN C ON XB.CLINID = C.CLINID
LEFT OUTER JOIN dbo.WorkBreakdownStructure WBS ON XB.WBSID = WBS.WBSID




WHERE 

(A.VS - B2.LS) &lt;&gt; 0 AND
(
TE.UpdateDT BETWEEN DATEADD(MM, -1, GETDATE()) AND GETDATE() OR
B.UpdateDT  BETWEEN DATEADD(MM, -1, GETDATE()) AND GETDATE() OR
BH.UpdateDT  BETWEEN DATEADD(MM, -1, GETDATE()) AND GETDATE() 
)

ORDER BY 
(A.VS - B2.LS) DESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="LookAtMeIfIAmNotZero">
          <DataField>LookAtMeIfIAmNotZero</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="DisplayName">
          <DataField>DisplayName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="EmailAddress">
          <DataField>EmailAddress</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WorkspaceName">
          <DataField>WorkspaceName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BOEID">
          <DataField>BOEID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="BOE_State">
          <DataField>BOE State</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TaskTitle">
          <DataField>TaskTitle</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LaborTypeValueSpread">
          <DataField>LaborTypeValueSpread</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="LaborTypeBOOETaskELementID">
          <DataField>LaborTypeBOOETaskELementID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="LaborSpreadValue">
          <DataField>LaborSpreadValue</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CLINNumber">
          <DataField>CLINNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DisplayedWBSNumber">
          <DataField>DisplayedWBSNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WBSTitle">
          <DataField>WBSTitle</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Date_The_Task_Element_was_last_updated">
          <DataField>Date The Task Element was last updated</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Date_the_BOE_Was_Last_Updated">
          <DataField>Date the BOE Was Last Updated</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="BOE_State_History_Date">
          <DataField>BOE State History Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="CurrentState">
          <DataField>CurrentState</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="UpdatedState">
          <DataField>UpdatedState</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
