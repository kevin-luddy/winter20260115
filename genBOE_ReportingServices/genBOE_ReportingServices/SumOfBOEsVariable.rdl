          <DataField>TaskTitle</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MOQHoursEquation">
          <DataField>MOQHoursEquation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BOETaskElementUpdateDate">
          <DataField>BOETaskElementUpdateDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>genBOE</DataSourceName>
        <CommandText>/*
Sum of BOEs - The use of BOEs in Summary are defined in the following tables:

dbo.OrdinaryVariable 
to get the BOE Task Elements which determines it use for Ordinary Variables

For Workspace Variables:
dbo.WorkspaceVariable 
dbo.BOETaskElementWorkspaceVariableXREF	

*/
SELECT * FROM 
(
SELECT DISTINCT 
W.WorkspaceName
,SH.CreateDate AS [Workspace Creation Date]
,COST.DisplayName AS [Cost Volume Lead/Pricer]
,WS.WorkspaceState --4.	Workspace Status
,W.WorkspaceShortName--5.	Workspace Short Name/URL
,B.BOEID--6.	BOE ID
,T.BOETaskElementID--7.	Task ID
,BUR.DisplayName AS [BOE Author]
,BS.BOEState AS [BOE Status]
,WBS.DisplayedWBSNumber--8.	WBS #
,WBS.WBSTitle--9.	WBS Title
,C.DisplayedCLINNumber--10.	CLIN #
,C.CLINTitle--11.	CLIN Title
,T.TaskTitle--12.	Task Title
,T.MOQHoursEquation--13.	MOQ Equation
,T.UpdateDT AS BOETaskElementUpdateDate


FROM dbo.Workspace W
INNER JOIN dbo.WorkspaceStateLU WS ON W.WorkspaceStateID = WS.WorkspaceStateID
INNER JOIN 
	(
	SELECT MIN(UpdateDT) AS CreateDate, WorkspaceID
	FROM dbo.WorkspaceStateHistory
	WHERE CurrentWorkspaceStateID = 0 AND UpdatedWorkspaceStateID = 1
	GROUP BY WorkspaceID, UpdateDT
	) SH ON W.WorkspaceID = SH.WorkspaceID
		
INNER JOIN ETIuser COST ON W.CostVolumeLeadPricerUserID = COST.ETIUserID		
INNER JOIN dbo.BOE B ON W.WorkspaceID = B.WorkspaceID
INNER JOIN 
	(
		SELECT DISTINCT BUR.BOEID, BUR.RoleID, U.DisplayName
		FROM dbo.BOEUserRole BUR
			INNER JOIN dbo.ETIuser U ON BUR.ETIUserID = U.ETIUserID
		WHERE RoleID = 1 /*Author*/
	) BUR ON B.BOEID = BUR.BOEID 
INNER JOIN dbo.BOETaskElement T ON B.BOEID = T.BOEID
INNER JOIN dbo.BOEStateLU BS ON B.BOEStateID = BS.BOEStateID
INNER JOIN dbo.OrdinaryVariable OV ON T.BOETaskElementID = OV.BOETaskElementID
LEFT OUTER JOIN dbo.WBS_CLIN_BOE_XREF X ON B.BOEID = X.BOEID
LEFT OUTER JOIN dbo.CLIN C ON X.CLINID = C.CLINID
LEFT OUTER JOIN dbo.WorkBreakdownStructure WBS ON X.WBSID = WBS.WBSID
WHERE 
OV.OrdinaryVariableID IS NOT NULL AND
OV.ValueTypeID = 2 /*Sum of BOEs*/
--ORDER BY T.BOETaskElementID
UNION
SELECT DISTINCT 
W.WorkspaceName
,SH.CreateDate AS [Workspace Creation Date]
,COST.DisplayName AS [Cost Volume Lead/Pricer]
,WS.WorkspaceState --4.	Workspace Status
,W.WorkspaceShortName--5.	Workspace Short Name/URL
,B.BOEID--6.	BOE ID
,T.BOETaskElementID--7.	Task ID
,BUR.DisplayName AS [BOE Author]
,BS.BOEState AS [BOE Status]
,WBS.DisplayedWBSNumber--8.	WBS #
,WBS.WBSTitle--9.	WBS Title
,C.DisplayedCLINNumber--10.	CLIN #
,C.CLINTitle--11.	CLIN Title
,T.TaskTitle--12.	Task Title
,T.MOQHoursEquation--13.	MOQ Equation
,T.UpdateDT AS BOETaskElementUpdateDate
FROM dbo.Workspace W
INNER JOIN dbo.WorkspaceStateLU WS ON W.WorkspaceStateID = WS.WorkspaceStateID
INNER JOIN 
	(
	SELECT MIN(UpdateDT) AS CreateDate, WorkspaceID
	FROM dbo.WorkspaceStateHistory
	WHERE CurrentWorkspaceStateID = 0 AND UpdatedWorkspaceStateID = 1
	GROUP BY WorkspaceID, UpdateDT
	) SH ON W.WorkspaceID = SH.WorkspaceID
		
INNER JOIN ETIuser COST ON W.CostVolumeLeadPricerUserID = COST.ETIUserID		
INNER JOIN dbo.BOE B ON W.WorkspaceID = B.WorkspaceID
INNER JOIN 
	(
		SELECT DISTINCT BUR.BOEID, BUR.RoleID, U.DisplayName
		FROM dbo.BOEUserRole BUR
			INNER JOIN dbo.ETIuser U ON BUR.ETIUserID = U.ETIUserID
		WHERE RoleID = 1 /*Author*/
	) BUR ON B.BOEID = BUR.BOEID 
INNER JOIN dbo.BOETaskElement T ON B.BOEID = T.BOEID
INNER JOIN dbo.BOEStateLU BS ON B.BOEStateID = BS.BOEStateID
INNER JOIN dbo.BOETaskElementWorkspaceVariableXREF X2 ON T.BOETaskElementID = X2.BOETaskElementID
INNER JOIN dbo.WorkspaceVariable WV ON WV.WorkspaceVariableID = X2.WorkspaceVariableID		 
LEFT OUTER JOIN dbo.WBS_CLIN_BOE_XREF X ON B.BOEID = X.BOEID
LEFT OUTER JOIN dbo.CLIN C ON X.CLINID = C.CLINID
LEFT OUTER JOIN dbo.WorkBreakdownStructure WBS ON X.WBSID = WBS.WBSID
--ORDER BY BOETaskElementID
WHERE 
WV.WorkspaceVariableID IS NOT NULL AND
WV.ValueTypeID = 2 /*Sum of BOEs*/
) A ORDER BY WorkspaceName --WorkspaceNameBOETaskElementID--WorkspaceName</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
