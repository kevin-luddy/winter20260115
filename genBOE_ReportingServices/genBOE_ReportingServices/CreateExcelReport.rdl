<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition">
  <DataSources>
    <DataSource Name="SourceDatabase">
      <DataSourceReference>SourceDatabase</DataSourceReference>
      <rd:DataSourceID>53ab6849-30b3-46fe-b245-3ba3449b41e7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Iteration">
      <Fields>
        <Field Name="Iteration">
          <DataField>Iteration</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>SourceDatabase</DataSourceName>
        <CommandText>SELECT DISTINCT [Iteration] FROM [CANUSO].[dbo].[CurrentInformation]
ORDER BY ITERATION</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
    <DataSet Name="AreaPath">
      <Fields>
        <Field Name="AreaPath">
          <DataField>AreaPath</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>SourceDatabase</DataSourceName>
        <CommandText>SELECT DISTINCT [AreaPath] FROM [CANUSO].[dbo].[CurrentInformation]
ORDER BY AreaPath</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
    <DataSet Name="RunReport">
      <Fields>
        <Field Name="IterationEndDate">
          <DataField>IterationEndDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Iteration">
          <DataField>Iteration</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AreaPath">
          <DataField>AreaPath</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>SourceDatabase</DataSourceName>
        <CommandText>IF EXISTS  (SELECT * FROM dbo.ExcelReport WHERE AreaPath = @AreaPath AND Processed = 0)
BEGIN
	/*
	A current report exist 
	Delete the old report before creating a new onw
	*/
	UPDATE  dbo.ExcelReport SET Processed = 1 WHERE AreaPath = @AreaPath
END

	
/* Now Add the new Report*/
IF NOT EXISTS (SELECT * FROM dbo.ExcelReport
				WHERE IterationEndDate = @IterationEndDate AND
				Iteration = @Iteration AND
				AreaPath = @AreaPath AND
				Processed = 0
				)
BEGIN
	INSERT INTO dbo.ExcelReport (IterationEndDate, Iteration, AreaPath)
	VALUES ( @IterationEndDate, @Iteration, @AreaPath)
END



SELECT [IterationEndDate]
      ,[Iteration]
      ,[AreaPath]

  FROM [CANUSO].[dbo].[ExcelReport]
WHERE [Processed] = 0</CommandText>
        <QueryParameters>
          <QueryParameter Name="@IterationEndDate">
            <Value>=Parameters!IterationEndDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Iteration">
            <Value>=Parameters!Iteration.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@AreaPath">
            <Value>=Parameters!AreaPath.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
