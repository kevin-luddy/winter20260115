          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Target_Workspace_Name">
          <DataField>Target Workspace Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Target_Workspace_Short_Name">
          <DataField>Target Workspace Short Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
