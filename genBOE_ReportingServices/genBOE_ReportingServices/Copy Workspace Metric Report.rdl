      <DataSourceReference>genBOE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>5c3f3588-cd3f-46fd-943d-0bb53b87503d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>genBOE</DataSourceName>
        <CommandText>SELECT     WC.CreateDate AS [Workspace Copy Creation Date], 

WC.SourceWorkspaceID AS [Source Workspace ID],
S.WorkspaceName AS [Source Workspace Name], 
S.WorkspaceShortName AS [Source Workspace Short Name], 
S.WorkspaceDescription AS [Source Workspace Description], 
S.TrackingNumber AS [Source Workspace Tracking Number], 
S.RFPNumber  AS [Source Workspace RFP Number],
S.ProposalType AS [Source Workspace Proposal Type],
 S.ProductLineName AS [Source Workspace Product Line Name],
 S.ProductLineLongName AS [Source Workspace Product Line Long Name],
  S.LineOfBusinessName AS [Source Workspace Line Of Business Name],
                      
S.LineOfBusinessLongName AS [Source Workspace Line Of Business Long Name], 
S.NumOfBOEs  AS [Source Workspace Number of BOEs],

WC.TargetWorkspaceID AS [Target Workspace ID],
T.WorkspaceName AS [Target Workspace Name], 
T.WorkspaceShortName AS [Target Workspace Short Name], 
T.WorkspaceDescription AS [Target Workspace Description], 
T.TrackingNumber AS [Target Workspace Tracking Number], 
T.RFPNumber  AS [Target Workspace RFP Number],
T.ProposalType AS [Target Workspace Proposal Type],
 T.ProductLineName AS [Target Workspace Product Line Name],
 T.ProductLineLongName AS [Target Workspace Product Line Long Name],
  T.LineOfBusinessName AS [Target Workspace Line Of Business Name],
                      
T.LineOfBusinessLongName AS [Target Workspace Line Of Business Long Name], 
T.NumOfBOEs  AS [Target Workspace Number of BOEs]


FROM         WorkspaceCopyMetric AS WC 
LEFT OUTER JOIN
                      WorkspaceCopySource AS S ON WC.SourceWorkspaceID = S.WorkspaceID  AND WC.CreateDate = S.CreateDate
LEFT OUTER JOIN
                      WorkspaceCopyTarget AS T ON WC.TargetWorkspaceID = T.WorkspaceID  AND WC.CreateDate = T.CreateDate</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Workspace_Copy_Creation_Date">
          <DataField>Workspace Copy Creation Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Source_Workspace_ID">
          <DataField>Source Workspace ID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Source_Workspace_Name">
          <DataField>Source Workspace Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Source_Workspace_Short_Name">
