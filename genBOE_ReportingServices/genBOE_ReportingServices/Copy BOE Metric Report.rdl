  </Body>
  <Width>19.54167in</Width>
  <Page>
    <LeftMargin>1in</LeftMargin>
    <RightMargin>1in</RightMargin>
    <TopMargin>1in</TopMargin>
    <BottomMargin>1in</BottomMargin>
    <Style />
  </Page>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="genBOE">
      <DataSourceReference>genBOE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>99209cdf-9fac-4455-95f1-7d4fc46f43c7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>genBOE</DataSourceName>
        <CommandText>SELECT     BM.CreateDate AS [BOE Copy Creation Date], BM.SourceBOEID AS [Source BOEID], S.BOETitle AS [Source BOE Title], 
                      S.WorkspaceName AS [Source Workspace Name], S.WorkspaceShortName AS [Source Workspace Short Name], BM.TargetBOEID AS [Target BOEID], 
                      T.BOETitle AS [Target BOE Title], T.WorkspaceName AS [Target Workspace Name], T.WorkspaceShortName AS [Target Workspace Short Name]
FROM         BOECopyMetric AS BM INNER JOIN
                      BOECopySource AS S ON BM.SourceBOEID = S.BOEID AND BM.CreateDate = S.CreateDate INNER JOIN
                      BOECopyTarget AS T ON BM.TargetBOEID = T.BOEID AND BM.CreateDate = T.CreateDate</CommandText>
      </Query>
      <Fields>
        <Field Name="BOE_Copy_Creation_Date">
          <DataField>BOE Copy Creation Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Source_BOEID">
          <DataField>Source BOEID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Source_BOE_Title">
          <DataField>Source BOE Title</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Source_Workspace_Name">
          <DataField>Source Workspace Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Target_BOE_Title">
          <DataField>Target BOE Title</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Source_Workspace_Short_Name">
          <DataField>Source Workspace Short Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Target_BOEID">
          <DataField>Target BOEID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Target_Workspace_Name">
          <DataField>Target Workspace Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Target_Workspace_Short_Name">
          <DataField>Target Workspace Short Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="GrandTotalCount">
      <Query>
        <DataSourceName>genBOE</DataSourceName>
        <CommandText>SELECT     COUNT(*) AS [Number of BOEs Copied]
FROM        [dbo].[BOECopyMetric]</CommandText>
      </Query>
      <Fields>
        <Field Name="Number_of_BOEs_Copied">
          <DataField>Number of BOEs Copied</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
