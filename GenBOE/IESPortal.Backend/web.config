<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- To customize the asp.net core module uncomment and edit the following section. 
  For more info see https://go.microsoft.com/fwlink/?linkid=838655 -->
	<system.web>
		<authentication mode="Windows" />
		<authorization>
			<allow roles="__allowedRoles__" />
			<deny users="*" />
		</authorization>
	</system.web>
	<system.webServer>
		<handlers>
			<remove name="aspNetCore"/>
			<add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified"/>
		</handlers>
		<aspNetCore processPath="dotnet" arguments=".\IESPortal.Backend.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
			<environmentVariables>
				<environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />
				<!--<environmentVariable name="EPP_ENVIRONMENT" value="Local" />
					<environmentVariable name="APPLICATION_VERSION" value="Local - WIP" />
					<environmentVariable name="ASPNETCORE_HTTPS_PORT" value="44386" />-->
				</environmentVariables>
		</aspNetCore>
	</system.webServer>

</configuration>