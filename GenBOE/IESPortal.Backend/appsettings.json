                "Microsoft.AspNetCore": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System": "Warning"
            }
        }
    },
    "AllowedOrigins": "https://*.lmco.com",
    "AllowedHosts": "*",
    "IESUrl": "_IESUrl_",
    "BOEUrl": "_BOEUrl_",
    "PTMUrl": "_PTMUrl_",
    "RDMUrl": "_RDMUrl_",
    "RDSBUrl": "_RDSBUrl_",
    "PPUrl": "_PPUrl_",
    "RPMUrl": "_RPMUrl_",
    "ACVUrl": "_ACVUrl_",
    "NLFUrl": "_NLFUrl_",
    "EEPPUrl": "_EEPPUrl_",
    "AdminUrl": "_AdminUrl_",
    "IESPortalAdminGroups": "_IES_PORTAS_ADMIN_GROUPS_",
    "Federation": {
        "ClientId": "eo-ssc-ies",
        "ValidAudiences": "eo-ssc-ies,eo-ssc-acv,eo-ssc-nlf",
