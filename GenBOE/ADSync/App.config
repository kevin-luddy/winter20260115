<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="loggingConfiguration" type="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.LoggingSettings, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" requirePermission="true" />
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    <section name="systemConfiguration" type="IES.Common.SystemConfigurationSection, IES.Common, Version=1.0.0.0" />
    <sectionGroup name="elmah">
      <section name="security" requirePermission="false" type="Elmah.SecuritySectionHandler, Elmah" />
      <section name="errorLog" requirePermission="false" type="Elmah.ErrorLogSectionHandler, Elmah" />
      <section name="errorMail" requirePermission="false" type="Elmah.ErrorMailSectionHandler, Elmah" />
      <section name="errorFilter" requirePermission="false" type="Elmah.ErrorFilterSectionHandler, Elmah" />
    </sectionGroup>
  <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 --></configSections>
  <startup> 
      <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.2" />
  </startup>
  <connectionStrings>
    <add name="genTracEntities" connectionString="metadata=res://*/PTMEntityModel.csdl|res://*/PTMEntityModel.ssdl|res://*/PTMEntityModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;__genTracEntities__integrated security=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
    <add name="GenBoeEntities" connectionString="metadata=res://*/BOEEntityModel.csdl|res://*/BOEEntityModel.ssdl|res://*/BOEEntityModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;__GenBoeEntities__integrated security=True;multipleactiveresultsets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />

    <!-- FOR A LOCAL RUN, we need these
        <add name="genTracEntities" connectionString="metadata=res://*/PTMEntityModel.csdl|res://*/PTMEntityModel.ssdl|res://*/PTMEntityModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=Cudan\SSAPPVFDEV;initial catalog=genTRAC;integrated security=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
        <add name="GenBoeEntities" connectionString="metadata=res://*/BOEEntityModel.csdl|res://*/BOEEntityModel.ssdl|res://*/BOEEntityModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=Cudan\SSAPPVFDEV;Initial Catalog=GenBOEMst;integrated security=True;multipleactiveresultsets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
    -->  
  </connectionStrings>
  <appSettings>
    <!-- General Settings -->
    <add key="ActiveDirectoryPath" value="GC://us.lmco.com" />
    <add key="LMIProxy" value="http://proxy-zsgov.external.lmco.com" />
    <add key="NoADSyncAccounts" value="idedynatrace"/>
    <add key="CompanyConfiguration" value="__CompanyConfiguration__" />
    <add key="PtmAuthGroups" value="__PtmAuthGroups__" />

    <!-- Dev level settings -->
    <add key="APPLICATION_VERSION" value="__APPLICATION_VERSION__" />
    <add key="TransactionTimeout" value="360" />
    <add key="LogType" value="__LogType__" />
    <add key="DisableAllEmails" value="__DisableAllEmails__" />
    <add key="EmailsToCurrentlyLoggedInUser" value="__EmailsToCurrentlyLoggedInUser__" />
    <add key="MaxDegreeOfParallelism" value="__MaxDegreeOfParallelism__" />
    <add key="MaxDbQueries" value="__MaxDbQueries__" />

    <!-- FOR A LOCAL RUN, we need these
        <add key="CompanyConfiguration" value="RMS" />
        <add key="LogType" value="INFO" />
        <add key="DisableAllEmails" value="True" />
        <add key="EmailsToCurrentlyLoggedInUser" value="True" />
        <add key="MaxDegreeOfParallelism" value="3" />
        <add key="MaxDbQueries" value="25" />
        <add key="PtmAuthGroups" value="us\EBS.EstimationInitiative.DevTeam,us\EBS.EstimationInitiative.ApprovedDevAndTestUsers,us\EBS.IES.CoverSheetApprovers,us\EBS.IES.LOBManagers,us\EBS.IES.LeadEst.PricingVer.IndependentRev.Roles,us\EBS.IES.PTM.Viewers" />
    -->  
  </appSettings>
  <elmah>
    <security allowRemoteAccess="1" />
    <errorLog type="Elmah.SqlErrorLog, Elmah" connectionString="__GenBoeEntities__integrated security=True;multipleactiveresultsets=True;" applicationName="__ElmahAppName__" />
    <!-- FOR A LOCAL RUN, we need these
      <errorLog type="Elmah.SqlErrorLog, Elmah" connectionString="data source=Cudan\SSAPPVFDEV;Initial Catalog=GenBOEMst;integrated security=True;multipleactiveresultsets=True;" applicationName="GenBOERMS" />
    -->
  </elmah>
  <system.web>
    <authorization>
      <allow roles="__GroupsUsedForPerfImprovement__"/>
      <!-- FOR A LOCAL RUN, we need this 
          <allow roles="us\EBS.EstimationInitiative.DevTeam"/> 
      -->
      <deny users="*" />
    </authorization>
  </system.web>
  <loggingConfiguration name="" tracingEnabled="true" defaultCategory="Performance">
    <listeners>
      <add name="Rolling Flat File Performance Listener" type="Microsoft.Practices.EnterpriseLibrary.Logging.TraceListeners.RollingFlatFileTraceListener, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" listenerDataType="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.RollingFlatFileTraceListenerData, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" fileName="__PerfLogLocation__" footer="" formatter="Performance Formatter" header="" rollFileExistsBehavior="Increment" rollSizeKB="20000" filter="Information" maxArchivedFiles="20" />
    </listeners>
    <formatters>
      <add type="Microsoft.Practices.EnterpriseLibrary.Logging.Formatters.TextFormatter, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" template="{timestamp(local)},{message}" name="Performance Formatter" />
    </formatters>
    <categorySources>
      <add switchValue="All" name="Performance">
        <listeners>
          <add name="Rolling Flat File Performance Listener" />
        </listeners>
      </add>
    </categorySources>
    <specialSources>
      <allEvents switchValue="All" name="All Events" />
      <notProcessed switchValue="All" name="Unprocessed Category" />
      <errors switchValue="Off" name="Logging Errors &amp; Warnings" />
    </specialSources>
  </loggingConfiguration>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Xml" publicKeyToken="b77a5c561934e089" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0" />
