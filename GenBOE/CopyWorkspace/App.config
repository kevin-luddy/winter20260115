	<add key="HelpdeskEmailAddress" value="generation-support.fc-isgs@lmco.com" />
    <add key="LMIProxy" value="http://proxy-zsgov.external.lmco.com" />
    
    <!-- SSC Settings -->
    <add key="ShowEquivalentPersonsOption" value="false" />
    <add key="IsBOEFormVisible" value="true" />
    <add key="IsPortionMarkingEnabled" value="false" />
    <add key="IESHomeUrl" value="http://dev-ies.ssc.lmco.com/Home/" />
    <add key="IsPTMIntegrated" value="true" />
    <!-- Hours offset to convert from the DB's timezone to EST - Database currently in CO using MST, 2 hours behind EST -->
    <add key="DatabaseESTOffset" value="2" />

    <!-- Piwik Settings -->
    <add key="DisablePiwik" value="true" />
    <add key="PiwikURL" value="https://techopstoolbox.global.lmco.com/piwik/" />
