    <!-- Project Map Settings (RMS only)-->
    <add key="IsProjectMapEnabled" value="true" />
    <add key="ReportServerLocation" value="https://sscreports-dev.ssc.lmco.com/ReportServer_SSRS30D?" />
    <add key="ReportServerFolderName" value="generation/genBOEMST/RMS" />
    <add key="MaximumRowsInProjectMap" value="15000" />
    <add key="ProjectMapPageSize" value="50" />

    <!-- Dev level settings -->
    <add key="APPLICATION_VERSION" value="WIP - Local" />
    <add key="LogType" value="INFO" />
    <add key="SearchResultsThreshold" value="100" />
    <add key="DisableAllEmails" value="False" />
    <add key="EmailsToCurrentlyLoggedInUser" value="True" />
    <add key="TransactionTimeout" value="360" />
    <add key="CopyWorkspaceTransactionTimeout" value="600" />
    <add key="MIECostUpdateActivationDate" value="10/15/2012" />
    <add key="MIECostUpdateTripDate" value="11/01/2012" />
    <add key="ExportLoggingEnableInternalMV" value="false" />
    <add key="ExportLoggingEnableInternalExport" value="false" />
    <add key="ShowUserName" value="true" />
    <add key="MaxDegreeOfParallelism" value="3" />
    <add key="MaxDbQueries" value="25" />
    <add key="IsIdentitySwappingAllowed" value="true" />
    <add key="ADGroupsAllowedToSwapIdentity" value="US\EBS.EstimationInitiative.DevTeam,US\EBS.EstimationInitiative.ApprovedDevAndTestUsers" />
    <add key="ShowCompanyConfiguration" value="true" />
  </appSettings>

  <elmah>
    <security allowRemoteAccess="1" />
    <errorLog type="Elmah.SqlErrorLog, Elmah" connectionString="data source=Cudan\SSAPPVFDEV;Initial Catalog=GenBOESpace;integrated security=True;multipleactiveresultsets=True;" applicationName="GenBOESpace" />
  </elmah>

  <!-- The settings below are system settings, and as such should not be modified as a part of the deployment process -->
  <loggingConfiguration name="" tracingEnabled="true" defaultCategory="Performance">
    <listeners>
      <add name="Rolling Flat File Performance Listener" type="Microsoft.Practices.EnterpriseLibrary.Logging.TraceListeners.RollingFlatFileTraceListener, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" listenerDataType="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.RollingFlatFileTraceListenerData, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" fileName="logs/generation.performance.csv" footer="" formatter="Performance Formatter" header="" rollFileExistsBehavior="Increment" rollSizeKB="20000" filter="Information" maxArchivedFiles="20" />
    </listeners>
    <formatters>
      <add type="Microsoft.Practices.EnterpriseLibrary.Logging.Formatters.TextFormatter, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" template="{timestamp(local)},{message}" name="Performance Formatter" />
    </formatters>
    <categorySources>
      <add switchValue="All" name="Performance">
        <listeners>
          <add name="Rolling Flat File Performance Listener" />
        </listeners>
      </add>
    </categorySources>
    <specialSources>
      <allEvents switchValue="All" name="All Events" />
      <notProcessed switchValue="All" name="Unprocessed Category" />
      <errors switchValue="Off" name="Logging Errors &amp; Warnings" />
    </specialSources>
  </loggingConfiguration>
