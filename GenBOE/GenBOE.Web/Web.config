<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="loggingConfiguration" type="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.LoggingSettings, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" requirePermission="true" />
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    <section name="systemConfiguration" type="IES.Common.SystemConfigurationSection, IES.Common, Version=1.0.0.0" />
    <sectionGroup name="elmah">
      <section name="security" requirePermission="false" type="Elmah.SecuritySectionHandler, Elmah" />
      <section name="errorLog" requirePermission="false" type="Elmah.ErrorLogSectionHandler, Elmah" />
      <section name="errorMail" requirePermission="false" type="Elmah.ErrorMailSectionHandler, Elmah" />
      <section name="errorFilter" requirePermission="false" type="Elmah.ErrorFilterSectionHandler, Elmah" />
    </sectionGroup>
    <section name="glimpse" type="Glimpse.Core.Configuration.Section, Glimpse.Core" />
  </configSections>
  <connectionStrings>
    <add name="genTracEntities" connectionString="metadata=res://*/PTMEntityModel.csdl|res://*/PTMEntityModel.ssdl|res://*/PTMEntityModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=IDESQL35D\SSAPPVFDEV;initial catalog=genTRAC;integrated security=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
    <add name="GenBoeEntities" connectionString="metadata=res://*/BOEEntityModel.csdl|res://*/BOEEntityModel.ssdl|res://*/BOEEntityModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=IDESQL35D\SSAPPVFDEV;Initial Catalog=GenBOESpace;integrated security=True;multipleactiveresultsets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
    <add name="BI_Datamart_PMMEntities" connectionString="metadata=res://*/MSTMetricsModel.csdl|res://*/MSTMetricsModel.ssdl|res://*/MSTMetricsModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=MstwDmsbisql\MSBI;initial catalog=BI_Datamart_PMM;integrated security=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
  </connectionStrings>
  <appSettings>
    <!-- General Settings -->
    <add key="EmailServer" value="smtp-lmiden.ems.lmco.com" />
    <add key="ActiveDirectoryPath" value="GC://us.lmco.com" />
    <add key="ServerURL" value="http://dev-genboe.ssc.lmco.com" />
    <add key="ProdUrlBoe" value="boe.ssc.lmco.com" />
    <add key="DomesticUsersGroup" value="US\lmco.all.emp" />
    <add key="SubsTreatedAsLmEmployees" value="acct04\ipe.genBOE.spacesystems.subcontractor.admins"/>
    <add key="CompanyConfiguration" value="SpaceSystems" />
    <add key="HelpdeskEmailAddress" value="generation-support.fc-isgs@lmco.com" />
    <add key="LMIProxy" value="http://proxy-lmi.global.lmco.com" />
    <add key="ShutOffExternalLinksForClassifiedInstall" value="false" />
    <add key="UsersAllowedProPricerAccess" value="US\EBS.EstimationInitiative.DevTeam,US\EBS.EstimationInitiative.ApprovedDevAndTestUsers" />
    <add key="EnableSendToProPricerDirectly" value="true"/>
    <add key="ProPricerApiUrl" value="http://dev-propricerapirms.us.lmco.com/api/"/>
    <add key="UnclassifiedBannerText" value="Unclassified Environment" />
    <add key="OverrideSubNonUs" value="false" />
    
    <!-- SSC Settings -->
    <add key="ShowEquivalentPersonsOption" value="false" />
    <add key="IsBOEFormVisible" value="true" />
    <add key="IsPortionMarkingEnabled" value="false" />
    <add key="IESHomeUrl" value="http://dev-ies.ssc.lmco.com/Home/" />
    <add key="IsPTMIntegrated" value="true" />
    <!-- Hours offset to convert from the DB's timezone to EST - Database currently in CO using MST, 2 hours behind EST -->
    <add key="DatabaseESTOffset" value="2" />
    <add key="CanCreateWorkspaceWithoutPtmTrackingNumber" value=""/>

    <!-- Piwik Settings -->
    <add key="DisablePiwik" value="true" />
    <add key="PiwikURL" value="https://techopstoolbox.global.lmco.com/piwik/" />
    <add key="PiwikId" value="0" />

    <!-- MST Measure / Metrics (RMS main version only) -->
    <add key="MstMetricsUrl" value="http://msbidev.us.lmco.com/sites/PMM/default.aspx" />
    <add key="MSTSearchCriteriaHelp" value="http://msbiprod.us.lmco.com/sites/PMM/HelpInputs/Input-genBoeSearchHistoricalMeasures.pptx" />
    <add key="MSTSearchResultsHelpLink" value="http://msbiprod.us.lmco.com/sites/PMM/HelpInputs/Input-genBoeSearchResults.pptx" />
    <add key="MSTSearchResultsDetailHelpLink" value="http://msbiprod.us.lmco.com/sites/PMM/HelpInputs/Input-genBoeSearchResultsDetail.pptx" />

    <!-- Project Map Settings (RMS only)-->
    <add key="IsProjectMapEnabled" value="true" />
    <add key="ReportServerLocation" value="https://sscreports-dev.ssc.lmco.com/ReportServer_SSRS30D?" />
    <add key="ReportServerFolderName" value="generation/genBOEMST/RMS" />
    <add key="MaximumRowsInProjectMap" value="15000" />
    <add key="ProjectMapPageSize" value="50" />

    <!-- Dev level settings -->
    <add key="APPLICATION_VERSION" value="2020.3" />
    <add key="LogType" value="INFO" />
    <add key="SearchResultsThreshold" value="100" />
    <add key="DisableAllEmails" value="False" />
    <add key="EmailsToCurrentlyLoggedInUser" value="True" />
    <add key="TransactionTimeout" value="360" />
    <add key="CopyWorkspaceTransactionTimeout" value="600" />
    <add key="MIECostUpdateActivationDate" value="10/15/2012" />
    <add key="MoqTemplateStartDate" value="10/16/2020" />
    <add key="MIECostUpdateTripDate" value="11/01/2012" />
    <add key="ExportLoggingEnableInternalMV" value="false" />
    <add key="ExportLoggingEnableInternalExport" value="false" />
    <add key="ShowUserName" value="true" />
    <add key="MaxDegreeOfParallelism" value="3" />
    <add key="MaxDbQueries" value="25" />
    <add key="IsIdentitySwappingAllowed" value="true" />
    <add key="ADGroupsAllowedToSwapIdentity" value="US\EBS.EstimationInitiative.DevTeam,US\EBS.EstimationInitiative.ApprovedDevAndTestUsers" />
    <add key="ShowCompanyConfiguration" value="true" />
  </appSettings>

  <system.web>
    <authorization>
      <allow roles="us\EBS.EstimationInitiative.DevTeam,us\EBS.EstimationInitiative.ApprovedDevAndTestUsers,acct04\ipe.genBOE.approvedsubcontractors,us\EBS.EstimationInitiative.AacctDevTeam,us\ectl0401,us\ectl0222" />
      <deny users="*" />
    </authorization>
    <httpCookies httpOnlyCookies="true" requireSSL="false" />
    <compilation debug="true" targetFramework="4.6.2">
      <assemblies>
        <add assembly="System.Web.Abstractions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Helpers, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Routing, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Mvc, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.WebPages, Version=2.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
      </assemblies>
    </compilation>
    <authentication mode="Windows" />
    <pages controlRenderingCompatibilityVersion="4.0">
      <namespaces>
        <add namespace="System.Web.Configuration" />
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
      </namespaces>
    </pages>
    <httpHandlers>
      <add verb="POST,GET,HEAD" path="elmah.axd" type="Elmah.ErrorLogPageFactory, Elmah" />
      <add path="glimpse.axd" verb="GET" type="Glimpse.AspNet.HttpHandler, Glimpse.AspNet" />
    </httpHandlers>
    <!-- Glimpse: This can be commented in to add additional data to the Trace tab when using WebForms
        <trace writeToDiagnosticsTrace="true" enabled="true" pageOutput="false"/> -->
    <httpModules>
      <add name="ErrorLog" type="Elmah.ErrorLogModule, Elmah" />
      <add name="Glimpse" type="Glimpse.AspNet.HttpModule, Glimpse.AspNet" />
    </httpModules>
    <customErrors mode="RemoteOnly" defaultRedirect="Error">
      <error statusCode="404" redirect="Error" />
    </customErrors>
    <httpRuntime targetFramework="4.6.2" maxRequestLength="40960" />
  </system.web>
  <location path="elmah.axd">
    <system.web>
      <authorization>
        <allow roles="US\EBS.EstimationInitiative.DevTeam" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <elmah>
    <security allowRemoteAccess="1" />
    <errorLog type="Elmah.SqlErrorLog, Elmah" connectionString="data source=IDESQL35D\SSAPPVFDEV;Initial Catalog=GenBOESpace;integrated security=True;multipleactiveresultsets=True;" applicationName="GenBOESpace" />
  </elmah>

  <!-- The settings below are system settings, and as such should not be modified as a part of the deployment process -->
  <location path="glimpse.axd">
    <system.web>
      <authorization>
        <allow roles="US\EBS.EstimationInitiative.DevTeam" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <loggingConfiguration name="" tracingEnabled="true" defaultCategory="Performance">
    <listeners>
      <add name="Rolling Flat File Performance Listener" type="Microsoft.Practices.EnterpriseLibrary.Logging.TraceListeners.RollingFlatFileTraceListener, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" listenerDataType="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.RollingFlatFileTraceListenerData, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" fileName="logs/generation.performance.csv" footer="" formatter="Performance Formatter" header="" rollFileExistsBehavior="Increment" rollSizeKB="20000" filter="Information" maxArchivedFiles="20" />
    </listeners>
    <formatters>
      <add type="Microsoft.Practices.EnterpriseLibrary.Logging.Formatters.TextFormatter, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" template="{timestamp(local)},{message}" name="Performance Formatter" />
    </formatters>
    <categorySources>
      <add switchValue="All" name="Performance">
        <listeners>
          <add name="Rolling Flat File Performance Listener" />
        </listeners>
      </add>
    </categorySources>
    <specialSources>
      <allEvents switchValue="All" name="All Events" />
      <notProcessed switchValue="All" name="Unprocessed Category" />
      <errors switchValue="Off" name="Logging Errors &amp; Warnings" />
    </specialSources>
  </loggingConfiguration>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules>
      <add name="ErrorLog" type="Elmah.ErrorLogModule, Elmah" preCondition="managedHandler" />
      <add name="Glimpse" type="Glimpse.AspNet.HttpModule, Glimpse.AspNet" preCondition="integratedMode" />
    </modules>
    <handlers>
      <add name="Elmah" verb="POST,GET,HEAD" path="elmah.axd" type="Elmah.ErrorLogPageFactory, Elmah" preCondition="integratedMode" />
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
      <add name="Glimpse" path="glimpse.axd" verb="GET" type="Glimpse.AspNet.HttpHandler, Glimpse.AspNet" preCondition="integratedMode" />
    </handlers>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="41943040" />
        <hiddenSegments>
          <add segment="logs" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <staticContent>
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
    </staticContent>
    <rewrite>
      <rules>
        <rule name="Redirect to HTTPs" stopProcessing="true" enabled="false">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Xml" publicKeyToken="b77a5c561934e089" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0" />
