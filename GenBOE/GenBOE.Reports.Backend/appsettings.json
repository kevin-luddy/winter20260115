{
    "APPLICATION_VERSION": "_APPLICATION_VERSION_",
    "ConnectionStrings": {
        "IES_DATABASE": "_IES_DATABASE_"
    },
    "Splunk": {
        "Host": "_Splunk_Host_",
        "Uri": "services/collector/event",
        "Index": "application_eo",
        "SourceType": "ies_portal:logs:json"
    },
    "LoggerConfig": {
        "LogIntoSplunk": false,
        "LogIntoDb": true,
        "LogIntoFile": true,
        "MinimumLevel": {
            "Default": "Verbose",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System": "Warning"
            }
        }
    },
    "AllowedOrigins": "_AllowedOrigins_",
    //"AllowedRoles":  "AD GROUPS if we want to lock down in app instead of in IIS",
    "AllowedHosts": "*",
    "PortionMarkingAPI": "_PortionMarkingAPI_"
}
