@inherits System.Web.Mvc.WebViewPage<IES.DataBridge.ModelViews.SectionModelView>
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Section Detail";
    JsonSerializerSettings microsoftDateFormatSettings = new JsonSerializerSettings
    {
        DateFormatHandling = DateFormatHandling.MicrosoftDateFormat,
        DateParseHandling = DateParseHandling.DateTime,
        DateTimeZoneHandling = DateTimeZoneHandling.Local
    };
}
<br />
<script type="text/javascript">
    angular.module('RDM').value('SectionDetailModel', {
        baseUrl: '@Url.Content("~/")',
        data: @Html.Raw(JsonConvert.SerializeObject(Model, microsoftDateFormatSettings))
        });
</script>
<div data-ng-app="RDM" data-ng-controller="SectionDetailController">
    <div class="row top-margin-2">
        <div class="col-xs-12">
            <div class="module">
                <div class="module-header-data left">Section Details</div>
                <div class="module-content-data">
                    <div class="form-row css3pie-position-fix">
                        <gen-validation data-errors="$root.errors"></gen-validation>
                    </div>
                    <div class="form-row">
                        <div class="form-label">Parent Id *</div>
                        <div class="form-element">
                            <select>
                                <option value="-1">Top Level</option>
                                <option data-ng-repeat="section in allSections | orderBy:Title" value="section.Id">{{section.ReferenceNumber}} {{section.Title}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-label">Order *</div>
                        <div class="form-element"><input type="text" name="input" data-ng-model="data.Order" required></div>
                    </div>
                    <div class="form-row">
                        <div class="form-label">Title *</div>
                        <div class="form-element"><input type="text" name="input" data-ng-model="data.Title" required></div>
                    </div>
                    <div class="form-row">
                        <div class="form-label">Internal</div>
                        <div class="form-element"><input type="checkbox" name="input" data-ng-model="data.IsInternalSection" /></div>
                    </div>
                    <div class="form-row">
                        <div class="form-label">Additional Contents</div>
                        <div class="form-element">
                            <div class="buttons inline css3pie-position-fix" style="line-height: 28px;">
                                <button id="AddButton-SectionDetailContent" data-ng-click="addContent()" data-ng-disabled="isDataLoading" type="button" class="ies-action">+ Add</button>
                            </div>
                            <table id="AdditionalContentGrid" class="grid readonly">
                                <thead>
                                    <tr>
                                        <th class="content-title">Title</th>
                                        <th>Content Type</th>
                                        <th>Delete</th>
                                    </tr>
                                </thead>
                                <tbody ui:sortable="sortableOptions" ng:model="contents">
                                    <tr class="pointer" data-ng-repeat="content in contents | orderBy:'Order'">
                                        <td class="content-title"><div data-ng-click="modifyContent(content)">{{::content.Title}}</div></td>
                                        <td><div data-ng-click="modifyContent(content)">{{::content.ContentType}}</div></td>
                                        <td><span title="Delete" role="button" data-ng-click="deleteContent(content)" class="glyphicon glyphicon-remove text-danger text-center"></span></td>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="small top-margin-2">Note:  Drag and Drop to reorder contents</div>
                        </div>
                    </div>
                    <div class="form-row css3pie-position-fix">
                        <div class="inline css3pie-position-fix" style="line-height: 28px;">
                            <button id="SaveButton-SectionDetail" data-ng-click="saveSectionDetail()" data-ng-disabled="isDataLoading" type="button" class="ies-action">Save</button>
                            <button id="CancelButton-SectionDetail" data-ng-click="goToSectionGrid()" data-ng-disabled="isDataLoading" type="button" class="ies">Cancel</button>
                            &nbsp; <!-- need line-height and nbsp to ensure div still occupies some real estate when button is hidden -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>