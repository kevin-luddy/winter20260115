@inherits System.Web.Mvc.WebViewPage<IES.DataBridge.ModelViews.FileAttachmentGridModelView>
@using IES.Common
@{
    ViewBag.Title = "File Attachments";
}
<br />
<script type="text/javascript">
    angular.module('RDM').value('FileAttachmentModel', {
        controller: '@IESWebConstants.CONTROLLER_FILE_ATTACHMENTS',
        saveAction: '@IESWebConstants.ACTION_SAVE_FILE_ATTACHMENTS',
        getAction: '@IESWebConstants.ACTION_GET_FILE_ATTACHMENTS',
        baseUrl: '@Url.Content("~/")',
        Area: @((int)LockArea.FileAttachments),        
        SelectedRevisionId: '@Model.SelectedRevisionId'
        });
</script>
<div data-ng-app="RDM" data-ng-controller="FileAttachmentController">
    <div class="row top-margin-2">
        <div class="col-xs-12">
            <div class="module">
                <div class="module-header-data left" data-ng-cloak>
                    File Attachments
                    <span data-ng-if="lockInfo.Editing"> -- Currently locked for edit by {{lockInfo.Editing}}</span> &nbsp; &nbsp;
                    <button id="EnableEditButton-FileAttachments" data-ng-click="lock()" data-ng-disabled="isDataLoading" data-ng-if="lockInfo.IsReadOnly && lockInfo.IsLockAllowed && selectedVersion.Label === '@IES.Common.classes.CommonConstants.WorkInProgress'" type="button" class="ies">Enable Editing</button>
                    <span data-ng-if="showEditLockTimeoutExpiration" class="EditLockTimeoutExpiration">Your edit lock has expired.</span>
                </div>
                <div class="module-content-data" data-ng-hide="isDataLoading" data-ng-cloak>
                    <div class="form-row css3pie-position-fix">
                        <div id="errorMessage"></div>
                        <gen-validation data-errors="$root.errors"></gen-validation>
                        <div class="form-element black" data-ng-hide="canEdit()">
                            Revision: <select data-ng-options="item.Label for item in versions" data-ng-model="selectedVersion" data-ng-change="reloadGrid(true)"></select>
                        </div>
                    </div>
                    <div class="form-row css3pie-position-fix last-form-row" data-ng-hide="isDataLoading || lockInfo.IsReadOnly">
                        <div class="buttons inline css3pie-position-fix" style="line-height: 28px;">
                            <button id="AddButton-FileAttachments" data-ng-click="addFileAttachment()" data-ng-disabled="isDataLoading" type="button" class="ies-action">+ Add</button>
                            &nbsp; <!-- need line-height and nbsp to ensure div still occupies some real estate when button is hidden -->
                        </div>
                    </div>
                    <div class="form-row" data-ng-hide="lockInfo.IsReadOnly">
                        <form name="attachmentForm" id="attachmentForm"> <!-- novalidate prevents HTML5 validation since we will be validating ourselves -->
                            <div id="div1" data-ng-hide="data.length > 0">No attachments found...</div> @* IDs (div1, div2, div3, and div4) added to avoid browserlink bug*@
                            <div id="div2" data-ng-show="data.length > 0" class="scrollable" style="height: 500px;">
                                <table class="grid readonly full-width">
                                    <thead>
                                        <tr>
                                            <th class="bootstrap center columnLines" style="width:60px;"><b>Manage</b></th>
                                            <th class="bootstrap center columnLines"><b>Name</b></th>
                                            <th class="bootstrap center columnLines"><b>Section</b></th>
                                            <th class="bootstrap center columnLines"><b>Url</b></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr data-ng-show="isDataLoading"><td colspan="4"><div class="loader"></div></td></tr>
                                        <tr data-ng-repeat="file in data | filter: { IsDeleted: false }">
                                            <td class="manage-attachments columnLines"><span title="Delete File Attachment" role="button" data-ng-click="showConfirmDelete(file)" class="glyphicon glyphicon-remove text-danger text-center"></span></td>
                                            <td class="columnLines" style="width:180px;"><input type="text" name="name" class="form-control" data-ng-model="file.Name" data-ng-change="file.D=true" required maxlength="100"></td>
                                            <td class="columnLines" style="width:150px;"><select data-ng-model="file.SectionId" data-ng-options="option.Id as option.Label for option in sections" data-ng-change="file.D=true"></select></td>
                                            <td class="columnLines"><input type="text" name="url" class="form-control" data-ng-model="file.Link" data-ng-change="file.D=true" required maxlength="255"></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </form>
                    </div>
                    <div class="form-row" data-ng-show="lockInfo.IsReadOnly">
                        <div id="div3" data-ng-hide="data.length > 0">No attachments found...</div>
                        <div id="div4" data-ng-show="data.length > 0" class="scrollable" style="height: 500px;">
                            <table class="grid readonly full-width">
                                <thead>
                                    <tr>
                                        <th class="bootstrap center columnLines" style="width:220px;" ><b>Name</b></th>
                                        <th class="bootstrap center columnLines" style="width:200px;"><b>Section</b></th>
                                        <th class="bootstrap center columnLines"><b>Url</b></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr data-ng-show="isDataLoading"><td colspan="3"><div class="loader"></div></td></tr>
                                    <tr data-ng-repeat="file in data">
                                        <td class="columnLines" title="{{file.Name}}">{{file.Name}}</td>
                                        <td class="columnLines" title="{{file.Section}}">{{file.Section}}</td>
                                        <td class="columnLines"><a href="{{file.Link}}" target="_blank">{{file.Link}}</a></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="form-row css3pie-position-fix last-form-row" data-ng-hide="lockInfo.IsReadOnly">
                        <div class="inline css3pie-position-fix" style="line-height: 28px;">
                            <button id="SaveButton-FileAttachments" data-ng-click="saveFileAttachmentGrid(true)" data-ng-disabled="isDataLoading || !attachmentForm.$dirty" type="button" class="ies-action">Save</button>
                            <button id="SaveContinueButton-FileAttachments" data-ng-click="saveFileAttachmentGrid(false)" data-ng-disabled="isDataLoading || !attachmentForm.$dirty" type="button" class="ies-action">Save &amp; Continue</button>
                            <button id="CancelButton-FileAttachments" data-ng-click="confirmCancel()" data-ng-disabled="isDataLoading" type="button" class="ies">Cancel</button>
                            &nbsp; <!-- need line-height and nbsp to ensure div still occupies some real estate when button is hidden -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
