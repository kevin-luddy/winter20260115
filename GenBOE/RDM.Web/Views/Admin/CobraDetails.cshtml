@inherits System.Web.Mvc.WebViewPage<IES.DataBridge.ModelViews.CobraGridModelView>
@using IES.Common
@{
    ViewBag.Title = "Cobra Mapping Details";
}
<br />

<script type="text/javascript">
    angular.module('RDM').value('CobraDetailModel', {
        controller: '@IESWebConstants.CONTROLLER_ADMIN',
        saveAction: '@IESWebConstants.ACTION_SAVE_COBRA_DETAILS',
        getCobraDetailsByVersionAction: '@IESWebConstants.ACTION_GET_COBRA_DETAILS_BY_VERSION',
        SelectedRevisionId: '@Model.SelectedRevisionId',
        Area: @((int)LockArea.CobraData)
        });
</script>
<div data-ng-app="RDM" data-ng-controller="CobraDetailController">
    <div class="row top-margin-2">
        <div class="col-xs-12">
            <div class="module">
                <div class="module-header-data left">
                    COBRA Mapping Details
                    <span data-ng-cloak data-ng-if="lockInfo.Editing"> -- Currently locked for edit by {{lockInfo.Editing}}</span> &nbsp; &nbsp;
                    <button id="EnableEditButton-CobraDetail" data-ng-cloak data-ng-click="lock()" data-ng-disabled="isDataLoading" data-ng-if="lockInfo.IsReadOnly && lockInfo.IsLockAllowed && selectedVersion.Label === '@IES.Common.classes.CommonConstants.WorkInProgress'" type="button" class="ies">Enable Editing</button>
                    <span data-ng-cloak data-ng-if="showEditLockTimeoutExpiration" class="EditLockTimeoutExpiration">Your edit lock has expired.</span>
                </div>
                <div class="module-content-data" data-ng-cloak>
                    <div class="form-row css3pie-position-fix">
                        <div id="errorMessage" data-ng-cloak></div>
                        <gen-validation data-errors="$root.errors"></gen-validation>
                        <div class="notificationMessage" id="notificationMessage" data-ng-show="notificationMessage" data-ng-cloak>{{notificationMessage}}</div>
                        <div class="form-element black" data-ng-hide="canEdit()">
                            Version: <select data-ng-options="item.Label for item in versions" data-ng-model="selectedVersion" data-ng-change="reloadGrid()"></select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div ui-grid="gridOptions" ui-grid-edit ui-grid-cellNav ui-grid-pagination ui-grid-exporter ui-grid-resize-columns class="cobra-detail-grid-ui"></div>
                    </div>
                    <div class="form-row css3pie-position-fix last-form-row" data-ng-hide="lockInfo.IsReadOnly">
                        <div class="inline css3pie-position-fix">
                            <button id="SaveButton-CobraDetail" data-ng-click="saveCobraDetail(true)" data-ng-disabled="isDataLoading || !PageIsDirty || !isDataValid" type="button" class="ies-action">Save</button>
                            <button id="SaveContinueButton-CobraDetail" data-ng-click="saveCobraDetail(false)" data-ng-disabled="isDataLoading || !PageIsDirty || !isDataValid" type="button" class="ies-action">Save &amp; Continue</button>
                            <button id="CancelButton-CobraDetail" data-ng-click="confirmCancel()" data-ng-disabled="isDataLoading" type="button" class="ies">Cancel</button>
                            &nbsp; <!-- need line-height and nbsp to ensure div still occupies some real estate when button is hidden -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
