{
    "APPLICATION_VERSION": "_APPLICATION_VERSION_",
    "ConnectionStrings": {
        "IESEntities": "_IES_ENTITIES_"
    },
    "Splunk": {
        "Host": "_Splunk_Host_",
        "Uri": "services/collector/event",
        "Index": "application_eo",
        "SourceType": "ies_portal:logs:json"
    },
    "LoggerConfig": {
        "LogIntoSplunk": false,
        "LogIntoDb": true,
        "LogIntoFile": true,
        "MinimumLevel": {
            "Default": "Verbose",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System": "Warning"
            }
        }
    },
    "AllowedOrigins": "https://*.lmco.com",
    "AllowedHosts": "*",
    "IESUrl": "_IESUrl_",
    "PTMUrl": "_PTMUrl_",
    "Federation": {
        "ClientId": "eo-ssc-ies",
        "ValidAudiences": "eo-ssc-ies,eo-ssc-acv,eo-ssc-nlf",
        "Authority": "_FEDERATION_AUTHORITY_",
        "Secret": "_FEDERATION_SECRET_"
    },
    "AuthorizeViewWhosOnlineGroups": "_AUTHORIZE_WHOS_ONLINE_GROUPS_",
    "HideNonPortionMarking": "_HIDE_NON_PORTION_MARKING_",
    "HidePortionMarking": "_HIDE_PORTION_MARKING_",
    "IsProduction":  "_IS_PRODUCTION_"
}
