{
  "APPLICATION_VERSION": "_APPLICATION_VERSION_",
  "ConnectionStrings": {
    "IES_DATABASE": "_IES_DATABASE_"
  },
  "Splunk": {
    "Host": "_Splunk_Host_",
    "Uri": "services/collector/event",
    "Index": "application_eo",
    "SourceType": "ies_portal:logs:json"
  },
  "LoggerConfig": {
    "LogIntoSplunk": false,
    "LogIntoDb": true,
    "LogIntoFile": true,
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedOrigins": "_AllowedOrigins_",
  "AllowedHosts": "*",
  "IESUrl": "_IESUrl_",
  "PTMUrl": "_PTMUrl_",
  "PortionMarkingAPI": "_PortionMarkingAPI_",
  "Federation": {
    "ClientId": "_FEDERATION_CLIENT_ID_",
    "ValidAudiences": "_FEDERATION_AUDIENCES_",
    "Authority": "_FEDERATION_AUTHORITY_",
    "Secret": "_FEDERATION_SECRET_"
  },
  "AuthorizeViewWhosOnlineGroups": "_AUTHORIZE_WHOS_ONLINE_GROUPS_",
  "IsProduction": "_IS_PRODUCTION_",
  "FeatureFlags": {
    "HideNonPortionMarking": "_HIDE_NON_PORTION_MARKING_",
    "HidePortionMarking": "_HIDE_PORTION_MARKING_"
  }
}