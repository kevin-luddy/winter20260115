<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="loggingConfiguration" type="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.LoggingSettings, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" requirePermission="true" />
		<section name="systemConfiguration" type="IES.Common.SystemConfigurationSection, IES.Common, Version=1.0.0.0" />
		<!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
		<section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
		<sectionGroup name="elmah">
			<section name="security" requirePermission="false" type="Elmah.SecuritySectionHandler, Elmah" />
			<section name="errorLog" requirePermission="false" type="Elmah.ErrorLogSectionHandler, Elmah" />
			<section name="errorMail" requirePermission="false" type="Elmah.ErrorMailSectionHandler, Elmah" />
			<section name="errorFilter" requirePermission="false" type="Elmah.ErrorFilterSectionHandler, Elmah" />
		</sectionGroup>
	</configSections>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
	<appSettings>
		<add key="IsPLDIntegrated" value="__IsPLDIntegrated__" />
		<add key="LogType" value="__LogType__" />
		<!-- FOR A LOCAL RUN, we need these -->
		<!--<add key="IsPLDIntegrated" value="true" />
		<add key="LogType" value="INFO" />-->
	</appSettings>
	<connectionStrings>
		<add name="GenBoeEntities" connectionString="metadata=res://*/BOEEntityModel.csdl|res://*/BOEEntityModel.ssdl|res://*/BOEEntityModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;__GenBoeEntities__Integrated Security=True;Encrypt=True;TrustServerCertificate=Yes;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
		<add name="PldDBContext" connectionString="Data Source=DOUVILLE\R1SDP04001;Initial Catalog=PLD;Integrated Security=True;Encrypt=True;TrustServerCertificate=Yes;MultipleActiveResultSets=True" providerName="System.Data.SqlClient" />
		<!-- FOR A LOCAL RUN, we need these -->
		<!--<add name="GenBoeEntities" connectionString="metadata=res://*/BOEEntityModel.csdl|res://*/BOEEntityModel.ssdl|res://*/BOEEntityModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;Data Source=Cudan\SSAPPVFDEV;Initial Catalog=GenBOEMST_Dev;Integrated Security=True;Encrypt=True;TrustServerCertificate=Yes;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
		<add name="PldDBContext" connectionString="Data Source=DOUVILLE\R1SDP04001;Initial Catalog=PLD;Integrated Security=True;Encrypt=True;TrustServerCertificate=Yes;MultipleActiveResultSets=True" providerName="System.Data.SqlClient" />-->
	</connectionStrings>
	<elmah>
		<security allowRemoteAccess="true" />
		<errorLog type="Elmah.SqlErrorLog, Elmah" connectionString="__GenBoeEntities__integrated security=True;Encrypt=True;multipleactiveresultsets=True;" applicationName="__ElmahAppName__" />
		<!-- FOR A LOCAL RUN, we need these -->
		<!--<errorLog type="Elmah.SqlErrorLog, Elmah" connectionString="data source=Cudan\SSAPPVFDEV;Initial Catalog=GenBOEMST_Dev;integrated security=True;Encrypt=True;multipleactiveresultsets=True;" applicationName="PLDStatusSync" />-->
	</elmah>
