  <appSettings>
    <add key="DisableAllEmails" value="false" />
    <add key="ActiveDirectoryPath" value="GC://usadc-gtm.us.lmco.com" />
    <add key="EmailServer" value="smtp-lmiden.ems.lmco.com" />
    <add key="EmailsToCurrentlyLoggedInUser" value="True" />
    <add key="ServerURL" value="generationdev.isgs.lmco.com" />
    <add key="ReportServerLocation" value="http://cossql23/ReportServer_ITAPPSDEV2012/?" />
    <add key="ReportServerFolderName" value="generation/genBOEMST" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <!--Keep these dates as is so that dependent tests in TravelTripCostCalculationTest class-->
    <!--Turn on/off new formula requirements: On = a valid date in short format (e.g. 01/01/2013), Off = anything else-->
    <add key="MIECostUpdateActivationDate" value="01/01/2012" />
    <!--A valid date to compare trip dates against.  Set day to the first of the month to simulate ignoring the day in date comparisons.  Needs to be a valid date in short format or new formula will not be applied-->
    <add key="MIECostUpdateTripDate" value="07/01/2012" />
    <add key="DomesticUsersGroup" value="mockindomestic" />
    <add key="SubsTreatedAsLmEmployees" value="acct04\ipe.genBOE.spacesystems.subcontractor.admins" />
    <add key="OverrideSubNonUs" value="false" />
    <add key="RDMAdminGroups" value="us\ebs.ies.dev.rdmadmins,ebs.ies.rdmadmins" />
    <add key="TestGroups1" value="ebs.group1,ebs.group2" />
    <add key="TestGroups2" value="us\ebs.group1,us\ebs.group2" />
    <add key="UsersAllowedProPricerAccess" value="US\EBS.EstimationInitiative.DevTeam,US\EBS.EstimationInitiative.ApprovedDevAndTestUsers" />
    <add key="SystemAdminADGroup" value="US\EBS.IES.UAT.NLF.SysAdmin" />
    <add key="SubcontractAdminADGroup" value="US\EBS.IES.UAT.NLF.SCA" />
    <!-- used as governor for threading Parallel.ForEach.  primarily for warming task elements -->
    <add key="MaxDegreeOfParallelism" value="3" />
    <add key="IsPTMIntegrated" value="true" />
    <add key="CompanyConfiguration" value="SpaceSystems" />
    <add key="MoqTemplateStartDate" value="10/16/2020" />
    <add key="MOQHelpBaseUrl" value="http://fbo-kbm.us.lmco.com/index.php?/article/" />
    <add key="IESSAPUrl" value="http://localhost:5501" />
    <!--<add key="IESSAPUrl" value="https://dev-ies-sap.ssc.lmco.com" />-->
	<add key="SAPSpaceStartDate" value="03/21/2012" />
	<add key="oAuthDomain" value="https://authuat.p.external.lmco.com/" />
	<add key="oAuthIESClientId" value="eo-ssc-ies" />
	<add key="oAuthIESClientSecret" value="4yUByyvJIO9oubWtq1LQiPp7jgX9zMkkyYzrHkIu" />
	<add key="HistoricalReferenceExplanationStartDate" value="01/01/2024" />
	<add key="SkillMixStartDate" value="08/01/2034" />
	<add key="EnableSkillMix" value="true" />
	<add key="OneLmxStartDate" value="01/01/2029"/>
  </appSettings>
  <loggingConfiguration name="" tracingEnabled="true" defaultCategory="General">
    <listeners>
      <add name="Rolling Flat File Trace Listener" type="Microsoft.Practices.EnterpriseLibrary.Logging.TraceListeners.RollingFlatFileTraceListener, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" listenerDataType="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.RollingFlatFileTraceListenerData, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" fileName="logs/generation.log.txt" formatter="Text Formatter" header="" rollFileExistsBehavior="Increment" rollSizeKB="2048" />
    </listeners>
    <formatters>
      <add type="Microsoft.Practices.EnterpriseLibrary.Logging.Formatters.TextFormatter, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" template="Timestamp: {timestamp(local)} | Title: {title} | Priority: {priority} | Severity: {severity} | Machine: {localMachine} | ProcessId: {localProcessId}{newline} Message: {message}" name="Text Formatter" />
    </formatters>
    <categorySources>
      <add switchValue="All" name="General">
        <listeners>
          <add name="Rolling Flat File Trace Listener" />
        </listeners>
      </add>
    </categorySources>
    <specialSources>
      <allEvents switchValue="All" name="All Events" />
      <notProcessed switchValue="All" name="Unprocessed Category" />
      <errors switchValue="All" name="Logging Errors &amp; Warnings">
        <listeners>
          <add name="Rolling Flat File Trace Listener" />
        </listeners>
      </errors>
    </specialSources>
  </loggingConfiguration>
