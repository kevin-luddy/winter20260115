<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="loggingConfiguration" type="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.LoggingSettings, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" requirePermission="true" />
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    <sectionGroup name="elmah">
      <section name="security" requirePermission="false" type="Elmah.SecuritySectionHandler, Elmah" />
      <section name="errorLog" requirePermission="false" type="Elmah.ErrorLogSectionHandler, Elmah" />
      <section name="errorMail" requirePermission="false" type="Elmah.ErrorMailSectionHandler, Elmah" />
      <section name="errorFilter" requirePermission="false" type="Elmah.ErrorFilterSectionHandler, Elmah" />
    </sectionGroup>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="glimpse" type="Glimpse.Core.Configuration.Section, Glimpse.Core" />
  </configSections>
  <connectionStrings>
    <add name="genTracEntities" connectionString="metadata=res://*/PTMEntityModel.csdl|res://*/PTMEntityModel.ssdl|res://*/PTMEntityModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=Cudan\SSAPPVFDEV;Initial Catalog=genTRAC_Dev;integrated security=True;Encrypt=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
    <add name="GenBoeEntities" connectionString="metadata=res://*/BOEEntityModel.csdl|res://*/BOEEntityModel.ssdl|res://*/BOEEntityModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=Cudan\SSAPPVFDEV;Initial Catalog=GenBOESpace_DEV;integrated security=True;Encrypt=True;multipleactiveresultsets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
  </connectionStrings>
  <appSettings>
    <!-- General Settings -->
    <add key="EmailServer" value="smtp-lmiden.ems.lmco.com" />
    <add key="ActiveDirectoryPath" value="GC://usadc-gtm.us.lmco.com" />
    <add key="ServerURL" value="https://uat-ptm.ssc.lmco.com/" />
    <add key="AuthorizeProposalCreationGroups" value="US\lmco.all.emp" />
    <add key="DomesticUsersGroup" value="US\lmco.all.emp" />
    <add key="HelpdeskEmailAddress" value="generation-support.fc-ssc@lmco.com" />
    <add key="BaseUrlForInstructionLocation" value="https://space.p.external.lmco.com/sites/fbo/CCDME/Estimating/Checklist%20Reference%20Documents/" />
    <add key="IsClassEnvironment" value="false" />
    <add key="OverrideSubNonUs" value="false" />
    <add key="oAuthValidAudiences" value="eo-ssc-ies,eo-ssc-acv,eo-ssc-nlf" />
	<add key="oAuthDomain" value="https://authuat.p.external.lmco.com/" />
	<add key="DocumentReminderCutoffDate" value="01/01/2025" />
	<add key="AltPricingMethodStartDate" value="11/01/2025"/>
    <!-- Integration w/ eEPP -->
    <add key="EnableEppIntegration" value="true" />
    <add key="eEPPUrl" value="https://localhost:44386" />
    <!-- SSRS Report Settings -->
    <add key="ReportServerLocation" value="https://sscreports-qas.ssc.lmco.com/ReportServer_SSRS30A/Pages/ReportViewer.aspx?" />
    <add key="ReportServerFolderName" value="generation/genTrac" />
    <!-- Other URLs -->
    <add key="IESHomeUrl" value="https://dev-ies.ssc.lmco.com/assets/dev-header.html" />
	<add key="IESBannerUrl" value="https://dev-ies.ssc.lmco.com/maintenancebanner/" />
	<add key="IESBannerApp" value="PTM" />
	<add key="RDSBUrl" value="https://dev-rdsb.ssc.lmco.com/" />
    <add key="BOEUrl" value="https://uat-genboe.ssc.lmco.com/" />
    <!-- Piwik Settings -->
    <add key="DisablePiwik" value="true" />
    <add key="PiwikURL" value="https://ebstools-matomo.us.lmco.com/" />
    <add key="PiwikId" value="0" />
    <!--Approval Workflow Role AD Groups -->
    <add key="LeadEstimators" value="us\EBS.IES.Dev.LeadEstimators" />
    <add key="LOBManagers" value="us\EBS.IES.Dev.LeadEstimators" />
    <add key="CoverSheetApprovers" value="us\EBS.IES.Dev.CoverSheetApprovers" />
    <add key="PricingVerifications" value="us\EBS.IES.Dev.LeadEstimators" />
    <add key="IndependentReviewers" value="us\EBS.IES.IndependentReviewer" />
    <add key="ContractsLead" value="dl-Space, EBS.IES.UAT.PTM.Contract.Leads" />
	<add key="MaterialsLead" value="us\ipe.NLF.DEV.approvedusers" />
	<add key="SubcontractsLead" value="us\ipe.NLF.IBOE.DEV.approvedusers" />
    <!-- Dev level settings -->
    <add key="APPLICATION_VERSION" value="WIP - Local" />
    <add key="LogType" value="INFO" />
    <add key="ChecklistRowCommentVersion" value="6" />
    <add key="ChecklistChangeToPTMVersion" value="9" />
    <add key="ForecastedDaysOut" value="45" />
    <add key="ProfitFeeComSplitStartDate" value="7/1/2021" />
    <add key="CostThroughComStartDate" value="7/28/2022" />
	<add key="InternationalCostStartDate" value="1/1/2024" />
    <add key="ClearCacheOnStartup" value="true" />
    <add key="toolPrefix" value="" />
    <add key="TransactionTimeout" value="360" />
    <add key="ShowUserName" value="true" />
    <add key="MaxDbQueries" value="25" />
    <add key="IsIdentitySwappingAllowed" value="true" />
    <add key="ADGroupsAllowedToSwapIdentity" value="us\EBS.EstimationInitiative.DevTeam" />
    <add key="DisableAllEmails" value="True" />
    <add key="EmailsToCurrentlyLoggedInUser" value="true" />
    <add key="PSAMaxFileSize" value="30000000" />
    <add key="PSAMaxOtherFileCount" value="10" />
    <add key="PSAAllowedFileTypes" value=".doc,.docx,.ppt,.pptx,.xls,.xlsx,.pdf" />
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="PreserveLoginUrl" value="true" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
	<!-- Turn env var and app setting logging on and off-->
	<add key="EnableEnvionmentInfoLogging" value="false" />
  </appSettings>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.8.1" />
      </system.Web>
  -->
  <system.web>
    <httpCookies httpOnlyCookies="true" requireSSL="false" />
    <httpRuntime targetFramework="4.5" maxRequestLength="30000000" />
    <compilation debug="true" targetFramework="4.8" />
    <authentication mode="Windows" />
    <authorization>
      <allow roles="us\EBS.EstimationInitiative.DevTeam,us\EBS.EstimationInitiative.ApprovedDevAndTestUsers,us\EBS.EstimationInitiative.AacctDevTeam" />
      <deny users="*" />
    </authorization>
    <pages>
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
      </namespaces>
    </pages>
    <httpHandlers>
      <add verb="POST,GET,HEAD" path="elmah.axd" type="Elmah.ErrorLogPageFactory, Elmah" />
      <add path="glimpse.axd" verb="GET" type="Glimpse.AspNet.HttpHandler, Glimpse.AspNet" />
    </httpHandlers>
    <!-- Glimpse: This can be commented in to add additional data to the Trace tab when using WebForms
        <trace writeToDiagnosticsTrace="true" enabled="true" pageOutput="false"/> -->
    <httpModules>
      <add name="ErrorLog" type="Elmah.ErrorLogModule, Elmah" />
      <add name="Glimpse" type="Glimpse.AspNet.HttpModule, Glimpse.AspNet" />
    </httpModules>
    <customErrors mode="On" defaultRedirect="Error">
      <error statusCode="404" redirect="Error" />
    </customErrors>
  </system.web>
  <elmah>
    <security allowRemoteAccess="true" />
    <errorLog type="Elmah.SqlErrorLog, Elmah" connectionString="data source=Cudan\SSAPPVFDEV;Initial Catalog=genTRAC_DEV;integrated security=True;Encrypt=True;multipleactiveresultsets=True;" applicationName="PTM_UAT" />
  </elmah>
  <location path="elmah.axd">
    <system.web>
      <authorization>
        <allow roles="us\EBS.EstimationInitiative.DevTeam" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- This section gives the unauthenticated user access to all of the methods in the PtmData API Controller. -->
  <location path="API/PtmDataAPI">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- The settings below are system settings, and as such should not be modified as a part of the deployment process -->
  <loggingConfiguration name="" tracingEnabled="true" defaultCategory="General">
    <listeners>
      <add name="Rolling Flat File Performance Listener" type="Microsoft.Practices.EnterpriseLibrary.Logging.TraceListeners.RollingFlatFileTraceListener, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" listenerDataType="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.RollingFlatFileTraceListenerData, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" fileName="logs/generation.performance.csv" footer="" formatter="Performance Formatter" header="" rollFileExistsBehavior="Increment" rollSizeKB="20000" filter="Information" />
    </listeners>
    <formatters>
      <add type="Microsoft.Practices.EnterpriseLibrary.Logging.Formatters.TextFormatter, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" template="{timestamp(local)},{message}" name="Performance Formatter" />
    </formatters>
    <categorySources>
      <add switchValue="All" name="Performance">
        <listeners>
          <add name="Rolling Flat File Performance Listener" />
        </listeners>
      </add>
    </categorySources>
    <specialSources>
      <allEvents switchValue="All" name="All Events" />
      <notProcessed switchValue="All" name="Unprocessed Category" />
      <errors switchValue="All" name="Logging Errors &amp; Warnings" />
    </specialSources>
  </loggingConfiguration>
  <system.webServer>
	  <validation validateIntegratedModeConfiguration="false" />
    <modules>
      <add name="ErrorLog" type="Elmah.ErrorLogModule, Elmah" preCondition="managedHandler" />
      <add name="Glimpse" type="Glimpse.AspNet.HttpModule, Glimpse.AspNet" preCondition="integratedMode" />
    </modules>
    <handlers>
      <add name="Elmah" verb="POST,GET,HEAD" path="elmah.axd" type="Elmah.ErrorLogPageFactory, Elmah" preCondition="integratedMode" />
      <add name="Glimpse" path="glimpse.axd" verb="GET" type="Glimpse.AspNet.HttpHandler, Glimpse.AspNet" preCondition="integratedMode" />
		<remove name="ExtensionlessUrlHandler-Integrated-4.0" />
		<remove name="OPTIONSVerbHandler" />
		<remove name="TRACEVerbHandler" />
		<add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
	</handlers>
    <rewrite>
      <rules>
        <rule name="Redirect to HTTPs" stopProcessing="true" enabled="false">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
  <location path="glimpse.axd">
    <system.web>
      <authorization>
        <allow roles="US\EBS.EstimationInitiative.DevTeam" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
