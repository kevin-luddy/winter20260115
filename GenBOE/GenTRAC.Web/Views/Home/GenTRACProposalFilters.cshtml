@model GenTRAC.ActionLogic.ModelView.Home.HomeProposalFiltersModelView

@{
    string ProposalFilterHelpText = "Select a status category from the dropdown and optionally enter a date range.  If no date range entered the filter will return all proposals in that category (e.g., “In Progress”) regardless of date range. " +
                        "<br/> <br/>" + "This view is limited to Active (i.e., In Progress, No Bid, Revised, or Completed) proposals where you are listed as one of the roles on either the Proposal record or the associated checklist.";
}
<script type="text/javascript">
    var ProposalFiltersWidget;

    $(function () {
        var ProposalFiltersWidgetConfig = {};
        ProposalFiltersWidgetConfig.ContextID = "proposalFiltersSection";
        ProposalFiltersWidgetConfig.IsModule = true;
        var FormConfigs = [];
        FormConfigs.push({
            ElementID: "proposalFiltersForm",
            Buttons: [
            {
                ButtonClass: 'ies',
                ButtonText: 'Apply Filter',
                ButtonName: "apply-filters-button",
                ButtonAction: function (buttonPressed) {
                    ProposalFiltersWidget.ApplyFilters(true);
                },
                Stateful: false
            },
            {
                ButtonClass: 'ies',
                ButtonText: 'Clear Dates',
                ButtonName: "clear-dates-button",
                ButtonAction: function () {
                    ProposalFiltersWidget.ClearDates();
                },
                Stateful: false
            }],
            HideOCI: "true"
        });

        ProposalFiltersWidgetConfig.FormConfigs = FormConfigs;

        ProposalFiltersWidget = new GenWidget(ProposalFiltersWidgetConfig);

        ProposalFiltersWidget.getElement('input[name="filterStartDate"]').datepicker({
            dateFormat: 'mm/dd/yy',
            onSelect: function (dateText, inst) {
                $(this).blur();
                $(this).next('button.ui-datepicker-trigger').attr('tabindex', '0');
                $(this).next('button.ui-datepicker-trigger').focus();
            }
        });
        ProposalFiltersWidget.getElement('input[name="filterEndDate"]').datepicker({
            dateFormat: 'mm/dd/yy',
            onSelect: function (dateText, inst) {
                $(this).blur();
                $(this).next('button.ui-datepicker-trigger').attr('tabindex', '0');
                $(this).next('button.ui-datepicker-trigger').focus();
            }
        });

        // skip datepicker icons when tabbing
        ProposalFiltersWidget.getElement('.ui-datepicker-trigger').attr('tabindex', '-1');
        ProposalFiltersWidget.getElement('.ui-datepicker-trigger').on('blur', function () {
            $(this).attr('tabindex', '-1');
        });

        ProposalFiltersWidget.InitializeValues = function () {
            var selectedOption = ProposalFiltersWidget.getElement('select[name="filterOption"]').val('@(Model.FilterOption)');
            $('input[name="proposalFilterOption"]').val(selectedOption);
            selectedOption = ProposalFiltersWidget.getElement('select[name="viewerFilterOption"]').val('@(Model.ViewerFilterOption)');
            $('input[name="viewerProposalFilterOption"]').val(selectedOption);
            if ('@(Model.IsViewer)' === "true") {
                $('#viewerFilterOptionDiv').removeClass("display-none");
            }
        }

        ProposalFiltersWidget.ChangeFilterOption = function () {
            var selectedOption = ProposalFiltersWidget.getElement('select[name=filterOption]').val();
            text = "";
            if (selectedOption == "InProgress") {
                text = "Assigned between";
            }
            else if (selectedOption == "Completed") {
                text = "Workflow Completed between";
            }
            else if (selectedOption == "NoBid") {
                text = "No Bid between";
            }
            else if (selectedOption == "All") {
                text = "Completed or Assigned between";
            }
            ProposalFiltersWidget.getElement('div[name=filterOptionText]').html(text);
        }

        /*
        * Clear Dates
        */
        ProposalFiltersWidget.ClearDates = function () {

            var startDate = ProposalFiltersWidget.getElement('input[name="filterStartDate"]').val();
            var endDate = ProposalFiltersWidget.getElement('input[name="filterEndDate"]').val();

            // Reset the date fields on 'Clear' button click.
            if (startDate != "mm/dd/yyyy" || endDate != "mm/dd/yyyy") {
                ProposalFiltersWidget.getElement('input[name="filterStartDate"]').val('');
                ProposalFiltersWidget.getElement('input[name="filterEndDate"]').val('');
            }
            ProposalFiltersWidget.getElement('input[name="filterStartDate"]').removeClass('not-placeholder-value');
            ProposalFiltersWidget.getElement('input[name="filterEndDate"]').removeClass('not-placeholder-value');
        }

        /*
        * Filter Change
        */
        ProposalFiltersWidget.ApplyFilters = function (filterButtonClicked) {
            var button = null;
            // Show the spinner, hide the data
            $('.proposalDataRows').hide();
            $('#proposalLoader').show();
            homeWidget.refreshModule();

            // update hidden fields for SSRS Export report
            var startDate = ProposalFiltersWidget.getElement('input[name="filterStartDate"]').val();
            var endDate = ProposalFiltersWidget.getElement('input[name="filterEndDate"]').val();
            var selectedOption = ProposalFiltersWidget.getElement('select[name=filterOption]').val();
            $('input[name="proposalFilterOption"]').val(selectedOption);
            selectedOption = ProposalFiltersWidget.getElement('select[name=viewerFilterOption]').val();
            $('input[name="viewerProposalFilterOption"]').val(selectedOption);
            $('input[name="proposalFilterStart"]').val(startDate);
            $('input[name="proposalFilterEnd"]').val(endDate);
            selectedOption = ProposalFiltersWidget.getElement('select[name=proposalClass]').val();
            $('input[name="proposalClassFilterOption"]').val(selectedOption);

            // Setup sent data
            var dataToSend = {};
            dataToSend.sortField = $('#SortField').val();
            dataToSend.order = $('#Order').val();
            if (filterButtonClicked) {
                button = $("#proposalFiltersForm button[name='apply-filters-button']");
                dataToSend.filtersModelView = ProposalFiltersWidget.getForm("proposalFiltersForm").getData();
            }
            else {
                dataToSend.filtersModelView = null;
            }
            dataToSend.searchText = HomeProposalWidget.SearchText;

            dataToSend = JSON.stringify(dataToSend);

            // Make the call
            ProposalFiltersWidget.saveRequest({
                type: 'POST',
                url: GenSession.CreateUrl({
                    controller: '@WebConstants.Controller.HOME',
                    action: '@WebConstants.Action.HOME_PROPOSAL_GRID_DISPLAY'
                }),
                contentType: 'application/json; charset=utf-8',
                dataType: 'html',
                data: dataToSend,
                success: function (response) {
                    $('#homeProposalPlaceholder').html(response);

                    GenTRAC.bindSorting(HomeProposalWidget);

                    // hide the spinner, show data
                    $('#proposalLoader').hide();
                    $('.proposalDataRows').show();

                    homeWidget.refreshModule();
                },
                error: function () {
                    // hide the spinner, show data
                    $('#proposalLoader').hide();
                    $('.proposalDataRows').show();

                    homeWidget.refreshModule();
                }
            }, button);
        }

        ProposalFiltersWidget.ChangeFilterOption();
        ProposalFiltersWidget.InitializeValues();
        homeWidget.refreshModule();
    });
</script>

<div id="proposalFiltersSection" class="composite module expanded full">
    <div class="module-header-data" id="proposalFilterHeaderData">
        Proposal Filter
        <span helptext="@ProposalFilterHelpText">
        </span>
    </div>
    <div class="filter-module module-content-data expanded-content">
        @using (Html.BeginForm("", "", FormMethod.Post, new { id = "proposalFiltersForm", name = "proposalFiltersForm" }))
        {
            <div class="proposalFilters">
                <div style="width:80px; vertical-align:central;" >
                    @Html.DropDownList("filterOption", Model.FilterOptions, new { @onchange = "ProposalFiltersWidget.ChangeFilterOption()", @class="ignore-dirty", @style="vertical-align:inherit;"})
                </div>
                <div style="width: 160px; text-align:right;">
                    <div name="filterOptionText" style="vertical-align:middle"></div>
                </div>
                <div style="width: 215px;" >
                    <input id="filterStartDate" name="filterStartDate" type="text" class="date ignore-dirty" maxlength="10" style="width:60px; vertical-align:middle;" placeholder="mm/dd/yyyy" value="@Model.FilterStartDate" />
                    And
                    <input id="filterEndDate" name="filterEndDate" type="text" class="date ignore-dirty" maxlength="10" style="width:60px; vertical-align:middle;" placeholder="mm/dd/yyyy" value="@Model.FilterEndDate" />
                </div>
                <div style="width:162px; vertical-align:central;" class="display-none" id="viewerFilterOptionDiv">
                    @Html.DropDownList("viewerFilterOption", Model.ViewerFilterOptions, new { @class = "ignore-dirty", @style = "vertical-align:inherit; width: 162px;" })
                </div>
                <div>
                    @Html.DropDownList("proposalClass", Model.ProposalClassFilterOptions, new { @class = "ignore-dirty", @style = "vertical-align:inherit;" })
                </div>
                <div>
                    <input type="hidden" name="proposalFilterOption" />
                    <input type="hidden" name="viewerProposalFilterOption" />
                    <input type="hidden" name="proposalFilterStart" />
                    <input type="hidden" name="proposalFilterEnd" />
                    <input type="hidden" name="proposalClassFilterOption" />
                </div>
                <div class="button-container"></div>
            </div>
        }
    </div>
</div>
