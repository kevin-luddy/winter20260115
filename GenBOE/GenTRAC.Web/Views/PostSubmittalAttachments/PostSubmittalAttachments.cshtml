@model PostSubmittalAttachmentModelView
@using GenTRAC.ActionLogic.ModelView.PostSubmittalAttachments
@using GenTRAC.DataBridge.DTO
@{ string referencePrefix = "(REFERENCE) "; }
    <script>
    var psaWidget;

    $(function () {
        var widgetConfig = {};
        widgetConfig.ContextID = "psaWidget";
        widgetConfig.IsModule = true;

        psaWidget = new GenWidget(widgetConfig);

        // Update dates
        $('[data-utcdate]').each(function () {
            if ($(this).attr('data-utcdate') !== '') {
                var d = moment.utc($(this).attr('data-utcdate'));
                $(this).html(d.tz('America/New_York').format('M/D/YYYY, h:mm A zz'));
            }
        });

        psaWidget.ValidateFileTypeAndSize = function(e) {
            var errors = [];

            // Check file extension
            var allowedExtensions = "@Model.AllowedFileTypes".split(',');
            var filePath = e.files[0].name;

            var ext = filePath.substring(filePath.lastIndexOf('.')).toLowerCase();
            if (allowedExtensions.indexOf(ext) < 0) {
                errors.push(
                    'Only files with the following file extensions are allowed: @Model.AllowedFileTypes');
            }

            // Check size
            if (e.files[0].size > @Model.MaxFileSize) {
                errors.push('File cannot be larger than @(Model.MaxFileSize / 1000000) MB');
            }
            return errors;
        };

        psaWidget.refreshPage = function() {
            var url = GenSession.CreateUrl({
                controller: '@WebConstants.Controller.PROPOSAL',
                action: '@WebConstants.Action.DISPLAY_PROPOSAL_DETAILS',
                id: '@Model.ProposalId'
            });
            window.location = url + '#PSA';
            window.location.reload();
        };
        psaWidget.UpdateFields = function(attachment) {
            // The attachment identifier is <AttachmentType> (as an int) for standard attachments.  For 'Other' attachments, it is <AttachmentType>-<AttachmentId>.
            var attachmentIdentifier = attachment.AttachmentType;
            attachmentIdentifier += attachment.AttachmentType == @((int)AttachmentType.Other) ? '-' + attachment.Id : '';

            $('#filenameLink-' + attachmentIdentifier).text((attachment.IsRevisionReference ? '@referencePrefix' : '') + attachment.Name);
            $('#fileId-' + attachmentIdentifier).val(attachment.Id);
            $('#updateDateLong-' + attachmentIdentifier).val(attachment.UpdateDateLong);
            $('#IsRevisionReference-' + attachmentIdentifier).val(attachment.IsRevisionReference);

            if (attachment.Name === null) {
                $('#uploadedBy-' + attachmentIdentifier).text('');
                $('#updateDate-' + attachmentIdentifier).text('');
                $('#filenameLink-' + attachmentIdentifier).hide();
                $('#filenameLabel-' + attachmentIdentifier).show();
                $('#filenameLabelRevision-' + attachmentIdentifier).hide();
                $('#deleteEnabled-' + attachmentIdentifier).hide();
                $('#deleteDisabled-' + attachmentIdentifier).show();
            } else {
                $('#uploadedBy-' + attachmentIdentifier).text(attachment.UploadedBy);
                $('#updateDate-' + attachmentIdentifier).text(moment(attachment.UpdateDate).tz('America/New_York').format('M/D/YYYY, h:mm A zz'));
                $('#filenameLink-' + attachmentIdentifier).show();
                $('#filenameLink-' + attachmentIdentifier).attr("href", psaWidget.GetDownloadFileUrl(attachment.Id));
                $('#filenameLabel-' + attachmentIdentifier).hide();
                $('#deleteEnabled-' + attachmentIdentifier).show();
                $('#deleteDisabled-' + attachmentIdentifier).hide();
            }
        };

        psaWidget.GetDownloadFileUrl = function(fileId) {
            var url = GenSession.CreateUrl({
                controller: '@WebConstants.Controller.PSA',
                action: '@WebConstants.Action.DOWNLOAD_ATTACHMENT',
                id: '@Model.ProposalId'
            });
            url += "?fileId=" + fileId;
            return url;
        };

        // Add an attachment - first method in the chain, here to deal with a potential revision options
        psaWidget.AddAttachment = function (fileInputId, attachmentType) {
            if ('@(ViewBag.IsRevision)' == 'True' && attachmentType != @((int)AttachmentType.Other)) {
                GenSession.commonDialog('Revision File Upload', 'Would you like to upload a new file, or is the document provided in the previous version and is still up to date?',
                    [{
                        buttonClass: 'ies-action',
                        ButtonText: 'Upload New File',
                        ButtonName: "new-button",
                        callbackMethod: function () { psaWidget.SelectFile(fileInputId); }
                    }, {
                        buttonClass: 'ies-warning',
                        ButtonText: 'Use Previous Version',
                        ButtonName: "link-button",
                        callbackMethod: function () { psaWidget.AddFileReference(attachmentType); }
                    }, {
                        buttonClass: 'ies',
                        ButtonText: 'Cancel',
                        ButtonName: "cancel-button",
                        callbackMethod: null
                    }], 450, null, null);
            } else {
                psaWidget.SelectFile(fileInputId);
            }
        };

        // Method called to add a file reference
        psaWidget.AddFileReference = function (attachmentType) {
            var formData = new FormData();
            formData.append('IsRevisionReference', true);
            formData.append('attachmentType', attachmentType);

            psaWidget.SaveFile(formData, true);
        };

        // Method called to kick off file input selectionm
        psaWidget.SelectFile = function (fileInputId) {
            document.getElementById(fileInputId).click();
        };

        // Method called from the file input to process the selected file
        psaWidget.UploadAttachment = function(e, attachmentType) {
            if (e.files[0] === null) {
                return;
            }

            // Default to a new 'Other' attachment.
            var addStandardAttachment = false;
            var attachId = -1;
            var updateDateLong = '0';

            // If this is one of the standard attachment types.
            if (e.id != 'add-attachment-file') {
                addStandardAttachment = true;
                attachId = $('#fileId-' + attachmentType).val();
                updateDateLong = $('#updateDateLong-' + attachmentType).val().toString();
                $('#uploadButton-' + attachmentType).attr("src", "/Content/images/ajax-loader.gif");
            }

            var validationErrors = psaWidget.ValidateFileTypeAndSize(e);
            if (validationErrors.length === 0) {
                // This is an 'Other' attachment, so hide the Add Attachment button.
                if (!addStandardAttachment) {
                    $('#add-attachment').attr("disabled", "disabled");
                    $('#add-attachment').addClass("display-none");
                    $('#add-attachment-loader').removeClass('display-none');
                    psaWidget.refreshModule();
                }

                var formData = new FormData();
                    formData.append('file', e.files[0]);
                    formData.append('attachmentType', attachmentType);
                    formData.append('id', attachId);
                    formData.append('updateDateLong', updateDateLong);
                    formData.append('IsRevisionReference', 'false');

                psaWidget.SaveFile(formData, addStandardAttachment);
            } else {
                if (addStandardAttachment)
                {
                    $('#uploadButton-' + attachmentType).attr("src", "/Content/images/UploadFile_16x.png");
                }
                GenSession.alertDialog('File Validation', validationErrors.join('<br />'));
            }
            // Clear input after upload so that uploading the same file will still trigger this event
            e.value = '';
        };

        // Saves a new file into the back end. This is the final method in the chain
        psaWidget.SaveFile = function (formData, addStandardAttachment) {
            var psaUploadUrl = GenSession.CreateUrl({
                controller: '@WebConstants.Controller.PSA',
                action: '@WebConstants.Action.UPLOAD_ATTACHMENT',
                id: '@Model.ProposalId'
            });

            $.ajax({
                url: psaUploadUrl,
                data: formData,
                type: 'POST',
                contentType: false,
                processData: false
            })
                .done(function (result) {
                    if (addStandardAttachment === true) {
                        psaWidget.UpdateFields(result);
                    } else {
                        if (result.AttachmentType != null) {
                            psaWidget.refreshPage();
                        } else {
                            GenSession.alertDialog('File Validation', result, psaWidget.refreshPage); // Errors occurred, likely exceeding the maximum file count.
                        }
                    }
                })
                .always(function (attachment) {
                    if (addStandardAttachment === true) {
                        $('#uploadButton-' + attachment.AttachmentType).attr("src", "/Content/images/UploadFile_16x.png");
                    }
                });
        };

        psaWidget.DeleteAttachment = function (attachmentType, idOfExisting) {
            var deleteOtherAttachment = attachmentType == @((int)AttachmentType.Other);

            // The attachment identifier is <AttachmentType> (as an int) for standard attachments.  For 'Other' attachments, it is <AttachmentType>-<AttachmentId>.
            var attachmentIdentifier = attachmentType;
                attachmentIdentifier += deleteOtherAttachment ? '-' + idOfExisting : '';

            GenSession.confirmDialog('Delete Attachment?', 'Are you sure you want to delete this attachment?',
                function () {
                    $('#deleteButton-' + attachmentIdentifier).attr("src", "/Content/images/ajax-loader.gif");
                    var id = $('#fileId-' + attachmentIdentifier).val();
                    if (id < 0) {
                        return;
                    }

                    var url = GenSession.CreateUrl({
                        controller: '@WebConstants.Controller.PSA',
                        action: '@WebConstants.Action.DELETE_ATTACHMENT',
                        id: '@Model.ProposalId'
                    });

                    var formData = new FormData();
                        formData.append('attachmentType', attachmentType);
                        formData.append('id', id);
                        formData.append('updateDateLong', $('#updateDateLong-' + attachmentIdentifier).val().toString());
                        formData.append('IsRevisionReference', $('#IsRevisionReference-' + attachmentIdentifier).val());

                    $.ajax({
                        url: url,
                        data: formData,
                        type: 'POST',
                        contentType: false,
                        processData: false
                    })
                        .done(function (attachment) {
                            if (!deleteOtherAttachment) {
                                psaWidget.UpdateFields(attachment);
                            } else {
                                psaWidget.refreshPage();
                            }
                        })
                        .always(function () {
                            if (!deleteOtherAttachment) {
                                $('#deleteButton-' + attachmentIdentifier).attr("src", "/Content/images/Cancel_16x.png");
                            }
                        });
                });
        };

        $(document).ready(function () {
            setTimeout(function () {
                psaWidget.refreshModule();
            }, 50);
        });
    });
    </script>

<div class="module full composite psa-content" id="psaWidget">
    <div class="module-header-data">
        Attachments
    </div>

    <div class="module-content-data expanded-content" >
        <h3>The following documents are required for upload. PTM will perform a validation check to ensure the documents have been uploaded when the Workflow Approval process is initiated by the Estimator:</h3>
        <br />
        <ul>
            @foreach (AttachmentDto attachment in Model.PostSubmittalAttachments.Where(file => file.AttachmentType != AttachmentType.Other && file.AttachmentType != AttachmentType.DelegationOfAuthority))
            {
                <li>@Html.Raw(attachment.AttachmentType.GetDescription())</li>
            }
        </ul>
        <br />
		<h3>The following document, although not required to initiate the PTM Approval Workflow, shall be either 1.) manually uploaded as soon as it becomes available (when eEPP tool is not utilized for EPP approval) or 2.) PTM will electronically provide a link to the eEPP record used to document approval:</h3>
        <br />
        <ul>
            <li>@Html.Raw(AttachmentType.DelegationOfAuthority.GetDescription())</li>
        </ul>
        <br />
        Note:
        <p>
            If the Responsibility Assignment Matrix is included in your Cost Kick-Off Package, please copy that slide into a file of its own so that it may be separately uploaded and validated.
        </p>
        <p>
            Multiple files needed for a single response must be combined into a single file prior to uploading.
        </p>
        <p>
            Use the <span style="font-weight: bold;">+ Add Other Attachment</span> button to add a new custom attachment.  A maximum of <span style="font-weight: bold;">@Model.MaxOtherFileCount.ToString()</span> of these additional files with the Attachment Type of "Other" are allowed for upload.
        </p>
        @if (ViewBag.IsRevision)
        {
            <p>For revisions: Please replace/add any updated or new documents to support your proposal below.</p>
        }
        <br />
        <h3>Attachments</h3>
        <br />
        @if (Model.PsaVisibility == SecurityAuthorization.CreateReadUpdateDelete && !this.ViewBag.ReadOnly && Model.PostSubmittalAttachments.Count(file => file.AttachmentType == AttachmentType.Other) < Model.MaxOtherFileCount) // Only show the button if the max number of files has not been uploaded.
        {
            <button id="add-attachment" class="ies-action" type="button" onclick="psaWidget.AddAttachment('add-attachment-file', '@((int) AttachmentType.Other)')">+ Add Other Attachment</button>
            <div id="add-attachment-loader" class="loader display-none"></div>
            <input type="file" id="add-attachment-file" onchange="psaWidget.UploadAttachment(this, '@((int) AttachmentType.Other)')" style="display: none;">
            <br />
            <br />
        }
        <table>
            <tr>
                @if (Model.PsaVisibility == SecurityAuthorization.CreateReadUpdateDelete)
                {
                    <th width="35"><span helptext="Remove attachment">Delete</span></th>
                }
                <th width="230">Attachment</th>
                <th width="230"><span helptext="Click file name to download">File Name</span></th>
                @if (Model.PsaVisibility == SecurityAuthorization.CreateReadUpdateDelete)
                {
                    <th width="35"><span helptext="Allowed file types are PDF, PowerPoint, Word, and Excel <br /> Max file size is @(Model.MaxFileSize / 1000000) MB">Upload</span></th>
                }
                <th width="150">Uploaded By</th>
                <th width="135">Uploaded</th>
            </tr>
            @foreach (AttachmentDto attachment in Model.PostSubmittalAttachments)
            {
                // The attachment identifier is <AttachmentType> (as an int) for standard attachments.  For 'Other' attachments, it is <AttachmentType>-<AttachmentId>.
                string attachmentIdentifier = ((int)attachment.AttachmentType).ToString();
                attachmentIdentifier += attachment.AttachmentType == AttachmentType.Other ? "-" + attachment.Id : string.Empty;

                <tr>
                    @if (Model.PsaVisibility == SecurityAuthorization.CreateReadUpdateDelete)
                    {
                        <td style="text-align: center;">
                            <a id="deleteEnabled-@attachmentIdentifier" style="@(attachment.FileHasBeenUploaded && !this.ViewBag.ReadOnly ? "" : "display:none")" onclick="psaWidget.DeleteAttachment('@((int)attachment.AttachmentType)', '@((int)attachment.Id)')">
                                <img id="deleteButton-@attachmentIdentifier" class="enabled" src="~/Content/images/Cancel_16x.png" />
                            </a>
                            <img id="deleteDisabled-@attachmentIdentifier" style="@(attachment.FileHasBeenUploaded || this.ViewBag.ReadOnly ? "display:none" : "")" class="disabled" src="~/Content/images/Cancel_16x.png" />
                        </td>
                    }
                    <td>@Html.Raw(attachment.AttachmentTypeDisplayString)</td>
                    <td>
                        @Html.Hidden("IsRevisionReference-" + attachmentIdentifier, attachment.IsRevisionReference, new { id = "IsRevisionReference-" + attachmentIdentifier })
                        <a id="filenameLink-@attachmentIdentifier" style="@(attachment.FileHasBeenUploaded ? "" : "display:none")" href="/@WebConstants.Controller.PSA/@WebConstants.Action.DOWNLOAD_ATTACHMENT/id/@Model.ProposalId/?fileId=@attachment.Id&isFromeEPP=@attachment.IsAttachmentFromeEPP.ToString()">
                            @(attachment.IsRevisionReference ? @referencePrefix : string.Empty) @attachment.Name
                        </a>
                        <span id="filenameLabel-@attachmentIdentifier" style="@(attachment.FileHasBeenUploaded ? "display:none" : "")">Select File</span>
                    </td>
                    @if (!this.ViewBag.ReadOnly && Model.PsaVisibility == SecurityAuthorization.CreateReadUpdateDelete)
                    {
                        <td style="text-align: center;">
                            @if (attachment.AttachmentType != AttachmentType.Other) // The upload button should not be visible for 'Other' attachments.  These should be added via the Add Attachment button.
                            {
                                <a onclick="psaWidget.AddAttachment('@attachmentIdentifier-file', '@((int) attachment.AttachmentType)')">
                                    <img id="uploadButton-@attachmentIdentifier" src="~/Content/images/UploadFile_16x.png" />
                                </a>
                            }
                            <input type="file" id="@attachmentIdentifier-file" onchange="psaWidget.UploadAttachment(this, '@((int) attachment.AttachmentType)')" style="display: none;">
                            <input id="fileId-@attachmentIdentifier" value="@attachment.Id" type="hidden" />
                            <input id="updateDateLong-@attachmentIdentifier" value="@attachment.UpdateDateLong" type="hidden" />
                        </td>
                    }
                    <td id="uploadedBy-@attachmentIdentifier">@attachment.UploadedBy</td>
                    <td id="updateDate-@attachmentIdentifier" data-utcdate="@(attachment.FileHasBeenUploaded ? attachment.UpdateDate.ToUniversalTime().ToString("s", System.Globalization.CultureInfo.InvariantCulture) : string.Empty)"></td>
                </tr>
            }
        </table>
    </div>
</div>