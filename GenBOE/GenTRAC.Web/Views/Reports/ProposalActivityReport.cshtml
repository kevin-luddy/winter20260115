@{
    ViewBag.Title = "Proposal Activity Report";
    Layout = "~/Views/Shared/HomeLayout.cshtml";
}

<script type="text/javascript">
    var ProposalActivityReportWidget;

    $(function () {

        var widgetConfig = {};
        widgetConfig.ContextID = "proposalActivityReport";
        widgetConfig.IsModule = true;


        var FormConfigs = [];
        FormConfigs.push({
            ElementID: "proposalActivityReportForm", 
            Buttons: [
            {
                ButtonClass: 'ies',
                ButtonText: 'View Report',
                ButtonName: "view-report-button",
                ButtonAction: function (buttonPressed) {
                    ProposalActivityReportWidget.ViewReport(buttonPressed);
                },
                Stateful: false
            }],
            HideOCI: "true"
        });

        widgetConfig.FormConfigs = FormConfigs;

        ProposalActivityReportWidget = new GenWidget(widgetConfig);

        var widgetCounter = 0;
        GenSession.ShowLoadingBox();

        // create the composite widgets
        $.ajax({
            type: 'POST',
            url: GenSession.CreateUrl({
                controller: '@WebConstants.Controller.REPORTS',
                action: '@WebConstants.Action.DISPLAY_PROPOSAL_ACTIVITY_REPORT_PARAMETERS'
            }),
            contentType: 'application/json; charset=utf-8',
            dataType: 'html',
            success: function (response) {
                $('#proposalActivityReportParametersPlaceholder').html(response);
                ProposalActivityReportWidget.ShouldHideLoadingBox();
                ProposalActivityReportWidget.refreshModule();
            },
            error: function () {
                ProposalActivityReportWidget.ShouldHideLoadingBox();
            }
        });

        // Hide the Loading Box after the 1 composite widget has loaded (on success or error)
        ProposalActivityReportWidget.ShouldHideLoadingBox = function () {
            widgetCounter++;
            if (widgetCounter == 1) {
                GenSession.HideLoadingBox();
            }
            
        };

        // returns all of the data from the child widgets.
        ProposalActivityReportWidget.GetData = function () {
            var dataToSave = {};
            dataToSave.reportParameters = ProposalActivityReportParameterWidget.getForm("proposalActivityReportParameterForm").getData();
            return dataToSave;
        };

        ProposalActivityReportWidget.ViewReport = function (buttonPressed) {

            var dataToSend = ProposalActivityReportWidget.GetData();
            dataToSend = JSON.stringify(dataToSend);

            // Make the call
            ProposalActivityReportWidget.saveRequest({
                type: 'POST',
                url: GenSession.CreateUrl({
                    controller: '@WebConstants.Controller.REPORTS',
                    action: '@WebConstants.Action.VIEW_PROPOSAL_ACTIVITY_REPORT'
                }),
                contentType: 'application/json; charset=utf-8',
                data: dataToSend,
                success: function (response) {
                    ProposalActivityReportWidget.CallSSRS(response);
                },
                error: function () {
                    ProposalActivityReportParameterWidget.refreshModule();
                    ProposalActivityReportWidget.refreshModule();
                }
            }, buttonPressed);
        };

        ProposalActivityReportWidget.CallSSRS = function (data) {

            // if the URL hits the IE limit, inform the user. 
            // This is just a precaution so that's why alert.dialog is being used
            if (data.Url.length >= 2083) {
                GenSession.alertdialog('URL Limit Warning', 'If using IE, the url limit is 2083 chars. You have exceeded that which may limit the report results');
            }   
            window.open(data.Url, '_blank', 'resizable=yes, location=yes');
        };

    });
</script>

<div id="proposalActivityReport" class="module full">
    <div class="module-header-data"> Proposal Activity Report</div>
    <div id="proposalActivityReportParametersPlaceholder"> </div>
    <div class ="button-container"></div>

    <div class="module-content-data">
        <div>
            @using (Html.BeginForm("", "", FormMethod.Post, new { id = "proposalActivityReportForm", name = "proposalActivityReportForm" }))
            {
            }
        </div>
    </div>
</div>