@{
    ViewBag.Title = "DFARS Checklist Non-Standard Responses";
    Layout = "~/Views/Shared/HomeLayout.cshtml";
}

<script type="text/javascript">
    var DfarsReportWidget;

    $(function () {
        var widgetConfig = {};
        widgetConfig.ContextID = "dfarsReport";
        widgetConfig.IsModule = true;

        var FormConfigs = [];
        FormConfigs.push({
            ElementID: "dfarsReportForm",
            Buttons: [
                {
                    ButtonClass: 'ies',
                    ButtonText: 'View Report',
                    ButtonName: "view-report-button",
                    ButtonAction: function (buttonPressed) {
                        DfarsReportWidget.ViewReport(buttonPressed);
                    },
                    Stateful: false
                }],
            HideOCI: "true"
        });

        widgetConfig.FormConfigs = FormConfigs;

        DfarsReportWidget = new GenWidget(widgetConfig);

        var widgetCounter = 0;
        GenSession.ShowLoadingBox();
        // create the composite widgets
        $.ajax({
            type: 'POST',
            url: GenSession.CreateUrl({
                controller: '@WebConstants.Controller.REPORTS',
                action: '@WebConstants.Action.DISPLAY_DFARS_REPORT_PARAMETERS'
            }),
            contentType: 'application/json; charset=utf-8',
            dataType: 'html',
            success: function (response) {
                $('#dfarsReportParametersPlaceholder').html(response);
                GenSession.HideLoadingBox();
                DfarsReportWidget.refreshModule();
            },
            error: function () {
                GenSession.HideLoadingBox();
            }
        });

        // returns all of the data from the child widgets.
        DfarsReportWidget.GetData = function () {
            var dataToSave = {};
            dataToSave.reportParameters = DfarsReportParameterWidget.getForm("@GenTRAC.ActionLogic.ReportsControllerLogic.DFARS_REPORT_PARAMETER_FORM").getData();
            return dataToSave;
        };

        DfarsReportWidget.ViewReport = function (buttonPressed) {
            var dataToSend = DfarsReportWidget.GetData();
            dataToSend = JSON.stringify(dataToSend);

            // Make the call
            DfarsReportWidget.saveRequest({
                type: 'POST',
                url: GenSession.CreateUrl({
                    controller: '@WebConstants.Controller.REPORTS',
                    action: '@WebConstants.Action.VIEW_DFARS_REPORT'
                }),
                contentType: 'application/json; charset=utf-8',
                data: dataToSend,
                success: function (response) {
                    DfarsReportWidget.CallSSRS(response);
                },
                error: function () {
                    DfarsReportParameterWidget.refreshModule();
                    DfarsReportWidget.refreshModule();
                }
            }, buttonPressed);
        };

        DfarsReportWidget.CallSSRS = function (data) {
            // if the URL hits the IE limit, inform the user. 
            // This is just a precaution so that's why alert.dialog is being used
            if (data.Url.length >= 2083) {
                GenSession.alertdialog('URL Limit Warning', 'If using IE, the url limit is 2083 chars. You have exceeded that which may limit the report results');
            }   
            window.open(data.Url, '_blank', 'resizable=yes, location=yes');
        };
    });
</script>

<div id="dfarsReport" class="module full">
    <div class="module-header-data">DFARS Checklist Non-Standard Responses</div>
    <div id="dfarsReportParametersPlaceholder"> </div>
    <div class="button-container"></div>

    <div class="module-content-data">
        <div>
            @using (Html.BeginForm("", "", FormMethod.Post, new { id = "dfarsReportForm", name = "dfarsReportForm" }))
            {
            }
        </div>
    </div>
</div>
