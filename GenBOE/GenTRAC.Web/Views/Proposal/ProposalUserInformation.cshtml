@model GenTRAC.ActionLogic.ModelView.Proposals.ProposalUserInformationModelView
@{
    ViewBag.Title = "Proposal User Information";
}

<script type="text/javascript">
    var ProposalUserInfoWidget;
    $(function () {
        var readOnly = @Model.IsReadOnly;

        var UserInfoWidget = {};
        UserInfoWidget.ContextID = "proposalUserInformationSection";
        UserInfoWidget.IsModule = true;
        UserInfoWidget.isReadOnly = readOnly;

        // create user lookup widget (before module creation)
        $('#captureManagerDisplayName').lookupUser({
            accountNameElementId: 'captureManagerNtid',
            accountNameInitial: '@Model.CaptureManagerNtid',
            accountDisplayNameInitial: '@Html.Encode(HttpUtility.JavaScriptStringEncode(Model.CaptureManagerDisplayName))',
            enabled: true,
            allowGroups: true,
            fieldDisplayName: 'Capture Manager',
            checkNameCallbackHandler: function (valid) {
                if (valid) {
                    ProposalIndexWidget.refreshModule();
                }
            }
        });

        $('#costVolumeLeadDisplayName').lookupUser({
            accountNameElementId: 'costVolumeLeadNtid',
            accountNameInitial: '@Model.CostVolumeLeadNtid',
            accountDisplayNameInitial: '@Html.Encode(HttpUtility.JavaScriptStringEncode(Model.CostVolumeLeadDisplayName))',
            enabled: true,
            allowGroups: true,
            fieldDisplayName: 'Cost Volume Lead',
            checkNameCallbackHandler: function (valid) {
                if (valid) {
                    ProposalIndexWidget.refreshModule();
                }
            }
        });

        $('#additionalPricingResource1DisplayName').lookupUser({
            accountNameElementId: 'additionalPricingResource1Ntid',
            accountNameInitial: '@Model.AdditionalPricingResource1NtId',
            accountDisplayNameInitial: '@Html.Encode(HttpUtility.JavaScriptStringEncode(Model.AdditionalPricingResource1DisplayName))',
            enabled: true,
            allowGroups: true,
            fieldDisplayName: 'Additional Estimating Resource 1',
            checkNameCallbackHandler: function (valid) {
                if (valid) {
                    ProposalIndexWidget.refreshModule();
                }
            }
        });

        $('#additionalPricingResource2DisplayName').lookupUser({
            accountNameElementId: 'additionalPricingResource2NtId',
            accountNameInitial: '@Model.AdditionalPricingResource2NtId',
            accountDisplayNameInitial: '@Html.Encode(HttpUtility.JavaScriptStringEncode(Model.AdditionalPricingResource2DisplayName))',
            enabled: true,
            allowGroups: true,
            fieldDisplayName: 'Additional Estimating Resource 2',
            checkNameCallbackHandler: function (valid) {
                if (valid) {
                    ProposalIndexWidget.refreshModule();
                }
            }
        });

        $('#supplyChainPOCMaterialsDisplayName').lookupUser({
            accountNameElementId: 'supplyChainPOCMaterialsNtId',
            accountNameInitial: '@Model.SupplyChainPOCMaterialsNtId',
            accountDisplayNameInitial: '@Html.Encode(HttpUtility.JavaScriptStringEncode(@Model.SupplyChainPOCMaterialsDisplayName))',
            enabled: true,
            allowGroups: true,
            fieldDisplayName: 'Supply Chain POC (Matl)',
            checkNameCallbackHandler: function (valid) {
                if (valid) {
                    ProposalIndexWidget.refreshModule();
                }
            }
        });

		$('#supplyChainPOCMaterialsBackupDisplayName').lookupUser({
			accountNameElementId: 'supplyChainPOCMaterialsBackupNtId',
            accountNameInitial: '@Model.SupplyChainPOCMaterialsBackupNtId',
            accountDisplayNameInitial: '@Html.Encode(HttpUtility.JavaScriptStringEncode(@Model.SupplyChainPOCMaterialsBackupDisplayName))',
            enabled: true,
            allowGroups: true,
			fieldDisplayName: 'Supply Chain POC (Matl Backup)',
            checkNameCallbackHandler: function (valid) {
                if (valid) {
                    ProposalIndexWidget.refreshModule();
                }
            }
        });

        $('#supplyChainPOCSubsDisplayName').lookupUser({
            accountNameElementId: 'supplyChainPOCSubsNtId',
            accountNameInitial: '@Model.SupplyChainPOCSubsNtId',
            accountDisplayNameInitial: '@Html.Encode(HttpUtility.JavaScriptStringEncode(Model.SupplyChainPOCSubsDisplayName))',
            enabled: true,
            allowGroups: true,
            fieldDisplayName: 'Supply Chain POC (Subs)',
            checkNameCallbackHandler: function (valid) {
                if (valid) {
                    ProposalIndexWidget.refreshModule();
                }
            }
		});

		$('#supplyChainPOCSubsBackupDisplayName').lookupUser({
			accountNameElementId: 'supplyChainPOCSubsBackupNtId',
            accountNameInitial: '@Model.SupplyChainPOCSubsBackupNtId',
            accountDisplayNameInitial: '@Html.Encode(HttpUtility.JavaScriptStringEncode(Model.SupplyChainPOCSubsBackupDisplayName))',
            enabled: true,
            allowGroups: true,
			fieldDisplayName: 'Supply Chain POC (Subs Backup)',
            checkNameCallbackHandler: function (valid) {
                if (valid) {
                    ProposalIndexWidget.refreshModule();
                }
            }
        });

        $('#backupPricerDisplayName').lookupUser({
            accountNameElementId: 'backupPricerNtId',
            accountNameInitial: '@Model.BackupPricerNtId',
            accountDisplayNameInitial: '@Html.Encode(HttpUtility.JavaScriptStringEncode(Model.BackupPricerDisplayName))',
            enabled: true,
            allowGroups: true,
            fieldDisplayName: 'Backup Estimator',
            checkNameCallbackHandler: function (valid) {
                if (valid) {
                    ProposalIndexWidget.refreshModule();
                }
            }
        });

        $('#MsacPOCDisplayName').lookupUser({
            accountNameElementId: 'MsacPOCNtid',
            accountNameInitial: '@Model.MsacPOCNtid',
            accountDisplayNameInitial: '@Html.Encode(HttpUtility.JavaScriptStringEncode(Model.MsacPOCDisplayName))',
            enabled: true,
            allowGroups: true,
            fieldDisplayName: 'MSAC POC',
            checkNameCallbackHandler: function (valid) {
                if (valid) {
                    ProposalIndexWidget.refreshModule();
                }
            }
        });

        $('#techLeadDisplayName').lookupUser({
            accountNameElementId: 'techLeadNtId',
            accountNameInitial: '@Model.TechLeadNtid',
            accountDisplayNameInitial: '@Html.Encode(HttpUtility.JavaScriptStringEncode(Model.TechLeadDisplayName))',
            enabled: true,
            allowGroups: true,
            fieldDisplayName: 'Tech Lead',
            checkNameCallbackHandler: function (valid) {
                if (valid) {
                    ProposalIndexWidget.refreshModule();
                }
            }
        });

        $('#proposalMgrDisplayName').lookupUser({
            accountNameElementId: 'proposalMgrNtId',
            accountNameInitial: '@Model.ProposalMgrNtid',
            accountDisplayNameInitial: '@Html.Encode(HttpUtility.JavaScriptStringEncode(Model.ProposalMgrDisplayName))',
            enabled: true,
            allowGroups: true,
            fieldDisplayName: 'Proposal Manager',
            checkNameCallbackHandler: function (valid) {
                if (valid) {
                    ProposalIndexWidget.refreshModule();
                }
            }
        });

        $('#programMgrDisplayName').lookupUser({
            accountNameElementId: 'programMgrNtId',
            accountNameInitial: '@Model.ProgramMgrNtid',
            accountDisplayNameInitial: '@Html.Encode(HttpUtility.JavaScriptStringEncode(Model.ProgramMgrDisplayName))',
            enabled: true,
            allowGroups: true,
            fieldDisplayName: 'Program Manager',
            checkNameCallbackHandler: function (valid) {
                if (valid) {
                    ProposalIndexWidget.refreshModule();
                }
            }
        });

        $('input[type=text]').on("change", function () {
            $(this).addClass('not-placeholder-value');
        });

        $('select[name="AdditionalPricingResource1Type"]').val(@((int)Model.AdditionalPricingResource1Type))
        $('select[name="AdditionalPricingResource2Type"]').val(@((int)Model.AdditionalPricingResource2Type))

        if (readOnly) {
            // hide Check Names and Lookup links
            $(".userlinks").each(function() {
                $(this).hide();
            });

            // hide NTID placeholder
            $('input[placeholder="NTID"]').each(function() {
                $(this).attr('placeholder', '');
            });
        }

        ProposalUserInfoWidget = new GenWidget(UserInfoWidget);

        if (readOnly) {
            @if (Model.AdditionalPricingResource1Type == ResourceType.NotSet)
            {
                <text>
            ProposalUserInfoWidget.getElement('select[name="AdditionalPricingResource1Type"]').next('.replacedWidgetText').html('');
            </text>
            }
            @if (Model.AdditionalPricingResource2Type == ResourceType.NotSet)
            {
                <text>
            ProposalUserInfoWidget.getElement('select[name="AdditionalPricingResource2Type"]').next('.replacedWidgetText').html('');
            </text>
            }
        }
    });
</script>

<div id="proposalUserInformationSection" class="composite module expanded full">
    <div class="module-header-data">User Information</div>
    <div class="module-content-data expanded-content">
        @using (Html.BeginForm("", "", FormMethod.Post, new { id = GenTRAC.ActionLogic.ProposalControllerLogic.PROPOSAL_USER_INFO_FORM, name = GenTRAC.ActionLogic.ProposalControllerLogic.PROPOSAL_USER_INFO_FORM }))
        {
            <a id="users"></a>
            <div class="form-row">
                <div class="form-label">Capture Manager *</div>
                <div class="form-element"></div>
                <div class="form-element">
                    <input id="captureManagerDisplayName" name="captureManagerDisplayName" type="text" class="half" size="50" placeholder="NTID" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-label">Cost Volume Lead *</div>
                <div class="form-element"></div>
                <div class="form-element">
                    <input id="costVolumeLeadDisplayName" name="costVolumeLeadDisplayName" type="text" class="half" size="50" placeholder="NTID" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-label">Additional Estimating Resource 1</div>
                <div class="form-element">
                    @Html.DropDownListFor(model => model.AdditionalPricingResource1Type, Model.AdditionalPricingResourceTypeList, new { name = "AdditionalPricingResource1Type" })
                </div>
                <div class="form-element">
                    <input id="additionalPricingResource1DisplayName" name="additionalPricingResource1DisplayName" type="text" class="half" size="50" placeholder="NTID" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-label">Additional Estimating Resource 2</div>
                <div class="form-element">
                    @Html.DropDownListFor(model => model.AdditionalPricingResource2Type, Model.AdditionalPricingResourceTypeList, new { name = "AdditionalPricingResource2Type" })
                </div>
                <div class="form-element">
                    <input id="additionalPricingResource2DisplayName" name="additionalPricingResource2DisplayName" type="text" class="half" size="50" placeholder="NTID" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-label">Backup Lead Estimator</div>
                <div class="form-element"></div>
                <div class="form-element">
                    <input id="backupPricerDisplayName" name="backupPricerDisplayName" type="text" class="half" size="50" placeholder="NTID" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-label">GenBOE Workspace Creator</div>
                <div class="form-element"></div>
                <div class="form-element">
                    @Html.DropDownListFor(model => model.GenBoeWorkspaceCreatorNtid, Model.GenBoeWorkspaceCreatorList, new { name = "GenBoeWorkspaceCreator", @class = "UserInformationDropDown" })
                </div>
            </div>
            <div class="form-row">
                <div class="form-label">PBOE/MPBOE Preparer</div>
                <div class="form-element"></div>
                <div class="form-element">
                    @Html.DropDownListFor(model => model.SupplyChainPOCMaterialsNtId, Model.SupplyChainPOCMaterialsLeadsList, new { name = "SupplyChainPOCMatl", @class = "UserInformationDropDown" })
                </div>
            </div>
            <div class="form-row">
                <div class="form-label">Backup PBOE/MPBOE Preparer</div>
                <div class="form-element"></div>
                <div class="form-element">
                    @Html.DropDownListFor(model => model.SupplyChainPOCMaterialsBackupNtId, Model.SupplyChainPOCMaterialsBackupLeadsList, new { name = "BackupMaterialLead", @class = "UserInformationDropDown" })
                </div>
            </div>
            <div class="form-row">
                <div class="form-label">IBOE Preparer</div>
                <div class="form-element"></div>
                <div class="form-element">
                    @Html.DropDownListFor(model => model.SupplyChainPOCSubsNtId, Model.SupplyChainPOCSubsLeadsList, new { name = "SupplyChainPOCSubs", @class = "UserInformationDropDown" })
                </div>
            </div>
            <div class="form-row">
                <div class="form-label">Backup IBOE Preparer</div>
                <div class="form-element"></div>
                <div class="form-element">
                    @Html.DropDownListFor(model => model.SupplyChainPOCSubsBackupNtId, Model.SupplyChainPOCSubsBackupLeadsList, new { name = "BackupSubcontractsLead", @class = "UserInformationDropDown" })
                </div>
            </div>
            <div class="form-row">
                <div class="form-label">Contracts Lead *</div>
                <div class="form-element"></div>
                <div class="form-element">
                    @Html.DropDownListFor(model => model.ContractsPOCNtId, Model.ContractLeadList, new { name = "ContractsPoc", @class = "UserInformationDropDown" })
                </div>
            </div>
            <div class="form-row">
                <div class="form-label">Backup Contracts Lead *</div>
                <div class="form-element"></div>
                <div class="form-element">
                    @Html.DropDownListFor(model => model.BackupContractsPOCNtId, Model.BackupContractLeadList, new { name = "BackupContractsPoc", @class = "UserInformationDropDown" })
                </div>
            </div>
            <div class="form-row">
                <div class="form-label"><span helptext="Field is required if LOB is set to National Security Space."> MSAC POC <br /> (Business Development) *</span></div>
                <div class="form-element"></div>
                <div class="form-element">
                    <input id="MsacPOCDisplayName" name="MsacPOCDisplayName" type="text" class="half" size="50" placeholder="NTID" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-label">Tech Lead</div>
                <div class="form-element"></div>
                <div class="form-element">
                    <input id="techLeadDisplayName" name="techLeadDisplayName" type="text" class="half" size="50" placeholder="NTID" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-label">Proposal Mgr *</div>
                <div class="form-element"></div>
                <div class="form-element">
                    <input id="proposalMgrDisplayName" name="proposalMgrDisplayName" type="text" class="half" size="50" placeholder="NTID" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-label"><span helptext="Field is required if LOB is set to National Security Space."> Program Mgr *</span></div>
                <div class="form-element"></div>
                <div class="form-element">
                    <input id="programMgrDisplayName" name="programMgrDisplayName" type="text" class="half" size="50" placeholder="NTID" />
                </div>
            </div>
        }
    </div>
</div>
