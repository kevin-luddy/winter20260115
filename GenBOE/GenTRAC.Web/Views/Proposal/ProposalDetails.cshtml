@model GenTRAC.ActionLogic.ModelView.Proposals.ProposalIndexModelView
@{
    Layout = "~/Views/Shared/HomeLayout.cshtml";
    ViewBag.Title = "Proposal Details";
    string proposalLinkText = string.IsNullOrWhiteSpace(Model.ProposalTrackingNumber) ? Model.ForecastedTrackingNumber : Model.ProposalTrackingNumber;
    string proposalTabsCss = string.IsNullOrWhiteSpace(Model.ProposalTrackingNumber) ? "display: none;" : string.Empty;
    string naHelpText = "Proposal was submitted before Certification Functionality<br/> was introduced into PTM.";
}

    <script type="text/javascript">

    // tabs class will stop float after breadcrumb
    $('div[name=stop_float]').css('clear', 'none');

    var ProposalDetailsWidget = {};

    ProposalDetailsWidget.LoadingHtml = '<div class="module-content-left" style="height: 44px"></div>' +
                        '<div class="module-content-center" style="width: 982px; padding-bottom: 3px;">' +
                            '<div class="module-content-data">' +
                                '<div class="loader" />' +
                             '</div>' +
                        '</div>' +
                        '<div class="module-content-right" style="height: 44px"></div>';

    // Hide tab elements that are associated with standard proposals.
    $(document).on('HIDE_STANDARD_PROPOSAL_FIELDS', function () {
        $('li[data-proposal-type="standard"]').each(function() {
            $(this).hide();
        });

        ProposalDetailsWidget.refreshModule();
    });

    // Show tab elements that are associated with standard proposals.
    $(document).on('SHOW_STANDARD_PROPOSAL_FIELDS', function () {
        $('li[data-proposal-type="standard"]').each(function() {
            $(this).show();
        });

        ProposalDetailsWidget.refreshModule();
    });

    $(function () {
        var DetailWidget = {};
        DetailWidget.ContextID = "proposalsetup-details";
        DetailWidget.IsModule = true;

        ProposalDetailsWidget = new GenWidget(DetailWidget);
        ProposalDetailsWidget.applyHelpPopouts($("#ProposalTabs div.proposalStatusDates"));

        $('#ProposalTabs .tabs a').click(function (event) {
            event.preventDefault();
            ProposalDetailsWidget.href = $(this).attr('href');
            ProposalDetailsWidget.currentLocation = window.location;

            if (GenSession.isDirty()) {
                GenSession.confirmDialog(
                 "Unsaved Changes",
                 "You have selected to leave this tab without saving your current changes.  If you wish to leave the unsaved changes select Yes.  To stay on the page select No.",
                 ProposalDetailsWidget.FinishTabClicked,
                 null);
            } else {
                ProposalDetailsWidget.FinishTabClicked();
            }
        });

        ProposalDetailsWidget.FinishTabClicked = function () {
            // change tabs
            window.location = window.location.protocol + "//" + window.location.host + window.location.pathname + ProposalDetailsWidget.href;
            ProposalDetailsWidget.cleanDirty("proposalInfoForm");
            ProposalDetailsWidget.cleanDirty("proposalGeneralInfoForm");
            ProposalDetailsWidget.cleanDirty("proposalUserInfoForm");
            ProposalDetailsWidget.cleanDirty("checklistGeneralInfoForm");
            ProposalDetailsWidget.cleanDirty("checklistProposalPricingDataForm");
            ProposalDetailsWidget.cleanDirty("checklistPPRDocumentForm");
            ProposalDetailsWidget.cleanDirty("checklistPARDocumentForm");
            ProposalDetailsWidget.cleanDirty("ApprovalForm");
            ProposalDetailsWidget.cleanDirty("certificationTimelineForm");
        };

        ProposalDetailsWidget.RevertLoadTab = function () {
            window.location.hash = ProposalDetailsWidget.currentHash;
        };

        ProposalDetailsWidget.LoadTab = function () {
            if (window.location.hash != ProposalDetailsWidget.currentHash && window.location.hash != '#users') {
                $('div[tab*=Proposal]').hide();
                $('div[tab*=Checklist]').hide();
                $('div[tab*=Approvals]').hide();
                $('div[tab*=PSA]').hide();
                $('div[tab*=CertificationTimeline]').hide();
                $('div[tab*=RevisionHistory]').hide();

                var urlHash = window.location.hash.substring(1).split('/');
                var currentTab = urlHash[0];
                if (currentTab == '') {
                    currentTab = 'Proposal';
                }

                // Load the detail pages if needed.
                if (currentTab == 'Proposal') {
                    var data = {};
                    data.proposalid = @Model.ProposalID;
                    $(document).trigger('LOAD_PROPOSAL_TAB', data);

                }
                else if (currentTab == 'Checklist') {
                    var data = {};
                    $(document).trigger('LOAD_CHECKLIST_TAB', data);
                }
                else if (currentTab == 'Approvals') {
                    var data = {};
                    $(document).trigger('LOAD_APPROVALS_TAB', data);
                }
                else if (currentTab == 'PSA') {
                    var data = {};
                    $(document).trigger('LOAD_PSA_TAB', data);
                }
                else if (currentTab == 'CertificationTimeline') {
                    var data = {};
                    $(document).trigger('LOAD_CERTIFICATION_TIMELINE_TAB', data);
                }
                else if (currentTab == 'RevisionHistory') {
                    var data = {};
                    $(document).trigger('LOAD_REVISION_HISTORY_TAB', data);
                }

                var currentTabDiv = $('div[tab*=' + currentTab + ']');
                $(currentTabDiv).parent().find('li.active').removeClass('active');
                $(currentTabDiv).parent().find('.tabs a[tab*=' + currentTab + ']').parent().addClass('active');
                $(currentTabDiv).show();

                ProposalDetailsWidget.currentHash = window.location.hash;

                $('div[tab*=' + currentTab + '] .module').each(function () {
                    if ($(this).find('.module-header').length == 0) {
                        createModule($(this));
                    }
                    refreshModule(this);
                });

                // if this is a new proposal, do not show the checklist or approvals tabs
                var proposalID =  @Model.ProposalID;
                if (proposalID < 0)
                {
                    $('[tab*=Checklist]').parents("li").addClass('display-none');
                    $('[tab*=Approvals]').parents("li").addClass('display-none');
                }

                if (proposalID < 0 || @Json.Encode(Model.PsaVisibility == SecurityAuthorization.None)) {
                    $('[tab*=PSA]').parents("li").addClass('display-none');
                }

                if (proposalID < 0 || @Json.Encode(Model.CertificationTimelineVisibility == SecurityAuthorization.None)) {
                    $('[tab*=CertificationTimeline]').parents("li").addClass('display-none');
                }

                if (proposalID < 0 || @Json.Encode(Model.RevisionHistoryVisibility == SecurityAuthorization.None)) {
                    $('[tab*=RevisionHistory]').parents("li").addClass('display-none');
                }
            }
        };

        ProposalDetailsWidget.AddNewRevision = function () {
            var url = GenSession.CreateUrl({
                controller: '@WebConstants.Controller.PROPOSAL',
                action: '@WebConstants.Action.VALIDATE_PROPOSAL_REVISION_DETAILS',
                id:  '@Model.ProposalID'
            });

            $.ajax({
                type: "POST",
                url: url,
                contentType: 'application/json; charset=utf-8',
                success: function () {
                    var newRevisionUrl = GenSession.CreateUrl({
                        controller: '@WebConstants.Controller.PROPOSAL',
                        action: '@WebConstants.Action.DISPLAY_PROPOSAL_REVISION_DETAILS',
                        id:  '@Model.ProposalID'
                    });
                    window.location = newRevisionUrl;
                },
                error: function (response) {
                    var errorMessages = JSON.parse(response.responseText).MessageList
                    var errorList = [];
                    if (errorMessages.length != 0) {
                        errorMessages.forEach(function (message) {
                            errorList.push(message.ValidationIssue);
                        });
                    }
                    GenSession.alertDialog('New Revision Creation Failed', errorList.join('<br/>'));
                }
            });
        };

        ProposalDetailsWidget.RevertRevision = function () {
            var url = GenSession.CreateUrl({
                controller: '@WebConstants.Controller.PROPOSAL',
                action: '@WebConstants.Action.REVERT_PROPOSAL_TO_PRIOR_VERSION',
                id:  '@Model.ProposalID'
            });

            $.ajax({
                type: "POST",
                url: url,
                contentType: 'application/json; charset=utf-8',
                success: function (response) {
                    window.location = GenSession.CreateUrl({
                        controller: '@WebConstants.Controller.PROPOSAL',
                        action: '@WebConstants.Action.DISPLAY_PROPOSAL_DETAILS',
                        id: response.proposalId
                    });
                },
                error: function (response) {
                    var errorMessages = JSON.parse(response.responseText).MessageList
                    var errorList = [];
                    if (errorMessages.length != 0) {
                        errorMessages.forEach(function (message) {
                            errorList.push(message.ValidationIssue);
                        });
                    }
                    GenSession.alertDialog('Reverting Revision Failed', errorList.join('<br/>'));
                }
            });
        };

        window.onhashchange = ProposalDetailsWidget.LoadTab;
        ProposalDetailsWidget.on('LOAD_PROPOSAL_TAB', function (e, params) {
            var proposalID = params.proposalid;

            if (proposalID == null)
            {
                proposalID = -1;
            }

            var oldProposalId = params.oldProposalId;
            if (oldProposalId == null) {
                oldProposalId = -1;
            }

            var isNewRevision = params.isNewRevision;
            if (isNewRevision == null) {
                isNewRevision = false;
            }

            $("div[tab*=Proposal] .proposal-details").children().remove();
            $("div[tab*=Proposal] .proposal-details").html(ProposalDetailsWidget.LoadingHtml);
            $("div[tab*=Proposal] .proposal-details").removeClass("display-none");
            var proposalURL = "";
            if (proposalID < 0) {
                proposalURL =  GenSession.CreateUrl({
                    controller: '@WebConstants.Controller.PROPOSAL',
                    action: '@WebConstants.Action.DISPLAY_PROPOSAL_INDEX'
                });
            }
            else {
                proposalURL = GenSession.CreateUrl({
                    controller: '@WebConstants.Controller.PROPOSAL',
                    action: '@WebConstants.Action.DISPLAY_PROPOSAL_INDEX',
                    id: JSON.stringify(proposalID)
                });
            }

            var data = {};
            data.isNewRevision = '@Model.IsNewRevision';
            data.oldProposalId = '@Model.RevisedProposalId';

            $.ajax({
                type: "POST",
                url: proposalURL,
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(data),
                success: function (response) {
                    $('div[tab*=Proposal] .proposal-details').html(response);

                }
            });

        });

        ProposalDetailsWidget.on('LOAD_CHECKLIST_TAB', function (e, params) {

            $("div[tab*=Checklist] .checklist-details").children().remove();
            $("div[tab*=Checklist] .checklist-details").html(ProposalDetailsWidget.LoadingHtml);
            $("div[tab*=Checklist] .checklist-details").removeClass("display-none");
            var checklistURL =  GenSession.CreateUrl({
                controller: '@WebConstants.Controller.CHECKLIST',
                action: '@WebConstants.Action.DISPLAY_CHECKLIST_INDEX',
                id: '@Model.ProposalID'
            });

            var data = {};

            $.ajax({
                type: "POST",
                url: checklistURL,
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(data),
                success: function (response) {
                    $('div[tab*=Checklist] .checklist-details').html(response);

                }
            });

        });

        ProposalDetailsWidget.on('LOAD_APPROVALS_TAB', function (e, params) {

            $("div[tab*=Approvals] .approvals-details").children().remove();
            $("div[tab*=Approvals] .approvals-details").html(ProposalDetailsWidget.LoadingHtml);
            $("div[tab*=Approvals] .approvals-details").removeClass("display-none");
            var approvalsURL =  GenSession.CreateUrl({
                controller: '@WebConstants.Controller.APPROVALS',
                action: '@WebConstants.Action.DISPLAY_APPROVALS_INDEX',
                id:  '@Model.ProposalID'
            });

            var data = {};

            $.ajax({
                type: "POST",
                url: approvalsURL,
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(data),
                success: function (response) {
                    $('div[tab*=Approvals] .approvals-details').html(response);

                }
            });

        });

        ProposalDetailsWidget.on('LOAD_PSA_TAB', function (e, params) {
            $("div[tab*=PSA] .psa-details").children().remove();
            $("div[tab*=PSA] .psa-details").html(ProposalDetailsWidget.LoadingHtml);
            $("div[tab*=PSA] .psa-details").removeClass("display-none");
            var psaUrl =  GenSession.CreateUrl({
                controller: '@WebConstants.Controller.PSA',
                action: '@WebConstants.Action.DISPLAY_POST_SUBMITTAL_ATTACHMENTS',
                id: '@Model.ProposalID'
            });

            var data = {psaVisibility: '@Model.PsaVisibility'};

            $.ajax({
                type: "POST",
                url: psaUrl,
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(data),
                success: function (response) {
                    $('div[tab*=PSA] .psa-details').html(response);

                }
            });

        });

        ProposalDetailsWidget.on('LOAD_CERTIFICATION_TIMELINE_TAB', function (e, params) {
            $("div[tab*=CertificationTimeline] .ct-details").children().remove();
            $("div[tab*=CertificationTimeline] .ct-details").html(ProposalDetailsWidget.LoadingHtml);
            $("div[tab*=CertificationTimeline] .ct-details").removeClass("display-none");
            var psaUrl =  GenSession.CreateUrl({
                controller: '@WebConstants.Controller.CERTIFICATION_TIMELINE',
                action: '@WebConstants.Action.DISPLAY_CERTIFICATION_TIMELINE',
                id: '@Model.ProposalID'
            });

            $.ajax({
                type: "POST",
                url: psaUrl,
                contentType: 'application/json; charset=utf-8',
                success: function (response) {
                    $('div[tab*=CertificationTimeline] .ct-details').html(response);

                }
            });

        });

        ProposalDetailsWidget.on('LOAD_REVISION_HISTORY_TAB', function (e, params) {
            $("div[tab*=RevisionHistory] .revision-history").children().remove();
            $("div[tab*=RevisionHistory] .revision-history").html(ProposalDetailsWidget.LoadingHtml);
            $("div[tab*=RevisionHistory] .revision-history").removeClass("display-none");
            var psaUrl =  GenSession.CreateUrl({
                controller: '@WebConstants.Controller.PROPOSAL',
                action: '@WebConstants.Action.DISPLAY_REVISION_HISTORY',
                id: '@Model.ProposalID'
            });

            $.ajax({
                type: "POST",
                url: psaUrl,
                contentType: 'application/json; charset=utf-8',
                success: function (response) {
                    $('div[tab*=RevisionHistory] .revision-history').html(response);

                }
            });
        });

        if ('@(Model.ProposalStatus == ProposalStatus.Revised || Model.ReasonCertificationNotRequired.HasValue || (Model.ProposalStatus == ProposalStatus.Completed && Model.CertificationCompletedDate != null))' == 'True') {
            $('button[name="new-revision-button"]').addClass('disabled');
        }

        if ('@(Model.ProposalStatus == ProposalStatus.Completed || Model.ProposalStatus == ProposalStatus.Submitted)' == 'True') {
            $('button[name="revert-revision-button"]').addClass('disabled');
        }

        if ('@(Model.HasRdsbDocument || Model.GenBoeWorkspaces.Any())' == 'True') {
            $('button[name="revert-revision-button"]').addClass('hasDocumentOrWorkspace');
        }

        // Adjust margins for revision buttons
        if ('@(Model.DisplayRevertRevisionButton)' == 'True') {
            $('#revisionButtons').removeClass('newRevisionButtonMargin');
            if ('@(!Model.DisplayNewRevisionButton)' == 'True') {
                $('#revisionButtons').addClass('revertRevisionMargin');
            }
        }

        $('button[name="new-revision-button"]:not(.disabled)').click(function () {
            GenSession.confirmDialog(
                 "Confirm new Revision",
                 "<div style='text-align: left'>Proposal Revision shall only be created for one of the following reasons:<ol><li>A revised RFP is issued</li><li>Customer direction requires a resubmittal</li><li>Customer directs LM to submit an FPR</li><li>Anytime a new Cover Sheet is required (for CCOPD)</li></ol>Would you like to continue?</div>",
                 ProposalDetailsWidget.AddNewRevision,
                 null);
        });

        $('button[name="revert-revision-button"]:not(.disabled,.hasDocumentOrWorkspace)').click(function () {
            GenSession.confirmDialog(
                 "Confirm revert to prior version",
                 "Reverting to the prior version of this Proposal will delete this Proposal and all of its contents. <strong>This cannot be undone.</strong> Are you sure you would like to continue?",
                 ProposalDetailsWidget.RevertRevision,
                 null);
        });

        $('button[name="revert-revision-button"].hasDocumentOrWorkspace:not(.disabled)').click(function () {
            var alertText = "<div style='text-align: left'><p>You may not revert this PTM Record to the previous version until the following genBOE Workspace(s) and/or RDSB Document associated with this PTM Record have been deleted. Please contact the System Administrator for assistance if you would like to retain the genBOE Workspace(s).</p><br><p><ul>";

            if ('@Model.HasRdsbDocument' == 'True') {
                var rdsbUrl = "@IES.Common.ConfigurationUtilities.GetAppSetting("RDSBUrl")" + "Document/Edit/" + @Model.ProposalID;
                alertText += "<li><a href='" + rdsbUrl + "' target='_blank'>RDSB Document</a></li>";
            }

            @foreach(string workspace in Model.GenBoeWorkspaces)
            {
                <text>
                    var boeUrl = "@IES.Common.ConfigurationUtilities.GetAppSetting("BOEUrl")" + "@workspace";
                    alertText += "<li><a href='" + boeUrl + "' target='_blank'>" + "@workspace" + "</a></li>";
                </text>
            }

            alertText += "</ul></p></div>"
            GenSession.alertDialog("Proposal cannot be reverted", alertText);
        });

        ProposalDetailsWidget.LoadTab();
    });
    </script>

<div class="proposalsetup-details module full">
    <div id="ProposalTabs">
        <div class="breadcrumb">
            @Html.RouteLink("Proposals", WebConstants.Route.Name.HOME, new { action = WebConstants.Action.HOME_DISPLAY_GENTRAC_HOME, controller = WebConstants.Controller.HOME })
            @if (Model.ProposalID < 0 && !Model.IsNewRevision)
            {
                <text>
                    > New Proposal
                </text>
            }
            else if (Model.IsNewRevision)
            {
                <text>
                    > New Revision
                </text>
            }
            else
            {
                <text>
                    > @proposalLinkText
                </text>
            }
        </div>
        <div class="tabs">
            <div class="tabs-left"></div>
            <div class="tabs-center" style="width: 976px">
                <div class="proposal-text" style="text-align:left;padding:5px;">
                    @if (Model.ProposalID < 0 && !Model.IsNewRevision)
                    {
                        <text>
                            <div style="color: #FFFFFF">New Proposal</div>
                        </text>
                    }
                    else if (Model.IsNewRevision)
                    {
                        <text>
                            <div style="color: #FFFFFF">New Revision for @Model.RevisedProposalTitle</div>
                        </text>
                    }
                    else
                    {
                        <text>
                            <div class="proposalTitle">@proposalLinkText - @Model.ProposalTitle</div>
                            <div class="proposalStatusDates">
                                <p style="padding-bottom: 2px;">
                                    @Model.WorkflowStatusLineText
                                <p>
                                    @Model.CertificationCompletedLineText
                                </p>
                            </div>
                        </text>
                    }
                </div>
                <div id="revisionButtons" class="newRevisionButtonMargin">
                    @if (Model.DisplayNewRevisionButton)
                    {
                        <button name="new-revision-button" type="button" class="ies stateful_button">+ New Revision</button>
                    }
                    @if (Model.DisplayRevertRevisionButton)
                    {
                        <button name="revert-revision-button" type="button" class="ies stateful_button">Revert to Prior Version</button>
                    }
                </div>
                    <ul class="inline-block proposalTabMenu">
                        <li class="active"><div class="tab-left"></div><a href="#Proposal" tab="Proposal">Proposal Setup</a><div class="tab-right"></div></li>
                        <li data-proposal-type="standard" style="@proposalTabsCss"><div class="tab-left"></div><a href="#Checklist" tab="Checklist">Checklist</a><div class="tab-right"></div></li>
                        <li data-proposal-type="standard" style="@proposalTabsCss"><div class="tab-left"></div><a href="#PSA" tab="PSA">Post Submittal Attachments</a><div class="tab-right"></div></li>
                        <li data-proposal-type="standard" style="@proposalTabsCss"><div class="tab-left"></div><a href="#Approvals" tab="Approvals">Approvals</a><div class="tab-right"></div></li>
                        <li data-proposal-type="standard" style="@proposalTabsCss"><div class="tab-left"></div><a href="#CertificationTimeline" tab="CertificationTimeline">Certification Timeline</a><div class="tab-right"></div></li>
                    </ul>
                </div>
            <div class="tabs-right"></div>
        </div>
    </div>
    <div tab="Proposal">
        <div class="proposal-details"></div>
    </div>
    <div tab="Checklist">
        <div class="checklist-details"></div>
    </div>
    <div tab="PSA">
        <div class="psa-details"></div>
    </div>
    <div tab="Approvals">
        <div class="approvals-details"></div>
    </div>
    <div tab="CertificationTimeline">
        <div class="ct-details"></div>
    </div>
    <div tab="RevisionHistory">
        <div class="revision-history"></div>
    </div>
</div>
