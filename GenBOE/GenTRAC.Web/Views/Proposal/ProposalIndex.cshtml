@model GenTRAC.ActionLogic.ModelView.Proposals.ProposalIndexModelView

@{
    ViewBag.Title = "Proposal Index";
}

    <script type="text/javascript">
    var ProposalIndexWidget;

		$(function () {
			var readOnly = @Model.IsReadOnly;
			var ProposalIdWhenPageRendered = @Model.ProposalID;
			var ExistingProposal = ProposalIdWhenPageRendered != null;
			var widgetConfig = {};
			widgetConfig.ContextID = "newProposal";
			widgetConfig.IsModule = true;
			widgetConfig.isReadOnly = readOnly;
			var originalBoeTool = 0;
			var originalPricingTool = 0;

			// If this is an existing proposal, prompt the user before changing to 'Forecasted'.  For new proposals, allow the change.
			$(document).on('CHANGE_PROPOSAL_CLASS', function (event, cancelCallback) {
				if (ExistingProposal) {
					GenSession.confirmDialog(
						"Warning - Change to Forecasted with Potential Data Loss",
						"By changing the Proposal Class to 'Forecasted', existing data you have entered for fields that do not pertain to forecasted proposals will be lost.  If you wish to continue anyway, select 'Yes'.  To retain the existing Proposal Class and data, select 'No'.",
						function () { $(document).trigger('HIDE_STANDARD_PROPOSAL_FIELDS'); },
						function () { cancelCallback(); });
				}
				else {
					$(document).trigger('HIDE_STANDARD_PROPOSAL_FIELDS');
				}
			});

			// Hide field elements that are associated with standard proposals and clear their values.
			$(document).on('HIDE_STANDARD_PROPOSAL_FIELDS', function () {
				$('div[data-proposal-type="standard"]').each(function () {
					// Clear textboxes.
					if ($(this).find('.form-element input[type="text"]:first-child')) {
						$(this).find('.form-element input[type="text"]:first-child').val('');
					}

					// Clear textareas.
					if ($(this).find('.form-element textarea:first-child')) {
						$(this).find('.form-element textarea:first-child').val('');
					}

					// Clear dropdowns and listboxes.
					if ($(this).find('.form-element select:first-child')) {
						$(this).find('.form-element select:first-child').val('');
					}

					// Clear radio buttons.
					if ($(this).find('.form-element input[type="radio"]')) {
						$(this).find('.form-element input[type="radio"]').removeAttr('checked');
					}

					// Clear hidden fields (for User Information NTIDs).
					if ($(this).find('.form-element input[type="hidden"][placeholder="NTID"]')) {
						$(this).find('.form-element input[type="hidden"][placeholder="NTID"]').val('');
					}

					// Hide the field.
					$(this).hide();
				});

				ProposalIndexWidget.refreshModule();
			});

			// Show field elements that are associated with standard proposals.
			$(document).on('SHOW_STANDARD_PROPOSAL_FIELDS', function () {
				$('div[data-proposal-type="standard"]').each(function () {
					$(this).show();
				});

				ProposalIndexWidget.refreshModule();
			});

			var FormConfigs = [];
			FormConfigs.push({
				ElementID: "proposalForm",
				Buttons: [
					{
						ButtonClass: 'ies-action',
						ButtonText: 'Save',
						ButtonName: "save-button",
						ButtonAction: function (buttonPressed) {
							ProposalIndexWidget.ValidateAndSaveFullPage(buttonPressed);
						},
						Stateful: true
					},
					{
						ButtonClass: 'ies',
						ButtonText: 'Cancel',
						ButtonName: "cancel-button",
						ButtonAction: function (buttonPressed) {
							if (GenSession.isDirty()) {
								GenSession.confirmDialog(
									"Unsaved Changes",
									"You have selected to leave this tab without saving your current changes.  If you wish to leave the unsaved changes select Yes.  To stay on the page select No.",
									ProposalIndexWidget.RedirectHomeDirty,
									null);
							} else {
								ProposalIndexWidget.RedirectHome();
							}
						}
					}],
				ContainsOCI: "true",
				IsClassEnvironment: isClassEnvironment
			});

			widgetConfig.FormConfigs = FormConfigs;

			ProposalIndexWidget = new GenWidget(widgetConfig);

			var widgetCounter = 0;
            GenSession.ShowLoadingBox();

            data = {};
            data.isnewrevision = '@Model.IsNewRevision';
            var proposalId = '@Model.ProposalID';
            
            @if (Model.IsNewRevision)
            {
                <text>
                    proposalId = @Model.RevisedProposalId;
                </text>
            }

			// create the composite widgets
			$.ajax({
                type: 'POST',
				url: GenSession.CreateUrl({
                    controller: '@WebConstants.Controller.PROPOSAL',
					action: '@WebConstants.Action.DISPLAY_PROPOSAL_INFORMATION',
					id: proposalId
                }),
				contentType: 'application/json; charset=utf-8',
                dataType: 'html',
                data: JSON.stringify(data),
				success: function (response) {
					$('#proposalInfoDataPlaceholder').html(response);
                    ProposalIndexWidget.ShouldHideLoadingBox();
                    ProposalIndexWidget.refreshModule();
                },
				error: function () {
                    ProposalIndexWidget.ShouldHideLoadingBox();
                }
            });

			$.ajax({
				type: 'POST',
				url: GenSession.CreateUrl({
					controller: '@WebConstants.Controller.PROPOSAL',
					action: '@WebConstants.Action.DISPLAY_PROPOSAL_GENERAL_INFORMATION',
					id: proposalId
				}),
				contentType: 'application/json; charset=utf-8',
				dataType: 'html',
                data: JSON.stringify(data),
				success: function (response) {
					$('#proposalGeneralInfoDataPlaceholder').html(response);
					ProposalIndexWidget.ShouldHideLoadingBox();
					ProposalIndexWidget.refreshModule();
					originalBoeTool = $('select[name="BOETool"]').val();
					originalPricingTool = $('select[name="PricingTool"]').val();
				},
				error: function () {
					ProposalIndexWidget.ShouldHideLoadingBox();
				}
			});

			$.ajax({
				type: 'POST',
				url: GenSession.CreateUrl({
					controller: '@WebConstants.Controller.PROPOSAL',
					action: '@WebConstants.Action.DISPLAY_PROPOSAL_APPROVALS',
					id: proposalId
				}),
				contentType: 'application/json; charset=utf-8',
				dataType: 'html',
                data: JSON.stringify(data),
				success: function (response) {
					$('#proposalApprovalsPlaceholder').html(response);
					ProposalIndexWidget.ShouldHideLoadingBox();
					ProposalIndexWidget.refreshModule();
				},
				error: function () {
					ProposalIndexWidget.ShouldHideLoadingBox();
				}
			});

			$.ajax({
				type: 'POST',
				url: GenSession.CreateUrl({
					controller: '@WebConstants.Controller.PROPOSAL',
					action: '@WebConstants.Action.DISPLAY_PROPOSAL_USER_INFORMATION',
					id: proposalId
				}),
				contentType: 'application/json; charset=utf-8',
				dataType: 'html',
				success: function (response) {
					$('#proposalUserInfoDataPlaceholder').html(response);
					ProposalIndexWidget.ShouldHideLoadingBox();
					ProposalIndexWidget.refreshModule();
				},
				error: function () {
					ProposalIndexWidget.ShouldHideLoadingBox();
				}
			});

			// override refreshModule
			ProposalIndexWidget.originalRefreshModule = ProposalIndexWidget.refreshModule;

			// Hide the Loading Box after all 4 composite widgets have loaded (on success or error)
			ProposalIndexWidget.ShouldHideLoadingBox = function () {
				widgetCounter++;
				if (widgetCounter == 4) {
                @if (!((bool)Model.IsUsUser) && (Model.ProposalID == -1))
                {
                    <text>
					ITCOConfirmationDialog(function (result) {
						if (!result) {
							// If 'Cancel' was selected return to home page.
							ProposalIndexWidget.RedirectHome();
						}
					});
                    </text>
                }
					GenSession.HideLoadingBox();
					ProposalInfoWidget.HideUnneededFields();
					ProposalIndexWidget.cleanAllDirtyForms();
				}
			};

			// Cleans all the dirty forms
			ProposalIndexWidget.cleanAllDirtyForms = function () {
				ProposalIndexWidget.cleanDirty();
				ProposalInfoWidget.cleanDirty();
				ProposalGeneralInformationWidget.cleanDirty();
				ProposalApprovalsWidget.cleanDirty();
				ProposalUserInfoWidget.cleanDirty();
			}

			// Cleans all the dirty forms then redirects home
			ProposalIndexWidget.RedirectHomeDirty = function () {
				ProposalIndexWidget.cleanAllDirtyForms();
				ProposalIndexWidget.RedirectHome();
			};

			ProposalIndexWidget.refreshModule = function () {
				if (typeof (ProposalInfoWidget) != 'undefined') {
					ProposalInfoWidget.refreshModule();
				}
				if (typeof (ProposalGeneralInformationWidget) != 'undefined') {
					ProposalGeneralInformationWidget.refreshModule();
				}
				if (typeof (ProposalApprovalsWidget) != 'undefined') {
					ProposalApprovalsWidget.refreshModule();
				}
				if (typeof (ProposalUserInfoWidget) != 'undefined') {
					ProposalUserInfoWidget.refreshModule();
				}
				if (typeof (GoToProposalWidget) != 'undefined') {
					GoToProposalWidget.refreshModule();
				}

				ProposalIndexWidget.originalRefreshModule();
			};

			// returns all of the data from the child widgets.
			ProposalIndexWidget.GetData = function () {
				var dataToSave = {};
                dataToSave.proposalId = @(Model.IsNewRevision ? Model.RevisedProposalId : Model.ProposalID); 
				dataToSave.ProposalInfo = ProposalInfoWidget.getForm("proposalInfoForm").getData();
				dataToSave.ProposalInfo.ProposalClassText = $('#ProposalClass option:selected').text();
				dataToSave.ProposalGeneralInfo = ProposalGeneralInformationWidget.getForm("proposalGeneralInfoForm").getData();
				dataToSave.ProposalApprovalsInfo = ProposalApprovalsWidget.getForm("proposalApprovalsForm").getData();
                dataToSave.ProposalUserInfo = ProposalUserInfoWidget.getForm("proposalUserInfoForm").getData();
                dataToSave.RevisionOfId = '@Model.RevisedProposalId';
                dataToSave.IsNewRevision = '@Model.IsNewRevision';
				return dataToSave;
			};

			ProposalIndexWidget.ValidateAndSaveFullPage = function (buttonPressed) {
				var dataToSend = ProposalIndexWidget.GetData();

				var boeToolToSave = dataToSend.ProposalGeneralInfo.BOETool;
				var pricingToolToSave = dataToSend.ProposalGeneralInfo.PricingTool;
				var preferredBoeTool = '@((int)BOETool.genBOE)';
				var preferredPricingTool = '@((int)PricingTool.ProPricer)';
				var isForecasted = $('select[name="ProposalClass"] option:selected').text() === '@Constants.PROPOSAL_CLASS_FORECASTED';

            // Popup should show if they select a non-preferred tool (non-forecasted proposals only), but not if they've already been shown it for that selection
            // Also shouldn't show if they select no tool so that validation still happens
            if (!isForecasted && ((boeToolToSave != preferredBoeTool && boeToolToSave != originalBoeTool && boeToolToSave != 0) || (pricingToolToSave != preferredPricingTool && pricingToolToSave != originalPricingTool && pricingToolToSave != 0))) {
                GenSession.confirmDialog(
                    "Non-Preferred BOE/Pricing Tool",
                    "You've selected a BOE and/or Pricing Tool other than the Space preferred tool. Please ensure that you have received advance approval from your LOB Estimating Manager/Delegate. Would you like to continue?",
                    function () { ProposalIndexWidget.ContinueValidateAndSaveFullPage(buttonPressed, dataToSend); },
                    null
                );
            } else {
                ProposalIndexWidget.ContinueValidateAndSaveFullPage(buttonPressed, dataToSend);
            }      
        };

        ProposalIndexWidget.ContinueValidateAndSaveFullPage = function (buttonPressed, dataToSend) {
            dataToSend = JSON.stringify(dataToSend);
            
            // Validate the proposal information.
            ProposalIndexWidget.saveRequest({
                type: 'POST',
                url: GenSession.CreateUrl({
                    controller: '@WebConstants.Controller.PROPOSAL',
                    action: '@WebConstants.Action.VALIDATE_PROPOSAL_INFORMATION'
                }),
                contentType: 'application/json; charset=utf-8',
                data: dataToSend,
                //Don't clear dirty bit on success since no data is saved on validation
                performDirtyProcessing: false,
                success: function (response) {
                    // Check user access
                    if ($('#ProposalClass option:selected').text() === '@Constants.PROPOSAL_CLASS_FORECASTED') {
                        if (response.activeUserNtid !== $('#LOBEstimatingLeadMgrNtid').val()) {
                            ProposalIndexWidget.displayForecastProposalAccessWarningDialog(buttonPressed, response.activeUserNtid, $('#LOBEstimatingLeadMgrNtid option:selected').text())
                        } else {
                            // save the proposal
                            ProposalIndexWidget.SaveFullPage(buttonPressed);
                        }
                    } else {
                        if (response.activeUserNtid !== response.leadEstimatorNtid && response.activeUserNtid !== response.backupPricerNtId) {
                            // display Proposal Access Warning dialog
                            ProposalIndexWidget.displayProposalAccessWarningDialog(buttonPressed, response.activeUserNtid, response.backupPricerNtId, response.backupPricerDisplayName);
                        } else {
                            // save the proposal
                            ProposalIndexWidget.SaveFullPage(buttonPressed);
                        }
                    }
                },
                error: function () {
                    ProposalIndexWidget.refreshModule();
                }
            }, buttonPressed);
        };

        /*
         * Display a warning for the user letting them know they won't have access to the proposal after it is saved.
         * Give them the options to:
         *  a) Return back to edit so they can adjust the roles,
         *  b) Continue with the save "as is", knowing they will not be able to access the proposal once saved, or
         *  c) Set themselves as the backup lead estimator and then save the proposal.
         */
        ProposalIndexWidget.displayProposalAccessWarningDialog = function(buttonPressed, activeUserNtid, backupPricerNtId, backupPricerDisplayName) {
            // Note: This method is only called if the backup lead estimator (backupPricerNtId) is set to another user or empty.
            var bodyText;
            if (backupPricerNtId && activeUserNtid !== backupPricerNtId) {
                // Backup lead estimator is currently assigned to another user.
                bodyText = "You’ve assigned someone other than yourself as the Lead Estimator. As a result you will no longer have access to the proposal once it has been saved.<br />Would you like to: return to edit, continue with save as is, or replace Backup Lead Estimator (" + backupPricerDisplayName + ") with yourself?";
            } else {
                // Backup lead estimator is currently empty.
                bodyText = "You’ve assigned someone other than yourself as the Lead Estimator. As a result you will no longer have access to the proposal once it has been saved.<br />Would you like to: return to edit, continue with save as is, or make yourself Backup Lead Estimator?";
            }

            GenSession.commonDialog("Proposal Access Warning", bodyText,
                [
                {
                    buttonClass : "ies",
                    ButtonText : "Return to Edit",
                    ButtonName : "cancel-button",
                },
                {
                    buttonClass : "ies",
                    ButtonText : "Continue with Save",
                    ButtonName : "continue-button",
                    callbackMethod : function () {
                        // save the proposal "as is" even though user won't have access
                        ProposalIndexWidget.SaveFullPage(buttonPressed, true);  // return to home page after save since user won't have access to proposal page
                    }
                },
                {
                    buttonClass : "ies",
                    ButtonText : "Save me as Backup LE",
                    ButtonName : "save-backup-pricer-button",
                    callbackMethod : function () {
                        // set backup lead estimator = active user
                        $('#backupPricerNtId').val(activeUserNtid);
                        $('#backupPricerDisplayName').val('');

                        // save the proposal
                        ProposalIndexWidget.SaveFullPage(buttonPressed);
                    }
                }], 900);
        };

        /*
         * Display a warning for the user letting them know they won't have access to the proposal after it is saved.
         * Give them the options to:
         *  a) Return back to edit so they can adjust the roles,
         *  b) Continue with the save "as is", knowing they will not be able to access the proposal once saved, or
         *  c) Set themselves as the LOB Estimating Lead/Mgr and then save the proposal.
         */
        ProposalIndexWidget.displayForecastProposalAccessWarningDialog = function(buttonPressed, activeUserNtid, lobEstimatingLeadDisplayName) {
            // Note: This method is only called for forecasted proposals if the LOB Estimating Lead is set to another user.
            var bodyText = "You’ve assigned someone other than yourself as the LOB Estimating Lead/Manager. As a result you will no longer have access to the proposal once it has been saved.<br />Would you like to: return to edit, continue with save as is, or replace LOB Estimating Lead/Manager (" + lobEstimatingLeadDisplayName + ") with yourself?";

            GenSession.commonDialog("Proposal Access Warning", bodyText,
                [
                {
                    buttonClass : "ies",
                    ButtonText : "Return to Edit",
                    ButtonName : "cancel-button",
                },
                {
                    buttonClass : "ies",
                    ButtonText : "Continue with Save",
                    ButtonName : "continue-button",
                    callbackMethod : function () {
                        // save the proposal "as is" even though user won't have access
                        ProposalIndexWidget.SaveFullPage(buttonPressed, true);  // return to home page after save since user won't have access to proposal page
                    }
                },
                {
                    buttonClass : "ies",
                    ButtonText : "Save me as LOB Estimating Lead/Manager",
                    ButtonName : "save-backup-pricer-button",
                    callbackMethod : function () {
                        // set LOB Estimating Lead/Mgr = active user
                        $('#LOBEstimatingLeadMgrNtid').val(activeUserNtid);

                        // save the proposal
                        ProposalIndexWidget.SaveFullPage(buttonPressed);
                    }
                }], 900);
        };

        ProposalIndexWidget.SaveFullPage = function (buttonPressed, isRedirectHome) {
            var dataToSend = ProposalIndexWidget.GetData();
            dataToSend = JSON.stringify(dataToSend);
                        
            // Make the call
            ProposalIndexWidget.saveRequest({
                type: 'POST',
                url: GenSession.CreateUrl({
                    controller: '@WebConstants.Controller.PROPOSAL',
                    action: '@WebConstants.Action.SAVE_PROPOSAL_INFORMATION'
                }),
                contentType: 'application/json; charset=utf-8',
                data: dataToSend,
                success: function (response) {
                    ProposalIndexWidget.SaveSuccess(response.proposalId, response.invalidUsers, isRedirectHome);
                },
                error: function () {
                    ProposalIndexWidget.refreshModule();
                }
            }, buttonPressed);
        };

        ProposalIndexWidget.ReloadPage = function(proposalId) {
            if (proposalId == undefined) {
                proposalId = ProposalIdWhenPageRendered;
            }

            var ProposalUrl = GenSession.CreateUrl({
                controller: '@WebConstants.Controller.PROPOSAL',
                action: '@WebConstants.Action.DISPLAY_PROPOSAL_DETAILS',
                id: proposalId
            });

            var toUse = ProposalUrl + '#Proposal';

            if (window.location.href == toUse){
                // reload the page
                window.location.reload();
            } else {
                window.location.href = toUse;
            }
        }

        ProposalIndexWidget.SaveSuccess = function (proposalId, invalidUsers, isRedirectHome) {
            ProposalIndexWidget.cleanAllDirtyForms();
            if (ProposalIdWhenPageRendered > 0 && invalidUsers === 'true')  // only checking invalid users warning for updates, not inserts
            {
                GenSession.alertDialog('Invalid users', 'There are invalid users that were not changed.', null, null, ProposalIndexWidget.ReloadPage);
            } else {
                if (isRedirectHome) {
                    ProposalIndexWidget.RedirectHome();
                } else {
                    ProposalIndexWidget.ReloadPage(proposalId);
                }
            }
        };

        ProposalIndexWidget.RedirectHome = function () {
            @if (Model.IsNewRevision && Model.RevisedProposalId.HasValue) {
                <text>
                // Redirect Revisions back to original proposal
                window.location = GenSession.CreateUrl({
                    controller: '@WebConstants.Controller.PROPOSAL',
                    action: '@WebConstants.Action.DISPLAY_PROPOSAL_DETAILS',
                    id: '@Model.RevisedProposalId'
                });
                </text>
            } else {
                <text>
                window.location = GenSession.CreateUrl({
                    controller: '@WebConstants.Controller.HOME',
                    action: '@WebConstants.Action.HOME_DISPLAY_GENTRAC_HOME'
                });
                </text>
            }
        };
    });
    </script>

<div id="newProposal" class="module full">
    <div id="proposalInfoDataPlaceholder"></div>
    <div id="proposalGeneralInfoDataPlaceholder"></div>
    <div id="proposalApprovalsPlaceholder"></div>
    <div id="proposalUserInfoDataPlaceholder" data-proposal-type="standard"></div>
    <div id="proposalCommentsPlaceholder"></div>
    <div class="module-content-data" style="width: 982px">
        @using (Html.BeginForm("", "", FormMethod.Post, new { id = "proposalForm", name = "proposalForm" }))
        {
           <div class="required-note"> * required for saving.</div>
        }
    </div>
</div>
