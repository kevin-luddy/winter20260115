@{
    string gotoHelpText = "Enter the PTM or PROFIT Tracking # and click Go.<br><br>" +
        "NOTE - Only active, archived or deleted records can be searched directly. ";
    var iesHeaderUrl = IES.Common.ConfigurationUtilities.IESHeaderUrl("PTM");
}

<!DOCTYPE html>
<html>
<head>
    <!-- Force Internet Explorer 8 if its available -->
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>@ViewBag.Title</title>
    <link rel="shortcut icon" type="image/icon" href="@Url.Content("~/Content/Images/favicon.ico")" />

    @if (!SiteMasterUtilities.DisablePiwik()) { 
    <!-- Piwik Statistics -->
<script type="text/javascript">
        window.piwikAsyncInit = function () {
	        try {
                var piwikTracker = Piwik.getTracker(pkBaseURL + "piwik.php", 25);                //<!-- BusApps Rollup -->
		        piwikTracker.setDocumentTitle(document.domain + "/" + document.title);
		        piwikTracker.trackPageView();
		        piwikTracker.enableLinkTracking();

		        var piwikTracker1 = Piwik.getTracker(pkBaseURL + "piwik.php", 91);           //<!-- Space Rollup -->
		        piwikTracker1.setDocumentTitle(document.domain + "/" + document.title);
		        piwikTracker1.trackPageView();
		        piwikTracker1.enableLinkTracking();

		        var piwikTracker2 = Piwik.getTracker(pkBaseURL + "piwik.php", 94);           //<!-- Space Business Systems -->
		        piwikTracker2.setDocumentTitle(document.domain + "/" + document.title);
		        piwikTracker2.trackPageView();
		        piwikTracker2.enableLinkTracking();

		        var piwikTracker3 = Piwik.getTracker(pkBaseURL + "piwik.php", @SiteMasterUtilities.PiwikId());          //<!-- Space PTM  -->
	            // Track each user's visit
			    piwikTracker3.push(['setUserId', '@IES.Common.Utilities.CurrentUser()']);
	            piwikTracker3.setDocumentTitle(document.domain + "/" + document.title);
		        piwikTracker3.trackPageView();
		        piwikTracker3.enableLinkTracking();
	        } catch( err ) {}
        };
</script>
    <noscript>
        <p><img src="https://techopstoolbox.global.lmco.com/piwik/piwik.php?idsite=25" style="border:0" alt="Piwik"></p>
        <p><img src="https://techopstoolbox.global.lmco.com/piwik/piwik.php?idsite=91" style="border:0" alt="Piwik"></p>
        <p><img src="https://techopstoolbox.global.lmco.com/piwik/piwik.php?idsite=94" style="border:0" alt="Piwik"></p>
        <p><img src="https://techopstoolbox.global.lmco.com/piwik/piwik.php?idsite=@SiteMasterUtilities.PiwikId()" style="border:0" alt="Piwik"></p>

    </noscript>
    <script type="text/javascript">
        var pkBaseURL = "@SiteMasterUtilities.PiwikUrl()";
        document.write(unescape("%3Cscript src='" + pkBaseURL + "piwik.js' type='text/javascript'%3E%3C/script%3E"));
    </script>
    <!-- End Piwik Statistics Code -->
    }

    <script type="text/javascript">
        // This script is used to prevent cross-frame attacks
        if (top.frames.length != 0) {
            top.location = self.document.location;
        }
    </script>
    
    @Scripts.Render("~/bundles/home")
    @Styles.Render("~/Content/homeCss")
    
    <script type="text/javascript">
        $(function () {

            GenSession.setToolPrefix('@WebConfigurationManager.AppSettings["ToolPrefix"].ToString()');
            GenSession.setHomePrefix('');

            $(".nav-bar.left .submenu").each(function () {
                // Move each submenu directly under its parent tab

                // move it right to the position of its parent menu item.
                $(this).css("margin-left", $(this).parent().position().left);

                // Set the submenu width the greater of its current size or the tab width - 2px
                // The 2px make up for the border on the submenu.
                // add 5 pixels for padding
                $(this).css("width", Math.max($(this).parent().width() - 2, $(this).width() + 5));
            });

            $(".nav-bar.right .submenu").each(function () {
                // Set the submenu width the greater of its current size or the tab width - 2px
                // The 2px make up for the border on the submenu.
                // add 5 pixels for padding
                $(this).css("width", Math.max($(this).parent().width() - 2, $(this).width() + 5));

                // the submenu will be aligned with the start of the nav-bar
                // move it right to the position of its parent menu item.
                $(this).css("margin-left", $(this).parent().position().left - 1 - ($(this).width() - $(this).parent().width()));
            });

            $(document).bind('SHOW_LOADING_BOX', function () {
                $('#PageLoading').removeClass('display-none');
            });

            $(document).bind('HIDE_LOADING_BOX', function () {
                $('#PageLoading').addClass('display-none');
            });

            $(document).bind('DISPLAY_NOTIFICATION', function (event, text) {
                $('#Notification div.text').html(text);
                $('#Notification').removeClass('display-none');
                $('html, body').animate({ scrollTop: $("#Notification").offset().top }, 200);
            });

            $('#MessageClose').click(function () {
                $('#Notification').addClass('display-none');
            });

            var goToWidgetConfig = {};
            goToWidgetConfig.ContextID = "goToProposal";
            goToWidgetConfig.IsModule = false;

            var FormConfigs = [];
            FormConfigs.push({
                ElementID: "goToProposalForm",
                Buttons: [
                {
                    ButtonClass: "ies-action go-button",
                    ButtonText: 'GO',
                    ButtonName: 'go-button',
                    ButtonAction: function (buttonPressed) {
                        GoToProposalWidget.GoToProposal(buttonPressed);
                    },
                    Stateful: false
                }],
                HideOCI: "true"
            });

            goToWidgetConfig.FormConfigs = FormConfigs;

            GoToProposalWidget = new GenWidget(goToWidgetConfig);

            GoToProposalWidget.on('keydown', 'input[name=trackingNumber]', function (e) {
                /****enter key to search */
                var keyCode = (e.keyCode ? e.keyCode : (e.which ? e.which : e.charcode));
                if (keyCode == 13) {
                    GoToProposalWidget.GoToProposal(GoToProposalWidget.getElement("button[name='go-button']"));
                }
            });

            GoToProposalWidget.GetData = function () {
                var dataToSave = {};
                dataToSave.inProposalTrackingNumber = GoToProposalWidget.getElement('input[name="trackingNumber"]').val();
                return dataToSave;
            }

            GoToProposalWidget.GoToProposal = function (buttonPressed) {
                if (GoToProposalWidget.getElement('input[name="trackingNumber"]').val().trim() != '') {
                    var dataToSend = GoToProposalWidget.GetData();
                    dataToSend = JSON.stringify(dataToSend);

                    // Make the call
                    GoToProposalWidget.saveRequest({
                        type: 'POST',
                        url: GenSession.CreateUrl({
                            controller: '@WebConstants.Controller.HOME',
                            action: '@WebConstants.Action.GOTO_PROPOSAL'
                        }),
                        contentType: 'application/json; charset=utf-8',
                        data: dataToSend,
                        success: function (response) {
                            try {
                                GoToProposalWidget.ProcessGoToStatus(response.Result);
                            }
                            catch (ex) {
                                // Only ignore "Unspecified Errors" - known IE bug
                                // when clicking `Cancel` at the IE dirty bit prompt
                                if (ex.message.indexOf('Unspecified') == -1) {
                                    throw ex;
                                }
                            }
                        },
                        error: function () {
                            GoToProposalWidget.refreshModule();
                        }
                    }, buttonPressed);
                }
            };

            GoToProposalWidget.ProcessGoToStatus = function (result) {
                var title;
                var message;
                if (result == "not_found") {
                    // display Not Found dialog
                    title = "Tracking Number Not Found";
                    message = "Proposal record does not exist.";
                    GenSession.commonDialog(title, message, [{
                        buttonClass: 'ies',
                        ButtonText: 'OK',
                        ButtonName: "ok-button"
                    }], 275, null, null);
                }
                else if (result == "access_denied") {
                    // display Access Denied dialog
                    title = "No Permission to View Record";
                    message = "You don't have permission to view the proposal record."
                    GenSession.commonDialog(title, message, [{
                        buttonClass: 'ies',
                        ButtonText: 'OK',
                        ButtonName: "ok-button"
                    }], 275, null, null);
                }
                else if (result != "") {
                    // redirect to proposal using id
                    window.location = GenSession.CreateUrl({
                        controller: '@WebConstants.Controller.PROPOSAL',
                        action: '@WebConstants.Action.DISPLAY_PROPOSAL_DETAILS',
                        id: result
                    })
                }
            };
        });

        var isClassEnvironment = @SiteMasterUtilities.IsClassEnvironment.ToString().ToLower();
    </script>
</head>
<body>
    @{ if (IdentitySwap.IdentitySwappingForTesting.IsIdentitySwappingAllowed("IsIdentitySwappingAllowed", "ActiveDirectoryPath", "ADGroupsAllowedToSwapIdentity"))
        {
            <div id="IdentitySwappingDiv">
                <script src="@Url.Content("~/Scripts/IdentitySwappingScript.js")" type="text/javascript"></script>
            </div>
        }
    }
    <div class="page">
        <div class="lmproprietary">Lockheed Martin Proprietary Information</div>
        @{ if (!string.IsNullOrEmpty(iesHeaderUrl))
            {
                <iframe class="iframe" src="@iesHeaderUrl"></iframe>
            }
        }
        <div class="header">
            <div class="beta">
                Beta Test Environment – Test data will not be maintained and may be lost at any time
            </div>
            <div class="title">
                <div class="site-name">
                    <a class="title-link" href="/@WebConfigurationManager.AppSettings["toolPrefix"].ToString()">
                        <img alt="PTM" class="ptm-logo-header" src="~/Content/images/logo_PTM_wide.jpg" />
                    </a>
                    <div class="user-name">
                        @if (System.Web.Configuration.WebConfigurationManager.AppSettings["ShowUserName"].Equals("true"))
                        {
                            <span>Username: @System.Threading.Thread.CurrentPrincipal.Identity.Name</span>
                        }
                    </div>
                    <img src="~/Content/images/LM-logo-White.png" alt="Lockheed Martin logo" class="lmlogo" />
                </div>
            </div>
        </div>

        @{Html.RenderAction(WebConstants.Action.GENTRAC_DISPLAY_HOME_MENU, WebConstants.Controller.GEN_TRAC, new { context = ViewContext });}
        @{ if (!string.IsNullOrEmpty(ConfigurationUtilities.IESBannerUrl(ConfigurationUtilities.IESBannerApp)))
            {
                <div class="bannerContainer">
                    <iframe class="bannerframe" src="@ConfigurationUtilities.IESBannerUrl(ConfigurationUtilities.IESBannerApp)"></iframe>
                </div>
            }
        }
        <div class="main">
            <div id="Notification" class="notification-bar display-none">
                <div class="notification">
                    <div class="text">Notify Me!</div>
                    <div id="MessageClose" class="button message-close-button"></div>
                </div>
            </div>
            <div id="goToProposal">
                @using (Html.BeginForm("", "", FormMethod.Post, new { id = "goToProposalForm", name = "goToProposalForm", onSubmit = "return false;" }))
                {
                    <div class="form-label" helptext="@gotoHelpText">Go To Tracking #:</div>
                    <div class="form-element">
                        <input type="text" name="trackingNumber" size="12" maxlength="14" class="ignore-dirty" />
                    </div>
                }
            </div>
            <div name="stop_float" style="clear:both;"></div>
            @RenderBody()
        </div>
    </div>
    <div class="footer">
        <div class="beta">
            Beta Test Environment – Test data will not be maintained and may be lost at any time
        </div>
        <div class="lmproprietary">
            Lockheed Martin Proprietary Information
            <div id="footerVersionInfo">@IES.Common.Utilities.VersionAndUpdatedDate</div>
        </div>
    </div>
    <div id="ExceptionDialog" style="display: none; text-align: center;">
        <div id="ErrorText" class="dialog-text">
            Replace me!
            <br />
        </div>
        <span id="ToggleErrorDetails" class="underline pointer">
            Error Details
            <br />
        </span>
        <div id="ErrorDetails" class="error-details">
            Replace me!
            <br />
            <br />
        </div>
        <div class="error-buttons">
            <button id="ExceptionDialog-OK" class="ies" name="ok-button" onclick="$('#ExceptionDialog').dialog('close');" type="button">OK</button>
        </div>
    </div>
    <div id="CommonDialog" style="display: none; text-align: center;">
        <div id="CommonDialogBody" class="dialog-text">
            <br />
        </div>
        <div class="buttons">
        </div>
    </div>
    <div id="PageLoading" class="page-loading display-none">
        <div class="loading-box">
            <div class="loader white"></div>
            <span>Loading...</span>
        </div>
    </div>
    <div id="PageValidating" class="page-loading display-none">
        <div class="loading-box">
            <div class="loader white"></div>
            <span>Validating...</span>
        </div>
    </div>
</body>
</html>
