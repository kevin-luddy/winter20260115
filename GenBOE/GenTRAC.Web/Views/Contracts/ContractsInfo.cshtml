@model GenTRAC.ActionLogic.ModelView.ContractsModelView
<script type="text/javascript">
    var ContractsInfoWidget;
    var modalWindow;

    const dateElements = [
        'CustomerDueDate',
        'CustomerSubmittalDate',
		'NegotiationsSubmitted',
		'PlannedBidEppDate',
		'PlannedProgramEppDate',
		'PlannedMissionSegmentEppDate',
        'PlannedLobEppDate',
        'PlannedPreSpaceEppDate',
        'PlannedSpaceEppDate',
        'PlannedPreCorporateEppDate',
		'PlannedCorporateEppDate',
		'ScheduledBidEppDate',
		'ScheduledProgramEppDate',
		'ScheduledMissionSegmentEppDate',
		'ScheduledLobEppDate',
		'ScheduledPreSpaceEppDate',
		'ScheduledSpaceEppDate',
		'ScheduledPreCorporateEppDate',
		'ScheduledCorporateEppDate',
        'ModCompletedDate'
    ];

    const initDatePickerElements = handleDateSelect => {
        dateElements.forEach(element => {
            ContractsInfoWidget.getElement('input[name="' + element + '"]').datepicker({
                dateFormat: 'mm/dd/yy',
                onSelect: handleDateSelect
            });
        })
    };

    $(function () {
        var readOnly = ContractsIndexWidget.readOnly;
        var widgetConfig = {};
        widgetConfig.ContextID = "contractsInfo";
        widgetConfig.IsModule = true;
        widgetConfig.isReadOnly = readOnly;

        ContractsInfoWidget = new GenWidget(widgetConfig);

        ContractsInfoWidget.romChanged = function () {
            var previouslySubmittedROM = ContractsInfoWidget.getElement('#PreviouslySubmittedROM').val();

            ContractsInfoWidget.getElement('[name="PreviousROMDate"]').text('');
            ContractsInfoWidget.getElement('[name="PreviousROMValue"]').text('');

            if (previouslySubmittedROM) {
                const contractsUrl = GenSession.CreateUrl({
                    controller: '@WebConstants.Controller.CONTRACTS',
                    action: '@WebConstants.Action.GET_SELECTED_ROM_DATA',
                    id: '@ViewBag.ProposalId'
                });

                const data = { previousRomProposalId: previouslySubmittedROM };

                $.ajax({
                    type: "POST",
                    url: contractsUrl,
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify(data),
                    success: function (response) {
                        ContractsInfoWidget.getElement('[name="PreviousROMDate"]').text(response.Date);
                        ContractsInfoWidget.getElement('[name="PreviousROMValue"]').text(response.Value);
                    }
                });
            }
        };

		ContractsInfoWidget.insuranceChanged = function () {
			var isInsuranceProposedDirect = ContractsInfoWidget.getElement('#IsInsuranceDirect').val();
            
			if (isInsuranceProposedDirect && isInsuranceProposedDirect === 'Yes') {
                // Show the Insurance Type dropdown
				$('#InsuranceTypeDiv').show();
            } else {
                // Hide the Insurance Type dropdown
				$('#InsuranceTypeDiv').hide();
            }
        };

        const handleDateSelect = function () {
            ContractsInfoWidget.setDirty('contractsForm');
            $(this).blur();
            $(this).next('button.ui-datepicker-trigger').attr('tabindex', '0');
            $(this).next('button.ui-datepicker-trigger').focus();
        };

        if (ContractsIndexWidget.readOnly === false) {
            initDatePickerElements(handleDateSelect);
        }

        ContractsInfoWidget.setProposalComplete = () => {
            $('#proposal-complete').prop('disabled', true);

            const propCompleteUrl = GenSession.CreateUrl({
                controller: '@WebConstants.Controller.COMPLETION',
                action: '@WebConstants.Action.COMPLETE_PROPOSAL',
                id: '@ViewBag.ProposalId'
            });

            const data = { };

            ContractsInfoWidget.postData(propCompleteUrl, data);
        };

        ContractsInfoWidget.setProposalLost = () => {
            $('#confirm-modal-submit').prop('disabled', true);

            const propLostUrl = GenSession.CreateUrl({
                controller: '@WebConstants.Controller.CONTRACTS',
                action: '@WebConstants.Action.SET_PROPOSAL_LOST',
                id: '@ViewBag.ProposalId'
            });

            const data = { };

            ContractsInfoWidget.postData(propLostUrl, data);
        };

        ContractsInfoWidget.setNoBid = function () {
            GenSession.confirmDialog("Confirm No Bid",
                "If this Proposal is set as No Bid, it will no longer be able to be used to create new BOEs and RDSB records. Existing BOEs and RDSB records will not be affected. Are you sure you wish to continue?",
                function () {
                    $.ajax({
                        type: 'POST',
                        url: GenSession.CreateUrl({
                            controller: '@WebConstants.Controller.CONTRACTS',
                            action: '@WebConstants.Action.SET_NO_BID',
                            id: '@ViewBag.proposalid'
                        }),
                        contentType: 'application/json; charset=utf-8',
                        success: function (response) {
                            if (typeof (response.IsSuccessful) !== 'undefined') {
                                if (response.IsSuccessful) {
                                    ContractsIndexWidget.SaveSuccess();
                                } else {
                                    ContractsInfoWidget.processErrors(response);
                                }
                            }
                        }
                    });
            }, null);
        };

        ContractsInfoWidget.processErrors = function (response) {
            if (typeof (response.Messages) !== 'undefined' && response.Messages.length > 0) {
                response.Messages.forEach(message => {
                    $('#contractsInfoForm .validation-box').append('<li>' + message + '</li>');
                });
                modalWindow.dialog('close');
                $('#confirm-modal-input').val('');
                $('#confirm-modal-submit').text('Set Contract Not Awarded');
                $('#confirm-modal-input').trigger('keyup');
                $('#contractsInfoForm .validation-box').show();
            }
        };

        ContractsInfoWidget.postData = function (url, data) {
            $.ajax({
                type: "POST",
                url: url,
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(data),
                success: function (response) {
                    if (typeof (response.IsSuccessful) !== 'undefined') {
                        if (response.IsSuccessful === true) {
                            ContractsIndexWidget.SaveSuccess(@ViewBag.proposalid);
                        } else {
                            ContractsInfoWidget.processErrors(response);
                        }

                        ContractsInfoWidget.refreshModule();
                        ContractsIndexWidget.refreshModule();
                    }
                }
            });
        }

        ContractsInfoWidget.revertNoBid = function () {
            GenSession.confirmDialog("Confirm Revert No Bid",
                "If this Proposal is reverted from No Bid, the approval process will be reset. Are you sure you wish to continue?",
                function () {
                    $.ajax({
                        type: 'POST',
                        url: GenSession.CreateUrl({
                            controller: '@WebConstants.Controller.CONTRACTS',
                            action: '@WebConstants.Action.REVERT_NO_BID',
                            id: '@ViewBag.proposalid'
                        }),
                        contentType: 'application/json; charset=utf-8',
                        success: function (response) {
                            if (typeof (response.IsSuccessful) !== 'undefined') {
                                if (response.IsSuccessful) {
                                    ContractsIndexWidget.SaveSuccess();
                                } else {
                                    ContractsInfoWidget.processErrors(response);
                                }
                            }
                        }
                    });
            }, null);
        };
    });

    $(document).ready(function () {
        // set modal
        modalWindow = $('#confirm-loss-modal').dialog({
            autoOpen: false,
            height: 190,
            width: 350,
            modal: true,
            close: function () {
                $('#proposal-lost').prop('disabled', false);
            }
        });

        $('#proposal-lost').on('click', function () {
            $(this).prop('disabled', true);
            modalWindow.dialog('open');
        });

        $('#proposal-complete').on('click', function () {
            $(this).text('Please Wait...');
            ContractsInfoWidget.setProposalComplete();
        });

        $('#confirm-modal-input').keyup(function () {
			if ($('#confirm-modal-input').val().trim() === 'NOT AWARDED') {
                $('#confirm-modal-submit').prop('disabled', false);
            } else {
                $('#confirm-modal-submit').prop('disabled', true);
            }
        });

        $('#confirm-modal-submit').on('click', function () {
            $(this).text('Please Wait...');
            ContractsInfoWidget.setProposalLost();
        });

        $('#FinalNegotiatedValue').on('change', function () {
            const dollarValue = $('#FinalNegotiatedValue').val().trim().replace('$', '').replace(/\,/g, '');
            GenTRAC.numericCommaSeparator(ContractsInfoWidget, dollarValue, 'input[name="FinalNegotiatedValue"]', false);
            $('#FinalNegotiatedValue').val('$' + $('#FinalNegotiatedValue').val());
        });

		$('#ProposedInsurance').on('change', function () {
			const dollarValue = $('#ProposedInsurance').val().trim().replace('$', '').replace(/\,/g, '');
			GenTRAC.numericCommaSeparator(ContractsInfoWidget, dollarValue, 'input[name="ProposedInsurance"]', false);
        });

		$('#NegotiatedInsurance').on('change', function () {
			const dollarValue = $('#NegotiatedInsurance').val().trim().replace('$', '').replace(/\,/g, '');
			GenTRAC.numericCommaSeparator(ContractsInfoWidget, dollarValue, 'input[name="NegotiatedInsurance"]', false);
		});

        // can't trigger change event so we don't make form dirty
		var dollarVal = $('#ProposedInsurance').val().trim().replace('$', '').replace(/\,/g, '');
		GenTRAC.numericCommaSeparator(ContractsInfoWidget, dollarVal, 'input[name="ProposedInsurance"]', false);
		dollarVal = $('#NegotiatedInsurance').val().trim().replace('$', '').replace(/\,/g, '');
		GenTRAC.numericCommaSeparator(ContractsInfoWidget, dollarVal, 'input[name="NegotiatedInsurance"]', false);
        ContractsInfoWidget.insuranceChanged();
    });
</script>

<div id="contractsInfo" class="composite module full">
    <div class="module-header-data">Contract Information</div>
    
	<div class="module-content-data expanded-content position-relative">
		<div class="button-right-container">
			@if (Model.HasAccessToSetNoBid)
			{
				if (Model.IsNoBid)
				{
					<button type="button" class="ies" title="Revert the status of this Proposal to In Progress" onclick="ContractsInfoWidget.revertNoBid()">Revert from No Bid to In Progress</button>
				}
				else
				{
					<button type="button" class="ies" title="@Model.NoBidButtonText" onclick="ContractsInfoWidget.setNoBid()" @(Model.NoBidButtonEnabled ? string.Empty : "disabled")>@Model.NoBidButtonText</button>
				}
			}
			@if (!Model.IsRomNte)
			{
				<button id="proposal-lost" type="button" class="ies" @(Model.SetLostButtonEnabled ? string.Empty : "disabled")>Proposal Not Awarded</button>
			}
			<button id="proposal-complete" type="button" class="ies" @(Model.CompleteButtonEnabled ? string.Empty : "disabled")>Complete</button>
		</div>
		@using (Html.BeginForm("", "", FormMethod.Post, new { id = GenTRAC.ActionLogic.ContractsControllerLogic.CONTRACTS_INFO_FORM, name = GenTRAC.ActionLogic.ContractsControllerLogic.CONTRACTS_INFO_FORM }))
		{
			@Html.HiddenFor(x => x.Id)
			@Html.HiddenFor(x => x.ProposalId)
			@Html.HiddenFor(x => x.LastUpdatedDateLong);
			if (!Model.IsRomNte)
			{
				<div class="form-row">
					<div class="form-label">@Html.LabelFor(x => x.PreviouslySubmittedROM)</div>
					<div class="form-element">
						@Html.DropDownListFor(x => x.PreviouslySubmittedROM, Model.PreviouslySubmittedRoms, string.Empty, new { @class = "half", onchange = "ContractsInfoWidget.romChanged()" })
					</div>
				</div>
				<div class="form-row">
					<div class="form-label">@Html.LabelFor(x => x.PreviousROMDate)</div>
					<div class="form-element" name="PreviousROMDate">
						@Html.DisplayFor(x => x.PreviousROMDate)
					</div>
				</div>
				<div class="form-row">
					<div class="form-label">@Html.LabelFor(x => x.PreviousROMValue)</div>
					<div class="form-element" name="PreviousROMValue">
						@Html.DisplayFor(x => x.PreviousROMValue)
					</div>
				</div>
			}
			<div class="form-row">
				<div class="form-label">
					<span helptext="If this is an Unsolicited Bid, enter the Proposal Submittal Date. Ensure most recent due date is entered.">@Html.LabelFor(x => x.CustomerDueDate)</span>
				</div>
				<div class="form-element">
					@Html.TextBoxFor(x => x.CustomerDueDate, new { @class = "date", placeholder = "mm/dd/yyyy" })
				</div>
			</div>
			<div class="form-row">
				@if (Model.IsRomNte)
				{
					<div class="form-label">@Html.LabelFor(x => x.CustomerSubmittalDate, "ROM/NTE Submittal Date to Customer")</div>
				}
				else
				{
					<div class="form-label">@Html.LabelFor(x => x.CustomerSubmittalDate)</div>
				}
				<div class="form-element">
					@Html.TextBoxFor(x => x.CustomerSubmittalDate, new { @class = "date", placeholder = "mm/dd/yyyy" })
				</div>
			</div>
			<div class="form-row">
				<div class="form-label">@Html.LabelFor(x => x.CageCode)</div>
				<div class="form-element">
					@Html.DropDownListFor(x => x.CageCode, Model.CageCodeSelectListItems, string.Empty, new { @class = "half" })
				</div>
			</div>
			<div class="form-row">
				<div class="form-label">@Html.LabelFor(x => x.ContractsCorrespondenceLogNumber) *</div>
				<div class="form-element">
					@Html.TextBoxFor(x => x.ContractsCorrespondenceLogNumber, new { @class = "half" })
				</div>
			</div>
			if (!Model.IsRomNte)
			{
				<div class="form-row">
					<div class="form-label">@Html.LabelFor(x => x.FinalNegotiatedValue)</div>
					<div class="form-element">
						@Html.TextBoxFor(x => x.FinalNegotiatedValue, new { @class = "half" })
					</div>
				</div>
				<div class="form-row">
					<div class="form-label">@Html.LabelFor(x => x.NegotiationsSubmitted)</div>
					<div class="form-element">
						@Html.TextBoxFor(x => x.NegotiationsSubmitted, new { @class = "date", placeholder = "mm/dd/yyyy" })
					</div>
				</div>
			}
			<div class="form-row">
				<div class="form-label">@Html.LabelFor(x => x.EppDelegationAuthority)</div>
				<div class="form-element">
					@Html.DropDownListFor(model => model.EppDelegationAuthority, Model.EppOptions, new { name = "EppDelegationAuthority" })
				</div>
			</div>
			<div class="form-row epp-date-container">
				@* Planned EPP Dates *@
				<div class="form-label date-container planned-date">
					<div class="form-row header-row">
						<div class="form-element date-container-label planned-label">Planned EPP Dates</div>
					</div>

					@* Dates *@
					<div class="form-row">
						<div class="form-label">@Constants.BID_EPP_DATE_DISPLAY_STRING</div>
						<div class="form-element">
							@Html.TextBoxFor(x => x.PlannedBidEppDate, "{0:M/d/yyyy}", new { @class = "date", placeholder = "mm/dd/yyyy" })
						</div>
					</div>
					<div class="form-row">
						<div class="form-label">@Constants.PROGRAM_EPP_DATE_DISPLAY_STRING</div>
						<div class="form-element">
							@Html.TextBoxFor(x => x.PlannedProgramEppDate, "{0:M/d/yyyy}", new { @class = "date", placeholder = "mm/dd/yyyy" })
						</div>
					</div>
					<div class="form-row">
						<div class="form-label">@Constants.MISSION_SEGMENT_EPP_DATE_DISPLAY_STRING</div>
						<div class="form-element">
							@Html.TextBoxFor(x => x.PlannedMissionSegmentEppDate, "{0:M/d/yyyy}", new { @class = "date", placeholder = "mm/dd/yyyy" })
						</div>
					</div>
					<div class="form-row">
						<div class="form-label">@Constants.LOB_EPP_DATE_DISPLAY_STRING</div>
						<div class="form-element">
							@Html.TextBoxFor(x => x.PlannedLobEppDate, "{0:M/d/yyyy}", new { @class = "date", placeholder = "mm/dd/yyyy" })
						</div>
					</div>
					<div class="form-row">
						<div class="form-label">@Constants.PRE_SPACE_EPP_DATE_DISPLAY_STRING</div>
						<div class="form-element">
							@Html.TextBoxFor(x => x.PlannedPreSpaceEppDate, "{0:M/d/yyyy}", new { @class = "date", placeholder = "mm/dd/yyyy" })
						</div>
					</div>
					<div class="form-row">
						<div class="form-label">@Constants.SPACE_EPP_DATE_DISPLAY_STRING</div>
						<div class="form-element">
							@Html.TextBoxFor(x => x.PlannedSpaceEppDate, "{0:M/d/yyyy}", new { @class = "date", placeholder = "mm/dd/yyyy" })
						</div>
					</div>
					<div class="form-row">
						<div class="form-label">@Constants.PRE_CORPORATE_EPP_DATE_DISPLAY_STRING</div>
						<div class="form-element">
							@Html.TextBoxFor(x => x.PlannedPreCorporateEppDate, "{0:M/d/yyyy}", new { @class = "date", placeholder = "mm/dd/yyyy" })
						</div>
					</div>
					<div class="form-row">
						<div class="form-label">@Constants.CORPORATE_EPP_DATE_DISPLAY_STRING</div>
						<div class="form-element">
							@Html.TextBoxFor(x => x.PlannedCorporateEppDate, "{0:M/d/yyyy}", new { @class = "date", placeholder = "mm/dd/yyyy" })
						</div>
					</div>

				</div>

				@if (Model.IsNSS)
				{
					@* Scheduled EPP Dates *@
					<div class="form-label date-container scheduled-date">
						<div class="form-row header-row">
							<div class="form-label date-container-label">Scheduled EPP Dates</div>
						</div>

						@* Dates *@
						<div class="form-row">
							<div class="form-element">
								@Html.TextBoxFor(x => x.ScheduledBidEppDate, "{0:M/d/yyyy}", new { @class = "date", placeholder = "mm/dd/yyyy" })
							</div>
						</div>
						<div class="form-row">
							<div class="form-element">
								@Html.TextBoxFor(x => x.ScheduledProgramEppDate, "{0:M/d/yyyy}", new { @class = "date", placeholder = "mm/dd/yyyy" })
							</div>
						</div>
						<div class="form-row">
							<div class="form-element">
								@Html.TextBoxFor(x => x.ScheduledMissionSegmentEppDate, "{0:M/d/yyyy}", new { @class = "date", placeholder = "mm/dd/yyyy" })
							</div>
						</div>
						<div class="form-row">
							<div class="form-element">
								@Html.TextBoxFor(x => x.ScheduledLobEppDate, "{0:M/d/yyyy}", new { @class = "date", placeholder = "mm/dd/yyyy" })
							</div>
						</div>
						<div class="form-row">
							<div class="form-element">
								@Html.TextBoxFor(x => x.ScheduledPreSpaceEppDate, "{0:M/d/yyyy}", new { @class = "date", placeholder = "mm/dd/yyyy" })
							</div>
						</div>
						<div class="form-row">
							<div class="form-element">
								@Html.TextBoxFor(x => x.ScheduledSpaceEppDate, "{0:M/d/yyyy}", new { @class = "date", placeholder = "mm/dd/yyyy" })
							</div>
						</div>
						<div class="form-row">
							<div class="form-element">
								@Html.TextBoxFor(x => x.ScheduledPreCorporateEppDate, "{0:M/d/yyyy}", new { @class = "date", placeholder = "mm/dd/yyyy" })
							</div>
						</div>
						<div class="form-row">
							<div class="form-element">
								@Html.TextBoxFor(x => x.ScheduledCorporateEppDate, "{0:M/d/yyyy}", new { @class = "date", placeholder = "mm/dd/yyyy" })
							</div>
						</div>
					</div>
				}
			</div>
			<div class="form-row" data-proposal-type="standard">
				<div class="form-label">@Html.LabelFor(x => x.EppRosDelegationNotes)</div>
				<div class="form-element">
					<textarea id="EppRosDelegationNotes" name="EppRosDelegationNotes" rows="3">@Model.EppRosDelegationNotes</textarea>
				</div>
			</div>
			if (!Model.IsRomNte)
			{
				<div class="form-row">
					<div class="form-label">@Html.LabelFor(x => x.LmWon)</div>
					<div class="form-element">
						<label>Yes</label> @Html.RadioButtonFor(x => x.LmWon, true)
						<label>No</label>  @Html.RadioButtonFor(x => x.LmWon, false)
					</div>
				</div>
				<div class="form-row">
					<div class="form-label"><span helptext="Note: Certain insurance cost, such as Defense Base Act (DBA) Insurance, should not be proposed direct as it is an indirect cost.">@Html.LabelFor(x => x.IsInsuranceDirect)**</span></div>
					<div class="form-element">
						@Html.DropDownListFor(model => model.IsInsuranceDirect, Model.InsuranceProposedDirectOptions, new { name = "IsInsuranceDirect", @class = "half", onchange = "ContractsInfoWidget.insuranceChanged()" })

						<div id="InsuranceTypeDiv">
							<span>&nbsp;&nbsp;Select Insurance Type: </span>@Html.DropDownListFor(model => model.InsuranceType, Model.InsuranceTypeOptions, new { name = "InsuranceType", @class = "half" })
						</div>
					</div>
				</div>
				<div class="form-row">
					<div class="form-label"><span helptext="This is for insurance that is beyond what LMC already covers; Enter in U.S. whole dollars">@Html.LabelFor(x => x.ProposedInsurance)**</span></div>
					<div class="form-element">
						@Html.TextBoxFor(x => x.ProposedInsurance, new { @class = "half" })
					</div>
				</div>
				<div class="form-row">
					<div class="form-label"><span helptext="Enter in U.S. whole dollars">@Html.LabelFor(x => x.NegotiatedInsurance)**</span></div>
					<div class="form-element">
						@Html.TextBoxFor(x => x.NegotiatedInsurance, new { @class = "half" })
					</div>
				</div>
				<div class="form-row">
					<div class="form-label">@Html.LabelFor(x => x.ModCompletedDate)</div>
					<div class="form-element">
						@Html.TextBoxFor(x => x.ModCompletedDate, "{0:M/d/yyyy}", new { @class = "date", placeholder = "mm/dd/yyyy" })
					</div>
				</div>
			}
		}
	</div>
    <div id="confirm-loss-modal" title="Please Confirm" style="display: none;">
        <p><strong>Are you sure the proposal is actually not awarded? This action cannot be undone.</strong></p>
        <br />
        <input type="text" id="confirm-modal-input" name="confirm-modal-input" placeholder="Type NOT AWARDED to Continue" />
        <div class="confirm-modal-button-container">
            <button type="button" id="confirm-modal-submit" class="ies" disabled>Set Contract Not Awarded</button>
        </div>
    </div>
</div>
