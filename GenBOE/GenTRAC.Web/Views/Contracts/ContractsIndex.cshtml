<script type="text/javascript">
    var ContractsIndexWidget;
    GenSession.ShowLoadingBox();

	$(function () {
		@*var readOnly = @Model.IsReadOnly;*@

        var widgetConfig = {};
        widgetConfig.ContextID = "contractsIndex";
        widgetConfig.IsModule = true;
        widgetConfig.isReadOnly = false;

        ContractsIndexWidget = new GenWidget(widgetConfig);

        GenSession.HideLoadingBox();
	});
</script>

<div id="contractsIndex" class="module full">
    <div class="composite module full link-header">
        <div class="module-header-data" style="width: 962px; display: inline-block;">Contracts</div>
    </div>
    <div class="module-content-data" style="width: 982px; height: 60px;">
        <div style="display: inline-block;">
            @using (Html.BeginForm("", "", FormMethod.Post, new { id = "contractsIndexForm", name = "contractsIndexForm" }))
            {
                <div class="form-row">
                    <div class="form-label">Label</div>
                    <div class="form-element"></div>
                    <div class="form-element">
                        <input id="TBD" name="TBD" type="text" class="half" size="50" placeholder="TBD" />
                    </div>
                </div>
            }
        </div>
    </div>
</div>