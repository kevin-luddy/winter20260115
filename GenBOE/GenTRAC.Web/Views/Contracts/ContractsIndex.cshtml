@model GenTRAC.ActionLogic.ModelView.ContractsModelView

<script type="text/javascript">
    var ContractsIndexWidget;
    GenSession.ShowLoadingBox();

	$(function () {
		var readOnly = '@ViewBag.ReadOnly.ToString().ToLower()';

        var widgetConfig = {};
        widgetConfig.ContextID = "contractsIndex";
        widgetConfig.IsModule = true;
        widgetConfig.isReadOnly = false;

        ContractsIndexWidget = new GenWidget(widgetConfig);

        ContractsIndexWidget.getElement('input[name="CustomerSubmittalDate"]').datepicker({
            dateFormat: 'mm/dd/yy',
            onSelect: function (dateText, inst) {
                ProposalIndexWidget.setDirty("contractsIndexForm");
            }
        });

        ContractsIndexWidget.refreshModule();
        GenSession.HideLoadingBox();
	});
</script>
<style type="text/css">
    #contractsIndex .form-label {
        width: 230px;
    }

    #contractsIndex .module-header-data,
    #contractsIndex .module-content-data {
        width: 962px;
        display: inline-block;
    }
</style>

<div id="contractsIndex">
    @Html.Partial("ContractsInfo", Model)
    @Html.Partial("ContractsOffers")
</div>

@using (Html.BeginForm("", "", FormMethod.Post, new { id = "contractsIndexForm", name = "contractsIndexForm" }))
{ }


