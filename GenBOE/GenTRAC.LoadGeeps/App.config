<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="loggingConfiguration" type="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.LoggingSettings, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" requirePermission="true" />
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    <sectionGroup name="elmah">
      <section name="security" requirePermission="false" type="Elmah.SecuritySectionHandler, Elmah" />
      <section name="errorLog" requirePermission="false" type="Elmah.ErrorLogSectionHandler, Elmah" />
      <section name="errorMail" requirePermission="false" type="Elmah.ErrorMailSectionHandler, Elmah" />
      <section name="errorFilter" requirePermission="false" type="Elmah.ErrorFilterSectionHandler, Elmah" />
    </sectionGroup>
    <section name="oracle.manageddataaccess.client" type="OracleInternal.Common.ODPMSectionHandler, Oracle.ManagedDataAccess, Version=4.122.19.1, Culture=neutral, PublicKeyToken=89b483f429c47342" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
	<add name="genTracEntities" connectionString="metadata=res://*/PTMEntityModel.csdl|res://*/PTMEntityModel.ssdl|res://*/PTMEntityModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;__genTracEntities__integrated security=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
	<add name="OracleHRIS" connectionString="Data Source=ssedwdbprd.us.lmco.com:1536/PDEDW;User Id=HRIS_PTM;Password=__HRISPTMPassword__;" />
    <!-- FOR A LOCAL RUN, we need these
        <add name="genTracEntities" connectionString="metadata=res://*/PTMEntityModel.csdl|res://*/PTMEntityModel.ssdl|res://*/PTMEntityModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=Cudan\SSAPPVFDEV;initial catalog=genTrac_DEV;integrated security=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
		<add name="OracleHRIS" connectionString="Data Source=ssedwdbprd.us.lmco.com:1536/PDEDW;User Id=HRIS_PTM;Password=REPLACETHISWITHPASSWORD;" />
    -->
  </connectionStrings>
  <appSettings>
    <!-- General Settings -->
    <add key="EmailServer" value="smtp-lmiden.ems.lmco.com" />
    <add key="ActiveDirectoryPath" value="GC://usadc-gtm.us.lmco.com" />
    <add key="LMIProxy" value="http://proxy-zsgov.external.lmco.com" />
    <!-- Hours offset to convert from the DB's timezone to EST - Database currently in CO using MST, 2 hours behind EST -->
    <add key="DatabaseESTOffset" value="__DatabaseESTOffset__" />
    <!-- Dev level settings -->
    <add key="APPLICATION_VERSION" value="__APPLICATION_VERSION__" />
    <add key="LogType" value="__LogType__" />
    <add key="DisableAllEmails" value="__DisableAllEmails__" />
    <add key="EmailsToCurrentlyLoggedInUser" value="__EmailsToCurrentlyLoggedInUser__" />
    <add key="MaxDegreeOfParallelism" value="__MaxDegreeOfParallelism__" />
    <add key="MaxDbQueries" value="__MaxDbQueries__" />
    <add key="TransactionTimeout" value="360" />
    <add key="ExportLoggingEnableInternalMV" value="false" />
    <add key="ExportLoggingEnableInternalExport" value="false" />
    <!-- FOR A LOCAL RUN, we need these
      <add key="DatabaseESTOffset" value="2" />
      <add key="LogType" value="INFO" />
      <add key="DisableAllEmails" value="False" />
      <add key="EmailsToCurrentlyLoggedInUser" value="True" />
      <add key="MaxDegreeOfParallelism" value="3" />
      <add key="MaxDbQueries" value="25" />
    -->
  </appSettings>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
      <parameters>
        <parameter value="mssqllocaldb" />
      </parameters>
    </defaultConnectionFactory>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
  <elmah>
    <security allowRemoteAccess="true" />
	<errorLog type="Elmah.SqlErrorLog, Elmah" connectionString="__genTracEntities__integrated security=True;multipleactiveresultsets=True;" applicationName="__ElmahAppName__" />
    <!-- FOR A LOCAL RUN, we need these
      <errorLog type="Elmah.SqlErrorLog, Elmah" connectionString="data source=Cudan\SSAPPVFDEV;Initial Catalog=genTrac_DEV;integrated security=True;multipleactiveresultsets=True;" applicationName="LoadGeeps" />
    -->
  </elmah>
  <loggingConfiguration name="" tracingEnabled="true" defaultCategory="Performance">
    <listeners>
      <add name="Rolling Flat File Performance Listener" type="Microsoft.Practices.EnterpriseLibrary.Logging.TraceListeners.RollingFlatFileTraceListener, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" listenerDataType="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.RollingFlatFileTraceListenerData, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" fileName="logs/gentrac.performance.csv" footer="" formatter="Performance Formatter" header="" rollFileExistsBehavior="Increment" rollSizeKB="20000" filter="Information" maxArchivedFiles="20" />
    </listeners>
    <formatters>
      <add type="Microsoft.Practices.EnterpriseLibrary.Logging.Formatters.TextFormatter, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" template="{timestamp(local)},{message}" name="Performance Formatter" />
    </formatters>
    <categorySources>
      <add switchValue="All" name="Performance">
        <listeners>
          <add name="Rolling Flat File Performance Listener" />
        </listeners>
      </add>
    </categorySources>
    <specialSources>
      <allEvents switchValue="All" name="All Events" />
      <notProcessed switchValue="All" name="Unprocessed Category" />
      <errors switchValue="Off" name="Logging Errors &amp; Warnings" />
    </specialSources>
  </loggingConfiguration>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Http" publicKeyToken="31bf3856ad364e35" culture="neutral" />
