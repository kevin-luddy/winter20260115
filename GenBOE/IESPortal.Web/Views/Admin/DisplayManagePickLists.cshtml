@model PickListGridMV 
@using IES.Common.PickList;
@using IES.Common;
@using Newtonsoft.Json
@{
    ViewBag.Title = "Manage Pick Lists - " + Model.PickListName;
    Layout = "~/Views/Admin/_Layout.cshtml";
}

<script type="text/javascript">
    angular.module('portal').value('PickListModelView',
    {
        controller: '@IESWebConstants.CONTROLLER_ADMIN',
        saveAction: '@IESWebConstants.ACTION_SAVE_MANAGE_PICK_LISTS',
        fixErrorsAction: '@IESWebConstants.ACTION_FIX_PICK_LIST_ERRORS',
        upsertValue: '@((int)UpdateType.Upsert)',
        deleteValue: '@((int)UpdateType.Deleted)',
        pickListId: @((int)Model.PickListId),
        showReadOnly: @Model.ContainsReadOnly.ToString().ToLower(),
        showParent: @Model.ContainsParent.ToString().ToLower(),
        allowMultipleParents: @Model.AllowsMultipleParents.ToString().ToLower(),
        data: @Html.Raw(JsonConvert.SerializeObject(Model.PickLists)),
        parents: @Html.Raw(JsonConvert.SerializeObject(Model.Parents)),
        validationMessages: @Html.Raw(JsonConvert.SerializeObject(Model.Messages))
    });
</script>
<div data-ng-app="portal" data-ng-controller="editPickListController">
    <div id="ManagePickLists" class="module" data-ng-show="showAllData">
        <div class="module-header-data">
            @Html.ActionLink("Manage Pick Lists", IESWebConstants.DISPLAY_SELECT_PICK_LIST_TO_MANAGE, new { }, new { style = "text-decoration:none; color: #5297AD;" })
            - @Model.PickListName
        </div>
        <div class="module-content-data" data-ng-cloak style="width: 100%">
            <div class="form-row widget-menu">
                <div class="buttons inline">
                    <button class="ies" data-ng-class="{disabled: disableDeleteButton}" data-ng-click="delete()" name="delete-button" type="button">Delete</button>&nbsp;&nbsp;
                    <button class="ies" name="add-button" data-ng-click="add()" type="button">+ Add</button>&nbsp;&nbsp;
                    <button class="ies-action" data-ng-show="validationErrors.length > 0" data-ng-click="fixErrors()" type="button">Fix Errors</button>
                </div>
            </div>
            <div class="form-row css3pie-position-fix">
                <div gen-validation data-errors="validationErrors"></div>
            </div>
            <div class="row css3pie-position-fix">
                <div gen-validation data-errors="$root.errors"></div>
            </div>
            <div>
                <table class="grid readonly" style="width: 100%">
                    <thead>
                        <tr>
                            <th class="delete-checkbox" width="50px">
                                <input name="deleteAll" data-ng-change="updateDeleteAll()" data-ng-model="deleteAll" class="ignore-dirty" type="checkbox">
                            </th>
                            <th width="340px" class="column-sort-header" data-ng-click="updatePredicate('Text')">Item Text</th>
                            <th width="85px" class="column-sort-header" data-ng-click="updatePredicate('IsActive')">Is Active <img src="~/Content/images/helpSmall.png" title="If Inactive then the Pick List Item will only show in the PTM/BOE dropdown if previously selected"/></th>
                            <th width="75px" class="column-sort-header" data-ng-click="updatePredicate('InUse')">In Use</th>
                            <th width="100px" class="column-sort-header" data-ng-click="updatePredicate('IsReadOnly')" data-ng-show="showReadOnly">Read-Only</th>
                            <th width="500px" class="column-sort-header" data-ng-click="updatePredicate('ParentIds[0]')" data-ng-show="showParent">Parent(s)</th>
                        </tr>
                    </thead>
                    <tr data-ng-show="pickLists.length == 0"><td colspan="6"><div class="empty-grid-text">There are no pick list items.</div></td></tr>
                    <tr data-ng-repeat="pickList in pickLists | orderBy : predicate">
                        <td class="delete-checkbox">
                            <input data-ng-hide="pickList.InUse || pickList.IsReadOnly" name="toDelete" type="checkbox" data-ng-change="updateDeleteStatus()" data-ng-model="pickList.delete"/>
                        </td>
                        <td data-ng-click="edit(pickList.Id)" data-ng-class="{ addEditLink: !pickList.IsReadOnly }">{{pickList.Text}}</td>
                        <td>{{pickList.IsActiveText}}</td>
                        <td><i>{{pickList.InUseText}}</i></td>
                        <td data-ng-show="showReadOnly" data-ng-class="{ addEditLink: !pickList.IsReadOnly }"><i>{{pickList.IsReadOnlyText}}</i></td>
                        <td data-ng-show="showParent">{{getParentNames(pickList.ParentIds)}}</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
    <div id="ManagePickList"  data-ng-cloak data-ng-hide="showAllData" class="module">
        <div class="module-header-data">Add/Edit Pick List Items for @Model.PickListName</div>
        <div class="module-content-data">
            <form id="pickListForm" name="pickListForm" method="post">
                <div class="container">
                    <div class="row css3pie-position-fix">
                        <div gen-validation data-errors="$root.errors"></div>
                    </div>
                    <div class="row">
                        <div class="col-sm-2 bold">
                            <div class="title">Text</div>
                        </div>
                        <div class="col-sm-10">
                            <span data-ng-show="selectedPickList.InUse">{{selectedPickList.Text}}</span>
                            <input style="width:300px" data-ng-hide="selectedPickList.InUse" type="text" data-ng-model="selectedPickList.Text" required maxlength="50" />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="col-sm-2 bold">
                            <div class="title">Is Active</div>
                        </div>
                        <div class="col-sm-10">
                            <input type="checkbox" data-ng-model="selectedPickList.IsActive" />
                        </div>
                    </div>
                    <div class="form-row" data-ng-show="showParent">
                        <div class="col-sm-2 bold">
                            <div class="title">Parents</div>
                        </div>
                        <div class="col-sm-10">
                            <select size="{{parents.length}}" data-ng-show="allowMultipleParents" multiple data-ng-required data-ng-model="selectedPickList.ParentIds">
                                <option data-ng-repeat="parent in parents" data-ng-value="{{parent.Value}}">{{parent.Text}}</option>
                            </select>
                            <select data-ng-hide="allowMultipleParents" data-ng-required data-ng-model="selectedPickList.ParentId">
                                <option data-ng-repeat="parent in parents" data-ng-value="{{parent.Value}}">{{parent.Text}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="col-sm-12 bold">
                            <hr/>
                            <button name="save-button" data-ng-click="savePickList()" class="ies-action" type="submit">Save</button>&nbsp;&nbsp;
                            <button name="cancel-button" data-ng-click="cancel()" class="ies" type="button">Cancel</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>