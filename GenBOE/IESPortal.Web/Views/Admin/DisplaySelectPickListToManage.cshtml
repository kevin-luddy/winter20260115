@model ICollection<SelectListItem>
@using IES.Common;
@{
    ViewBag.Title = "Select Pick Lists";
    Layout = "~/Views/Admin/_Layout.cshtml";
}

<script type="text/javascript">
</script>

<div class="module">
    <div class="module-header-data">Manage Pick Lists</div>
    <div class="module-content-data">
        <div>
            @foreach (SelectListItem item in Model)
            {
                <div style="padding-bottom:10px;">
                    @Html.ActionLink("Manage " + item.Text, IESWebConstants.DISPLAY_MANAGE_PICK_LISTS, new { pickListType = item.Value })
                </div>
            }
        </div>
    </div>
</div>