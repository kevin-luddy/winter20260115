@model IReadOnlyCollection<BannerModelView>
@using IES.DataBridge.ModelViews;
@using IES.Common;
@using Newtonsoft.Json
@{
    ViewBag.Title = "Banners";
    Layout = "~/Views/Admin/_Layout.cshtml";
}
<script type="text/javascript">
    angular.module('portal').value('BannerGridView',
    {
        controller: '@IESWebConstants.CONTROLLER_ADMIN',
        deleteAction: '@IESWebConstants.ACTION_DELETE_BANNER',
        editAction: '@IESWebConstants.ACTION_EDIT_BANNER',
        baseUrl: '@Url.Content("~/")',
        data: @Html.Raw(JsonConvert.SerializeObject(Model))
    });
</script>
<div data-ng-app="portal" data-ng-controller="bannersController">
    <div class="module">
        <div class="module-header-data left">
            Banners
        </div>
        <div class="module-content-data black">
            <div class="left">
                <button data-ng-hide="isAdding" id="AddButton-NewBanner" class="ies-action buttons" data-ng-click="addBanner()" data-ng-cloak type="button">+ Add</button>
            </div>
            <table class="table table-striped table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Delete</th>
                        <th>Selected Apps</th>
                        <th>Start showing Banner</th>
                        <th>End of Warning or <br/>Start of Maintenance</th>
                        <th>Warning/Maintenance</th>
                        <th>Banner Text</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (BannerModelView banner in Model)
                    {
                        DateTime endTime = banner.StartDate.AddHours(banner.HoursToShow);
                        MvcHtmlString text = new MvcHtmlString(banner.BannerText);
                        <tr>
                            <td><a class="btn btn-danger btn-xs delete-button" title="Delete Banner" data-nodrag data-ng-click="deleteBanner(@banner.Id)"><span class="glyphicon glyphicon-remove"></span></a></td>
                            <td><a href="/@IESWebConstants.CONTROLLER_ADMIN/@IESWebConstants.ACTION_EDIT_BANNER/@banner.Id">@string.Join(", ", banner.SelectedApps)</a></td>
                            <td>@banner.StartDateAsString</td>
                            <td>@(banner.HoursToShow > 0 ? endTime.ToShortDateString() + " " + endTime.ToShortTimeString() : "No End Date")</td>
                            <td>@(banner.TurnOffTicker ? "Warning" : "Maintenance")</td>
                            <td style="text-align:left">@text</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>