@model BannerModelView
@using IES.DataBridge.ModelViews;
@using IES.Common;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Admin/_Layout.cshtml";
}
<script type="text/javascript">
    angular.module('portal').value('BannerModelView',
    {
        controller: '@IESWebConstants.CONTROLLER_ADMIN',
        saveBannerAction: '@IESWebConstants.ACTION_SAVE_BANNER',
        bannersView: '@IESWebConstants.VIEW_BANNERS',
        data: @Html.Raw(JsonConvert.SerializeObject(Model))
        });
</script>
<div data-ng-app="portal" data-ng-controller="editBannerController">
    <div class="row top-margin-2">
        <div class="col-md-12">
            <div class="module">
                <div class="module-header-data left">
                        Edit Banner
                </div>
                <div class="module-content-data black">
                    <form name="bannerForm" id="bannerForm" data-ng-cloak>
                        <div class="form-row css3pie-position-fix">
                            <div gen-validation data-errors="$root.errors"></div>
                        </div>
                        <div class="form-row row">
                            <div class="col-md-2">
                                <div class="form-label">Selected Apps</div>
                            </div>
                            <div class="col-md-10">
                                <div data-ng-repeat="item in selectedApps">
                                    <input type="checkbox" checklist-value="item.Value" checklist-model="model.SelectedApps" name="SelectedApps" id="SelectedApp_{{item.Value}}" />
                                    <label for="SelectedApp_{{item.Value}}">{{item.Text}}</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-row row">
                            <div class="col-md-2 topButtons">
                                <div class="form-label">Start Date *</div>
                            </div>
                            <div class="col-md-10 topButtons">
                                <div class="row">
                                    <div class="col-md-4">
                                        <p class="input-group datepicker-padding">
                                            <input type="text" class="form-control" uib-datepicker-popup data-ng-change="resetEndDate()"
                                                    data-ng-model="date" is-open="popupDatePickerStart.opened"
                                                    datepicker-options="dateOptions" data-ng-required="true" close-text="Close" />
                                            <span class="input-group-btn">
                                                <button type="button" class="btn btn-default" data-ng-click="openDatePickerStart()"><i class="glyphicon glyphicon-calendar"></i></button>
                                            </span>
                                        </p>
                                    </div>
                                    <div class="col-md-5 timepicker-padding">
                                        <div uib-timepicker ng-model="time" hour-step="1" minute-step="15" data-ng-change="resetEndDate()" show-meridian="true"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-row row">
                            <div class="col-md-2 topButtons">
                                <div class="form-label" data-ng-hide="model.TurnOffTicker">Date when Maintenace starts</div>
                                <div class="form-label" data-ng-show="model.TurnOffTicker">Date when Warning stops</div>
                            </div>
                            <div class="col-md-10 topButtons">
                                {{offset}}
                            </div>
                        </div>
                        <div class="form-row row">
                            <div class="col-md-2">
                                <div class="form-label">Hours to Show</div>
                            </div>
                            <div class="col-md-10">
                                <input data-ng-model="model.HoursToShow" type="number" data-ng-change="resetEndDate()" data-ng-required="true" />
                                <br/>
                                <span class="small">Note: Put -1 for a Warning Banner to always show</span>
                            </div>
                        </div>
                        <div class="form-row row">
                            <div class="col-md-2">
                                <div class="form-label">Warning Banner?</div>
                            </div>
                            <div class="col-md-10">
                                <input type="checkbox" data-ng-model="model.TurnOffTicker" />
                            </div>
                        </div>
                        <div class="form-row row" data-ng-show="model.TurnOffTicker">
                            <div class="col-md-2">
                                <div class="form-label">Banner Text</div>
                            </div>
                            <div class="col-md-10">
                                <textarea data-ng-model="model.BannerText" rows="5" style="width:100%" data-ng-required="model.TurnOffTicker"></textarea>
                                <br/>
                                <span class="small">Note: Html tags are allowed in the Banner Text like &lt;strong&gt; and &lt;big&gt;</span>
                            </div>
                        </div>
                        <hr style="margin-top:0"/>
                        <div class="action-buttons">
                            <button data-ng-hide="isSaving" id="SaveButton-Banner" type="submit" class="ies-action" data-ng-click="saveBanner()" data-ng-disabled="isDataLoading || !bannerForm.$dirty">Save</button>
                            <button data-ng-show="isSaving" class="ies-action"><div class="loader"></div></button>
                            <button id="CancelButton-Banner" type="button" class="ies" data-ng-click="cancel()" data-ng-disabled="isDataLoading">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
