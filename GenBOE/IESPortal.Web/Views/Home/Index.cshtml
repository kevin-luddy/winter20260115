<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>IES</title>
    @Scripts.Render("~/bundles/jquery")
    @Styles.Render("~/Content/css")
    <script type="text/javascript">
        underConstructionAlert = function () {
            alert("Under Construction");
        }

        cur = function () {
                $('body').toggleClass('cur');
        }

        var carouselRunning = false;
    </script>
    <style type="text/css">
        body.cur {cursor: url(/Content/images/sat.png), default !important;}
    </style>

    <script type="text/javascript">
        // This script is used to prevent cross-frame attacks
        if (top.frames.length != 0) {
            top.location = self.document.location;
        }
    </script>
</head>
<body>
    <div class="container lmpi-header">
        <div id="lmpi">Lockheed Martin Proprietary Information</div>
    </div>
    @{Html.RenderAction("HeaderInternal", "Home");}
    @{Html.RenderAction("BannerInternal", "Home", new {active = "BOESSC,PTM,RDM,RDSB,RPM,IESPortal" });}
    <div class="container">
        <!--ies-home-->
        <div id="ies-home" style="">
            <div class="row row-centered">
                <div class="col-sm-2">
                </div>
                <div class="col-sm-8">
                    <div id="logo-header">
                        <div class="carouselDiv">
                            <div id="myCarousel" class="carousel slide">
                                <!-- Indicators -->
                                @if (ViewBag.ShowCarousel)
                                {
                                    <ol class="carousel-indicators">
                                        <li data-target="#myCarousel" data-slide-to="0" class="active"></li>
                                        <li data-target="#myCarousel" data-slide-to="1"></li>
                                        <li data-target="#myCarousel" data-slide-to="2"></li>
                                        <li data-target="#myCarousel" data-slide-to="3"></li>
                                        <li data-target="#myCarousel" data-slide-to="4"></li>
                                        <li data-target="#myCarousel" data-slide-to="5"></li>
                                        <li data-target="#myCarousel" data-slide-to="6"></li>
                                    </ol>
                                }
                                <!-- Wrapper for slides -->
                                <div class="carousel-inner">
                                    <div class="item active">
                                        <img src="~/Content/images/IES_logo.png" style="margin: auto;">
                                    </div>
                                    @if (ViewBag.ShowCarousel)
                                    {
                                        <div class="item">
                                            <img src="~/Content/images/astronaut/astronaut2.png" style="margin: auto;">
                                        </div>

                                        <div class="item">
                                            <img src="~/Content/images/astronaut/astronautglow.png" style="margin: auto;">
                                        </div>

                                        <div class="item">
                                            <img src="~/Content/images/astronaut/astronautstarwars.png" style="margin: auto;">
                                        </div>

                                        <div class="item">
                                            <img src="~/Content/images/astronaut/comicbookastronaut.png" style="margin: auto;">
                                        </div>

                                        <div class="item">
                                            <img src="~/Content/images/astronaut/oilPaintingastronaut.png" style="margin: auto;">
                                        </div>

                                        <div class="item">
                                            <img src="~/Content/images/astronaut/oldtimeyastronaut.png" style="margin: auto;">
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-2">
                    <img src="~/Content/images/LM_logo_notagline_black.png" alt="Lockheed Martin logo" style="width:200px" />
                </div>
            </div>
            <div class="button-row">
                <a href="@ViewBag.PTMUrl"><img class="button-img" src="~/Content/images/logo_PTM.jpg" alt="Proposal Tracking Module" /></a>
            </div>
            <div class="button-row">
                @if (ViewBag.showLogoBoeFrank)
                {
                    <a href="@ViewBag.BOEUrl"><img class="button-img" src="~/Content/images/logo_BOE_Frank.jpg" alt="Basis of Estimate" /></a>
                }
                else
                {
                    <a href="@ViewBag.BOEUrl"><img class="button-img" src="~/Content/images/logo_genBOE.jpg" alt="Basis of Estimate" /></a>
                }
                <a href="@ViewBag.PPUrl" target="_blank"><img class="button-img" src="~/Content/images/logo_ProPricer.jpg" alt="PROPRICER" /></a>
            </div>
            <div class="button-row">
                <a href="@ViewBag.RDMUrl"><img class="button-img" src="~/Content/images/logo_RDM.jpg" alt="Rates and Disclosure Module" /></a>
                <a href="@ViewBag.RDSBUrl"><img class="button-img" src="~/Content/images/logo_RDSB.jpg" alt="Rates &amp; Disclosure Section Builder" /></a>
                <a href="@ViewBag.RPMUrl"><img class="button-img" src="~/Content/images/logo_RPM.jpg" alt="Resource Planning Module" /></a>
            </div>
            <div class="button-row">
                <div class="button-img"></div>
                @*<a href="@ViewBag.eEPPUrl">*@
                <a>
                    <img class="button-img eeppLogo" src="~/Content/images/logo_ComingSoon.png" alt="Electronic Executive Planning Panel" />
                </a>
            </div>
        </div>
        <footer>
            <div class="footerVersionInfo" onclick="cur()">@IES.Common.Utilities.VersionAndUpdatedDate</div>
        </footer>
    </div><!-- /.container -->
    @if (ViewBag.ShowCarousel)
    {
    <script>
        $(function () {
            $(".carousel-inner").click(function () {
                carouselRunning = !carouselRunning;
                if (carouselRunning) {
                    $("#myCarousel").carousel(1);
                } else {
                    $("#myCarousel").carousel('pause');
                    $("#myCarousel").carousel(0);
                }
            });
        });
    </script>
    }
</body>
</html>