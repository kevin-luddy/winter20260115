@model ICollection<BannerModelView>
@using IES.DataBridge.ModelViews
@Styles.Render("~/Content/bannerCss")
<script src="~/Scripts/moment.js"></script>
<script src="/Scripts/maintenanceBanner.js"></script>
<script type="text/javascript">
    function resize() {
        var totalHeight = 4;
        $("#bannerContainer").children('div').each(function(){
            totalHeight += $(this).outerHeight(true); // true = include margins
        });
            
        parent.postMessage(["setHeight", totalHeight], "*"); 
    }
</script>
<div class="bannerBody" onLoad="resize();">
    <div id="bannerContainer" class="bannerContainer">
    @foreach(BannerModelView banner in Model)
    {
        if (banner.TurnOffTicker)
        {
            string appNames = ViewBag.IsMultipleApps ? string.Join(", ", banner.SelectedApps) + ": " : string.Empty;
            MvcHtmlString text = new MvcHtmlString(banner.BannerText);
            <div class="WarningBanner">
                <span style="white-space: pre-line">@appNames@text</span>
            </div>
        } else
        {
            string appNames = ViewBag.IsMultipleApps ? string.Join(", ", banner.SelectedApps) : string.Empty;
            <div class="MaintenanceBanner">
                <span id="maintenanceTime_@banner.Id"></span>
                <br/>
                <span>Please finish and save your work before the timer runs out: </span>
                <span id="maintenanceCountdownTimer_@banner.Id" class="maintenanceCountdownTimer"></span>
            </div>
            <script type="text/javascript">
                var banner = new maintenanceBanner($('#maintenanceTime_@banner.Id'), $('#maintenanceCountdownTimer_@banner.Id'), '@banner.StartDateAsString', @banner.HoursToShow, '@appNames');
            </script>
        }
    }
    </div>
</div>