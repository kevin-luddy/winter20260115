@inherits System.Web.Mvc.WebViewPage<IES.DataBridge.ModelViews.DocumentDetailModelView>
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script type="text/javascript">
    angular.module('rdsb').value('DocumentDetailModelView',
    {
        controller: '@IESWebConstants.CONTROLLER_DOCUMENT',
        publishAction: '@IESWebConstants.ACTION_PUBLISH_DOCUMENT',
        saveDocumentAction: '@IESWebConstants.ACTION_SAVE_DOCUMENT',
        getSectionsForRevisionAction: '@IESWebConstants.ACTION_GET_SECTIONS_FOR_REVISION',
        getRatesForRevisionAction: '@IESWebConstants.ACTION_GET_RATE_CODES_FOR_REVISION',
        data: @Html.Raw(JsonConvert.SerializeObject(Model))
    });
</script>
<div data-ng-app="rdsb" data-ng-controller="editDocumentController">
    <div class="row top-margin-2">
        <div class="col-md-12">
            <div class="module">
                <div class="module-header-data left">
                        Edit Document
                </div>
                <div class="module-content-data black">
                    <form name="documentForm" id="documentForm" data-ng-cloak>
                        <div class="form-row css3pie-position-fix">
                            <div gen-validation data-errors="$root.errors"></div>
                        </div>
                        <fieldset>
                            <legend>Proposal</legend>
                            <div class="form-row row no-top-margin">
                                <div class="col-md-2 topButtons">
                                    <span class="form-label">Tracking Number: </span>@Model.TrackingNumber
                                </div>
                                <div class="col-md-2 topButtons">
                                    <span class="form-label">Proposal Status: </span>@Model.ProposalStatus
                                </div>
                                <div class="col-md-2 topButtons">
                                    <span class="form-label">Proposal Title: </span>@Model.ProposalTitle
                                </div>
                            </div>
                        </fieldset>
                        <fieldset>
                            <legend>PPR&amp;D Revision</legend>
                            <div class="form-row row">
                                <div class="col-md-4">
                                    <select id="revisionSelect" class="form-control" data-ng-change="revisionChanged()" data-ng-options="item.Id as item.Label for item in model.AvailableRevisions" data-ng-model="model.SelectedRevisionId"></select>
                                </div>
                                <div class="col-md-1 topButtons">
                                    <div class="form-label">Start Year *</div>
                                </div>
                                <div class="col-md-2 topButtons">
                                    <p class="input-group">
                                        <input type="text" class="form-control" uib-datepicker-popup="yyyy"
                                               data-ng-model="start" is-open="popupDatePickerStart.opened"
                                               datepicker-options="dateOptions" date-disabled="disabled(date, mode)" data-ng-required="true" close-text="Close" />
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-default" data-ng-click="openDatePickerStart()"><i class="glyphicon glyphicon-calendar"></i></button>
                                        </span>
                                    </p>
                                </div>
                                <div class="col-md-1 topButtons">
                                    <div class="form-label">End Year *</div>
                                </div>
                                <div class="col-md-2 topButtons">
                                    <p class="input-group">
                                        <input type="text" class="form-control" uib-datepicker-popup="yyyy"
                                               data-ng-model="end" is-open="popupDatePickerEnd.opened"
                                               datepicker-options="dateOptions" date-disabled="disabled(date, mode)" data-ng-required="true" close-text="Close" />
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-default" data-ng-click="openDatePickerEnd()"><i class="glyphicon glyphicon-calendar"></i></button>
                                        </span>
                                    </p>
                                </div>
                            </div>
                        </fieldset>
                        <fieldset>
                            <legend>Direct Labor Rate Selection</legend>
                            <div class="form-row row">
                                <div class="col-md-3">
                                    <input type="text" placeholder="Filter Rates" data-ng-model="searchTerm" data-ng-change="searchRates()" ignore-dirty />
                                </div>
                                <div class="col-md-4 col-md-offset-5">
                                    <div class="form-label">Selected Rates</div>
                                </div>
                            </div>
                            <div class="form-row row">
                                <div class="col-md-3">
                                    <select id="rateSelect" multiple class="form-control" data-ng-model="selectedRates" ignore-dirty>
                                        <option ng-repeat="rate in filteredRates" title="{{rate.RateCode}} {{rate.Description}}">{{rate.RateCode}}</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <textarea id="pastedText" placeholder="Paste Rate Codes here" draggable="false" data-ng-model="pastedText" maxlength="5000" cols="8" ignore-dirty></textarea>
                                </div>
                                <div class="col-md-6">
                                    <div class="well selectedRates">
                                        <div class="row top-margin-2" data-ng-repeat="rate in allRates | filter:{IsSelected:true}">
                                            <div class="col-md-11 rate clip" title="{{rate.RateCode}} {{rate.Description}}"><div class="rateCode">{{rate.RateCode}}</div>{{rate.Description}}</div>
                                            <div class="col-md-1">
                                                <a class="btn btn-danger btn-xxs delete-rate" title="Deselect Rate" data-nodrag data-ng-click="deselectRate(rate); documentForm.$setDirty();"><span class="glyphicon glyphicon-remove"></span></a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-row row">
                                <div class="col-md-3">
                                    <button id="AddRatesButton" title="Add Rate Codes selected in dropdown above" data-ng-disabled="isDataLoading || !selectedRates || selectedRates.length < 1" data-ng-click="addRates(); documentForm.$setDirty();" type="button" class="ies">Add Rates</button>
                                </div>
                                <div class="col-md-3">
                                    <button id="SelectButton" title="Add Rate Codes pasted above" data-ng-disabled="isDataLoading || pastedText.length < 1" data-ng-click="addPastedRates(); documentForm.$setDirty();" type="button" class="ies">Add Pasted Rates</button>
                                </div>
                                <div class="col-md-6">
                                    <button id="DeselectRatesButton" title="Clear all Selected Rates" data-ng-disabled="isDataLoading || (allRates | filter:{IsSelected:true}).length < 1" data-ng-click="clearRates(); documentForm.$setDirty();" type="button" class="ies">Clear Rates</button>
                                </div>
                            </div>
                        </fieldset>
                        <fieldset>
                            <legend>PPR&amp;D Section Selection</legend>

                            <div class="form-row row">
                                <div class="col-md-8 inline css3pie-position-fix sectionButtons">
                                    <button id="ExpandAllButton" data-ng-click="expandAll()" data-ng-disabled="isDataLoading" type="button" class="ies">Expand All</button>
                                    <button id="CollapseAllButton" data-ng-click="collapseAll()" data-ng-disabled="isDataLoading" type="button" class="ies">Collapse All</button>
                                    <div class="form-label">Available Sections</div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-label">Selected Sections</div>
                                </div>
                            </div>
                            <div class="form-row row">
                                <div class="col-md-6 well allSections">
                                    <div data-ng-repeat="section in allSections" class="clip" title="{{section.Title}}">
                                        <a class="btn btn-success btn-xxs" data-ng-if="section.HasChildren" data-nodrag="" data-ng-click="toggle(section)">
                                            <span class="glyphicon glyphicon-chevron-right" data-ng-class="{'glyphicon-chevron-right': section.Collapsed, 'glyphicon-chevron-down': !section.Collapsed}" style=""></span>
                                        </a>
                                        <input type="checkbox" data-ng-class="{'childless0': !section.HasChildren}" data-ng-change="checkboxUpdate(section)" data-ng-disabled="section.Locked || section.HasRate || section.IsRdsbRequired" data-ng-model="section.IsSelected" />
                                        <div class="refNum">{{section.ReferenceNumber}}</div>
                                        <span class="glyphicon glyphicon-list-alt" data-ng-show="section.HasTable" title="Includes Rate Table"></span> {{section.Title}}
                                        <br />
                                        <div data-ng-class="{'display-none':section.Collapsed}">
                                            <div data-ng-repeat="childSection in section.ChildNodes" class="clip" title="{{childSection.Title}}">
                                                <a class="btn btn-success btn-xxs expandChild" data-ng-if="childSection.HasChildren" data-nodrag="" data-ng-click="toggle(childSection)">
                                                    <span class="glyphicon glyphicon-chevron-right" data-ng-class="{'glyphicon-chevron-right': childSection.Collapsed, 'glyphicon-chevron-down': !childSection.Collapsed}" style=""></span>
                                                </a>
                                                <input type="checkbox" data-ng-class="{'childless1': !childSection.HasChildren, 'child1': childSection.HasChildren}" data-ng-change="checkboxUpdate(childSection)" data-ng-disabled="childSection.Locked || childSection.HasRate || childSection.IsRdsbRequired" data-ng-model="childSection.IsSelected" />
                                                <div class="refNumChild1">{{childSection.ReferenceNumber}}</div>
                                                <span class="glyphicon glyphicon-list-alt" data-ng-show="childSection.HasTable" title="Includes Rate Table"></span> {{childSection.Title}}
                                                <br />
                                                <div data-ng-class="{'display-none':childSection.Collapsed}">
                                                    <div data-ng-repeat="child in childSection.ChildNodes" class="clip" title="{{child.Title}}">
                                                        <input type="checkbox" class="childless2" data-ng-change="checkboxUpdate(child)" data-ng-disabled="child.HasRate || child.IsRdsbRequired" data-ng-model="child.IsSelected" />
                                                        <div class="refNumChild2">{{child.ReferenceNumber}}</div>
                                                        <span class="glyphicon glyphicon-list-alt" data-ng-show="child.HasTable" title="Includes Rate Table"></span> {{child.Title}}
                                                        <br />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-5 well flatSections offset-half">
                                    <div class="clip" data-ng-repeat="flatSection in flatSections | filter:{IsSelected:true}" data-ng-class="{'level1': flatSection.Level == 1, 'level2': flatSection.Level == 2}">
                                        <div data-ng-class="{'refNumSelected': flatSection.Level != 2,'refNumChild2Selected': flatSection.Level == 2}">{{ model.ParentSection ? model.ParentSection + '.' : ''}}{{flatSection.ReferenceNumber}}&nbsp;</div>
                                        <span class="glyphicon glyphicon-list-alt" data-ng-show="flatSection.HasTable" title="Includes Rate Table"></span>
                                        <span class="clip" title="{{ model.ParentSection ? model.ParentSection + '.' : ''}}{{flatSection.Title}}">{{flatSection.Title}}</span>
                                        <br />
                                    </div>
                                </div>
                            </div>
                            <div class="form-row row">
                                <div class="col-md-6">
                                    <span>Section Prefix: </span><span class="help-icon" title="Section Prefix allows up to 5 characters (i.e. 8.1) and automatically adds period to the end"></span>&nbsp;&nbsp;<input class="sectionPrefix" type="text" data-ng-model="model.ParentSection" maxlength="5" />
                                </div>
                            </div>
                        </fieldset>
                        <hr style="margin-top:0"/>
                        <div>
                            <button data-ng-hide="isSaving" id="SaveButton-Document" type="submit" class="ies-action" data-ng-click="saveDocument()" data-ng-disabled="isDataLoading || !documentForm.$dirty">Save</button>
                            <button data-ng-show="isSaving" class="loader ies-action"></button>
                            <button id="CancelButton-Document" type="button" class="ies" data-ng-click="cancel()" data-ng-disabled="isDataLoading">Cancel</button>
                            <button ng-if="!@IES.Common.ConfigurationUtilities.GetAppSetting("HideNonPortionMarking")"
                                    class="ies-action"
                                    id="DownloadButton-Document"
                                    type="button"
                                    data-ng-disabled="isDataLoading || documentForm.$dirty"
                                    data-ng-click="documentForm.$dirty || publishDocument(null, false)">
                                Download
                            </button>
                            <button ng-if="!@IES.Common.ConfigurationUtilities.GetAppSetting("HidePortionMarking")"
                                    id="DownloadPortionMarkedButton-Document"
                                    class="ies-action"
                                    type="button"
                                    data-ng-disabled="isDataLoading || documentForm.$dirty"
                                    data-ng-click="documentForm.$dirty || publishDocument(null, true)">
                                Download Portion Marked
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
