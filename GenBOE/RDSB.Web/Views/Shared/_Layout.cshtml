<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/angularapp")
    @Scripts.Render("~/bundles/site")
    <script>
        $(document).bind('DISPLAY_NOTIFICATION', function (event, text) {
            $('#Notification div.text').html(text);
            $('#Notification').removeClass('display-none');
            $('html, body').animate({ scrollTop: $("#Notification").offset().top }, 200);
        });
        function CloseNotification(){
            $('#Notification').addClass('display-none');
        };
    </script>
    <script type="text/javascript">
        // This script is used to prevent cross-frame attacks
        if (top.frames.length != 0) {
            top.location = self.document.location;
        }
    </script>
</head>
<body class="home">
    @if (IdentitySwap.IdentitySwappingForTesting.IsIdentitySwappingAllowed("IsIdentitySwappingAllowed", "ActiveDirectoryPath", "ADGroupsAllowedToSwapIdentity"))
    {
        <div id="IdentitySwappingDiv">
            <script src="@Url.Content("~/Scripts/IdentitySwappingScript.js")" type="text/javascript"></script>
        </div>
    }

    <div class="navbar navbar-fixed-top">
        <div class="lmproprietary">Lockheed Martin Proprietary Information </div>
        <iframe class="iframe" src="@ConfigurationUtilities.IESHeaderUrl("RDSB")"></iframe>
    </div>
    <div class="body-content">
        <div class="rdsb-logo-div">
            <a href="/"><img src="~/Content/images/logo_RDSB_wide.jpg" class="rdsb-logo" /></a>
            @if (!Utilities.IsProduction())
            {
                <span style="font-weight:bold;">
                    @("Username : " + System.Threading.Thread.CurrentPrincipal.Identity.Name)
                </span>
            }
            <img src="~/Content/images/LM_logo_notagline_black.png" alt="Lockheed Martin logo" class="lmlogo" />
        </div>
        <div class="bannerContainer">
            <iframe class="bannerframe" src="@ConfigurationUtilities.IESBannerUrl("RDSB")"></iframe>
        </div>
        @RenderBody()
    </div>
    <div class="lmproprietary">
        Lockheed Martin Proprietary Information
        <div class="footerVersionInfo">@IES.Common.Utilities.VersionAndUpdatedDate</div>
    </div>
    <div id="ExceptionDialog" style="display: none; text-align: center;">
        <div id="ErrorText" class="dialog-text">
            Replace me!
            <br />
        </div>
        <span id="ToggleErrorDetails" onclick="$('#ErrorDetails').toggle('slow')" class="underline pointer">Error Details</span>
        <div id="ErrorDetails" class="error-details">
            Replace me!
            <br />
            <br />
        </div>
        <br />
        <br />
        <div class="error-buttons">
            <button type="button" onclick="CloseExceptionDialog();" class="ies css3pie-position-fix"> OK </button>
        </div>
    </div>
    <div id="CommonDialog" style="display: none; text-align: center;">
        <div id="CommonDialogBody" class="dialog-text">
            <br />
        </div>
        <div class="buttons">
        </div>
    </div>
    <div id="UnderConstruction" style="display: none; text-align: center;" title="Under Construction">
        <br />
        <p style="font-size:20px"><span class="glyphicon glyphicon-alert text-danger"></span> This page is Under Construction <span class="glyphicon glyphicon-alert text-danger"></span></p>
    </div>
    <div id="PageLoading" class="page-loading display-none">
        <div class="loading-box">
            <div class="loader white"></div>
            <span>Loading...</span>
        </div>
    </div>
    <div id="Notification" class="notification-bar display-none">
        <div class="notification">
            <div style="float:left" class="text">Notify Me!</div>&nbsp;
            <div style="float:right" id="MessageClose" onclick="CloseNotification();" class="button message-close-button"></div>&nbsp;
        </div>
    </div>
    <iframe class="appOfflineFrame" src="@ConfigurationUtilities.AppOfflineUrl("RDSB")"></iframe>
    @RenderSection("scripts", required: false)
    @if (!IES.Common.Utilities.DisablePiwik())
    {
        <!-- Piwik Statistics -->
        <script type="text/javascript">
            window.piwikAsyncInit = function () {
                try {
                    @if (IES.Common.Utilities.IsProduction())
                    {
                        <text>
                        var piwikTracker = Piwik.getTracker(pkBaseURL + "piwik.php", 25); //<!-- BusApps Rollup -->
                        piwikTracker.setDocumentTitle(document.domain + "/" + document.title);
                        piwikTracker.trackPageView();
                        piwikTracker.enableLinkTracking();

                        var piwikTracker1 = Piwik.getTracker(pkBaseURL + "piwik.php", 91); //<!-- Space Rollup -->
                        piwikTracker1.setDocumentTitle(document.domain + "/" + document.title);
                        piwikTracker1.trackPageView();
                        piwikTracker1.enableLinkTracking();

                        var piwikTracker2 = Piwik.getTracker(pkBaseURL + "piwik.php", 94); //<!-- Space Business Systems -->
                        piwikTracker2.setDocumentTitle(document.domain + "/" + document.title);
                        piwikTracker2.trackPageView();
                        piwikTracker2.enableLinkTracking();
                        </text>
                    }

                    var piwikTracker3 = Piwik.getTracker(pkBaseURL + "piwik.php", @IES.Common.Utilities.PiwikId());          //<!-- Space RDSB  -->
                    var currentUser = '@IES.Common.Utilities.CurrentUser()';
                    // Track each user's visit
                    piwikTracker3.setCustomVariable(1, "User Account", currentUser, "visit");
                    piwikTracker3.setDocumentTitle(document.domain + "/" + document.title);
                    piwikTracker3.trackPageView();
                    piwikTracker3.enableLinkTracking();
                } catch( err ) {}
            };
        </script>
        <noscript>
            <p><img src="https://techopstoolbox.global.lmco.com/piwik/piwik.php?idsite=25" style="border:0" alt="Piwik"></p>
            <p><img src="https://techopstoolbox.global.lmco.com/piwik/piwik.php?idsite=91" style="border:0" alt="Piwik"></p>
            <p><img src="https://techopstoolbox.global.lmco.com/piwik/piwik.php?idsite=94" style="border:0" alt="Piwik"></p>
            <p><img src="https://techopstoolbox.global.lmco.com/piwik/piwik.php?idsite=@IES.Common.Utilities.PiwikId()" style="border:0" alt="Piwik"></p>

        </noscript>
        <script type="text/javascript">
        var pkBaseURL = "@IES.Common.Utilities.PiwikUrl()";
        document.write(unescape("%3Cscript src='" + pkBaseURL + "piwik.js' type='text/javascript'%3E%3C/script%3E"));
        </script>
        <!-- End Piwik Statistics Code -->
    }
</body>
</html>
