      <DTS:ObjectData>
        <pipeline
          BLOBTempStoragePath=""
          bufferTempStoragePath=""
          engineThreads="5"
          version="1">
          <components>
            <component
              refId="Package\Load Employee Processing\DataMartPull"
              componentClassID="DTSAdapter.OLEDBSource.3"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SqlServer v10; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="DataMartPull"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=11.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT DISTINCT

RTRIM(g.empl_ser_no) AS empl_ser_no,
RTRIM(n.empl_tl_nm) AS empl_tl_nm,
RTRIM(n.empl_first_nm) AS empl_first_nm,
RTRIM(n.empl_mi_nm) AS empl_mi_nm,
RTRIM(n.empl_last_nm) AS empl_last_nm,
RTRIM(n.empl_gq_nm) AS empl_gq_nm,
RTRIM(s.nt_account_nm) AS nt_account_nm,
RTRIM(s.nt_domain_nm) AS nt_domain_nm,
RTRIM(o.rpt_to_ser_no) AS rpt_to_ser_no,
RTRIM(o.dept_no) AS dept_no,
CASE 
	WHEN RTRIM(d.dept_tl) IS NULL OR RTRIM(d.dept_tl) = '' THEN '(' + n.empl_last_nm + ', ' + SUBSTRING(n.empl_first_nm, 0, 15) + ')'
	ELSE RTRIM(d.dept_tl) 
END AS dept_tl,
SUBSTRING(o.job_cd, 5, 1) AS job_level,
RTRIM(o.job_cd) AS job_cd,
RTRIM(g.job_tl) AS job_tl,

RTRIM(s.email_adr) AS email_adr,
RTRIM(w.work_phone_no) AS work_phone_no,
RTRIM(g.empl_stat_cd) AS empl_stat_cd,
CAST(ROUND(CAST(ISNULL(LTRIM(RTRIM(o.empl_std_hrs)),0.0)AS float)/40, 2) AS DECIMAL(3,2)) AS empl_std_hrs,
RTRIM(o.pstn_no) AS pstn_no,
ISNULL(dr.num, 0) AS direct_report_no,
ISNULL( LTRIM (RTRIM(d.pool_cd)), '') AS pool_cd,
RTRIM(w.separation_dt) AS separation_dt,
getDate() AS [TimeStamp],
RTRIM(o.service_dt) AS service_dt,
RTRIM(s.gal_label) AS gal_label,
RTRIM(n.empl_called_by_nm) AS empl_called_by_nm,
/*RTRIM(o.dept_setid_no) AS dept_setid_no,*/
RTRIM(w.bldg_no)  AS bldg_no,
RTRIM(w.office_no) AS office_no,
	CASE 
		WHEN LEFT(RTRIM(o.job_cd)/*JobCode*/, 1) = 'N' THEN 0	
          -- N = Non-Exempt - relates to enum in code
		WHEN LEFT(RTRIM(o.job_cd)/*JobCode*/, 1) = 'B' THEN 0	
          -- B = Non-Exempt - relates to enum in code
        WHEN LEFT(RTRIM(o.job_cd)/*JobCode*/, 1) = 'W' THEN 0	
          -- W = Non-Exempt - relates to enum in code
		WHEN LEFT(RTRIM(o.job_cd)/*JobCode*/, 1) = 'E' THEN 1	
           -- E = Exempt - relates to enum in code
		WHEN LEFT(RTRIM(o.job_cd)/*JobCode*/, 1) = 'L' THEN 1	
            -- L = Exempt Leaders - relates to enum in code
		ELSE 1					
           -- Default unknown as exempt since this accounts for 90% of our workforce
	END AS FLSAStatus,
	

RTRIM(w.work_cntry_cd) AS work_country_cd,
      CASE  WHEN RTRIM(w.work_cntry_cd) = 'US' THEN 'United States'
                  WHEN RTRIM(w.work_cntry_cd) = 'GB' THEN 'Great Britain'
                  WHEN RTRIM(w.work_cntry_cd) = 'AU' THEN 'Australia'
                  WHEN RTRIM(w.work_cntry_cd) = 'CA' THEN 'Canada'
                  WHEN RTRIM(w.work_cntry_cd) = 'NZ' THEN 'New Zealand'
/*                  WHEN RTRIM(w.work_cntry_cd) = 'DE' THEN 'Denmark'*/

                  WHEN RTRIM(w.work_cntry_cd) = 'DE' THEN 'Germany'
                  WHEN RTRIM(w.work_cntry_cd) = 'DK' THEN 'Denmark'


                  WHEN RTRIM(w.work_cntry_cd) = 'HK' THEN 'Hong Kong'
                  WHEN RTRIM(w.work_cntry_cd) = 'CH' THEN 'Switzerland'
                  WHEN RTRIM(w.work_cntry_cd) = 'TW' THEN 'Taiwan'
                  WHEN RTRIM(w.work_cntry_cd) = 'JP' THEN 'Japan'
                  WHEN RTRIM(w.work_cntry_cd) = 'AR' THEN 'Argentina'
                  WHEN RTRIM(w.work_cntry_cd) = 'SG' THEN 'Singapore'
                  WHEN RTRIM(w.work_cntry_cd) = 'IN' THEN 'India'
                  WHEN RTRIM(w.work_cntry_cd) = 'GR' THEN 'Greece'
                  WHEN RTRIM(w.work_cntry_cd) = 'RO' THEN 'Romania'
                  WHEN RTRIM(w.work_cntry_cd) = 'IS' THEN 'Iceland'
                  WHEN RTRIM(w.work_cntry_cd) = 'ES' THEN 'Spain'
                  WHEN RTRIM(w.work_cntry_cd) = 'IL' THEN 'Israel'
                  WHEN RTRIM(w.work_cntry_cd) = 'EG' THEN 'Egypt'
                  WHEN RTRIM(w.work_cntry_cd) = 'BE' THEN 'Belgium'
/*                  WHEN RTRIM(w.work_cntry_cd) = 'SA' THEN 'South Africa'*/

                  WHEN RTRIM(w.work_cntry_cd) = 'ZA' THEN 'South Africa'
                  WHEN RTRIM(w.work_cntry_cd) = 'SA' THEN 'Saudi Arabia'

                  WHEN RTRIM(w.work_cntry_cd) = 'MH' THEN 'Marshall Islands'
                  WHEN RTRIM(w.work_cntry_cd) = 'PL' THEN 'Poland'
                  WHEN RTRIM(w.work_cntry_cd) = 'IT' THEN 'Italy'
                  WHEN RTRIM(w.work_cntry_cd) = 'CN' THEN 'China'
                  WHEN RTRIM(w.work_cntry_cd) = 'AE' THEN 'United Arab Emirates'
                  WHEN RTRIM(w.work_cntry_cd) = 'MY' THEN 'Malaysia'
                  WHEN RTRIM(w.work_cntry_cd) = 'FR' THEN 'France'
                  WHEN RTRIM(w.work_cntry_cd) = 'AL' THEN 'Albania'
                  WHEN RTRIM(w.work_cntry_cd) = 'PH' THEN 'Philippines'
                  WHEN RTRIM(w.work_cntry_cd) = 'ID' THEN 'Indonesia'
                  WHEN RTRIM(w.work_cntry_cd) = 'TR' THEN 'Turkey (TR)'
   	  WHEN RTRIM(w.work_cntry_cd) = 'TU' THEN 'Turkey (TU)'
                  WHEN RTRIM(w.work_cntry_cd) = 'KR' THEN 'Korea (KR)' 
                  WHEN RTRIM(w.work_cntry_cd) = 'KO' THEN 'Korea (KO)'     
      ELSE RTRIM(w.work_cntry_cd) END AS work_cntry_name,
RTRIM(w.work_st_cd) AS work_st_cd,
CASE 
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) = 'AL' THEN 'Alabama'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'AK' THEN 'Alaska'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'AB' THEN 'Alberta'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'AS' THEN 'American Samoa'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'AZ' THEN 'Arizona'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'AR' THEN 'Arkansas'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'BC' THEN 'British Columbia'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'CA' THEN 'California'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'PW' THEN 'Caroline Islands'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'CO' THEN 'Colorado'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'CT' THEN 'Connecticut'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'DE' THEN 'Delaware'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'DC' THEN 'District of Columbia'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'FM' THEN 'Federated State'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'FL' THEN 'Florida'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'GA' THEN 'Georgia'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'GU' THEN 'Guam'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'HI' THEN 'Hawaii'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'ID' THEN 'Idaho'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'IL' THEN 'Illinois'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'IN' THEN 'Indiana'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'IA' THEN 'Iowa'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'KS' THEN 'Kansas'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'KY' THEN 'Kentucky'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'LA' THEN 'Louisiana'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'ME' THEN 'Maine'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'MB' THEN 'Manitoba'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'MP' THEN 'Marina Islands'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'MH' THEN 'Marshall Islands'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'MD' THEN 'Maryland'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'MA' THEN 'Massachusetts'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'MI' THEN 'Michigan'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'MN' THEN 'Minnesota'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'MS' THEN 'Mississippi'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'MO' THEN 'Missouri'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'MT' THEN 'Montana'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'NE' THEN 'Nebraska'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'NV' THEN 'Nevada'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'NB' THEN 'New Brunswick'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'NH' THEN 'New Hampshire'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'NJ' THEN 'New Jersey'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'NM' THEN 'New Mexico'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'NY' THEN 'New York'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'NF' THEN 'Newfoundland'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'NC' THEN 'North Carolina'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'ND' THEN 'North Dakota'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'NT' THEN 'Northwest Territories'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'NS' THEN 'Nova Scotia'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'NU' THEN 'Nunavut'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'OH' THEN 'Ohio'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'OK' THEN 'Oklahoma'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'ON' THEN 'Ontario'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'OR' THEN 'Oregon'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'PA' THEN 'Pennsylvania'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'PE' THEN 'Prince Edward Island'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'PR' THEN 'Puerto Rico'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'PQ' THEN 'Quebec'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'RI' THEN 'Rhode Island'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'SK' THEN 'Saskatchewan'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'SC' THEN 'South Carolina'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'SD' THEN 'South Dakota'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'TN' THEN 'Tennessee'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'TX' THEN 'Texas'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'UT' THEN 'Utah'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'VT' THEN 'Vermont'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'VI' THEN 'Virgin Islands'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'VA' THEN 'Virginia'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'WA' THEN 'Washington'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'WV' THEN 'West Virginia'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'WI' THEN 'Wisconsin'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'WY' THEN 'Wyoming'
WHEN RTRIM(w.work_cntry_cd) = 'US'  AND RTRIM(w.work_st_cd) =  'YT' THEN 'Yukon Terrirtory'
WHEN RTRIM(w.work_cntry_cd) &lt;&gt; 'US' THEN RTRIM(w.work_st_cd)
END AS 'State',
RTRIM(w.work_city_nm) AS work_city_nm/*w.work_lctn_cd--, w.work_lctn_desc*/,

O.[OPERATING_CMPT_CD],
O.[OPERATING_CMPT_DESC],
O.[FORMAL_DESC],
O.[TOP_TIER_OC_CD],
O.[TOP_TIER_DESC],
/*O.[BUS_AREA_CD],*/
O.[BUS_AREA_DESC],

/*D.[DEPT_SETID_NO],*/

SX.[BUS_AREA_CD],
SX.[DEPT_SETID_NO],

/*LU.[BUS_AREA_CD],*/
LU.[BUS_AREA_SHORT_NM],
LU.[BUS_AREA_LONG_NM]

FROM dbo.MRTTORG o 
	INNER JOIN dbo.MRTTNAME n 
		ON o.EMPL_SER_NO = n.EMPL_SER_NO 
	INNER JOIN dbo.MRTTSYS s 
		ON n.EMPL_SER_NO = s.EMPL_SER_NO 
	INNER JOIN dbo.MRTTWORK w 
		ON n.EMPL_SER_NO = w.EMPL_SER_NO 
	INNER JOIN dbo.MRTTGEN g 
		ON w.EMPL_SER_NO = g.EMPL_SER_NO 

	LEFT OUTER JOIN dbo.MRTTDEPT d 
		ON o.DEPT_NO = d.DEPT_NO 
		AND o.RPT_TO_SER_NO = d.MANAGER_SER_NO 

	INNER JOIN dbo.MRTT_SETID_BA_XREF sx													
		ON 
			o.DEPT_SETID_NO = sx.DEPT_SETID_NO AND
			o.[BUS_AREA_CD] = sx.[BUS_AREA_CD]
				
	INNER JOIN [dbo].[MRTT_BUS_AREA_LOOKUP] LU 		
		ON 	SX.BUS_AREA_CD = LU.BUS_AREA_CD 	


	LEFT OUTER JOIN (SELECT mo.RPT_TO_SER_NO, COUNT(mo.RPT_TO_SER_NO) AS num 
			FROM MRTTORG mo INNER JOIN MRTTGEN mg
				ON mo.EMPL_SER_NO = mg.EMPL_SER_NO
			WHERE mg.EMPL_STAT_CD IN ('A', 'L', 'P')
			GROUP BY mo.RPT_TO_SER_NO) dr 
		ON o.EMPL_SER_NO = dr.RPT_TO_SER_NO

WHERE 
o.EMPL_TYPE_CD &lt;&gt; 'V'					-- Employee is not a vendor
AND g.EMPL_STAT_CD IN ('A', 'L', 'P', 'T', 'D', 'R')	-- Employee's status is valid (Active, Leave, PaidLeave, Terminated, Deceased, Retired)</property>
