<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<location path="." inheritInChildApplications="false">
		<system.webServer>
			<handlers>
				<add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
			</handlers>
			<aspNetCore processPath="dotnet" arguments=".\ProPricerWebApi.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="InProcess">
				<!--<environmentVariables>
					<environmentVariable name="EPP_ENVIRONMENT" value="Local" />
					<environmentVariable name="APPLICATION_VERSION" value="Local - WIP" />
					<environmentVariable name="ASPNETCORE_HTTPS_PORT" value="44386" />
				</environmentVariables>-->
			</aspNetCore>
		</system.webServer>
	</location>
</configuration>