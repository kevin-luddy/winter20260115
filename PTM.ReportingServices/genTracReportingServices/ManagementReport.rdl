<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="genTrac">
      <DataSourceReference>genTrac</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>b2bf5e27-b5e4-4db6-a7d2-158c3d6a4491</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>genTrac</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT COUNT (P.ProposalID)
FROM dbo.Proposal P 
WHERE CAST (DateCreated AS DATE) BETWEEN @StartDate AND @EndDate
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="ID">
          <DataField />
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>genTrac</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT COUNT (P.ProposalID)
FROM dbo.Proposal P 
	INNER JOIN dbo.ProposalChecklist PC ON P.ProposalID = PC.ProposalID
WHERE ProposalSubmittalDate BETWEEN @StartDate AND @EndDate
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="ID">
          <DataField />
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Sunday">
      <Query>
        <DataSourceName>genTrac</DataSourceName>
        <CommandText>SELECT DISTINCT
CONVERT(varchar(20), DateAdd(day, -(DatePart(dw, DateCreated) - 1), DateCreated), 110) AS [Sunday],
YEAR(CONVERT(varchar(20), DateAdd(day, -(DatePart(dw, DateCreated) - 1), DateCreated), 110)) AS [Year],
Month(CONVERT(varchar(20), DateAdd(day, -(DatePart(dw, DateCreated) - 1), DateCreated), 110)) AS [Month],
DAY(CONVERT(varchar(20), DateAdd(day, -(DatePart(dw, DateCreated) - 1), DateCreated), 110)) AS [Day] 
FROM dbo.Proposal
ORDER BY 
YEAR(CONVERT(varchar(20), DateAdd(day, -(DatePart(dw, DateCreated) - 1), DateCreated), 110)) DESC,
Month(CONVERT(varchar(20), DateAdd(day, -(DatePart(dw, DateCreated) - 1), DateCreated), 110)) DESC,
DAY(CONVERT(varchar(20), DateAdd(day, -(DatePart(dw, DateCreated) - 1), DateCreated), 110)) DESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Sunday">
          <DataField>Sunday</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Year">
          <DataField>Year</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Month">
          <DataField>Month</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Day">
          <DataField>Day</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Saturday">
      <Query>
        <DataSourceName>genTrac</DataSourceName>
        <CommandText>/*EVERY SATURDAY IN THE SYSTEM*/
SELECT DISTINCT
CONVERT(varchar(20), DateAdd(day, 6, DateAdd(day, -(DatePart(dw, DateCreated) - 1), DateCreated)), 110) AS [Saturday],
YEAR(CONVERT(varchar(20), DateAdd(day, 6, DateAdd(day, -(DatePart(dw, DateCreated) - 1), DateCreated)), 110)) AS [Year],
Month(CONVERT(varchar(20), DateAdd(day, 6, DateAdd(day, -(DatePart(dw, DateCreated) - 1), DateCreated)), 110)) AS [Month],
DAY(CONVERT(varchar(20), DateAdd(day, -(DatePart(dw, DateCreated) - 1), DateCreated), 110)) AS [Day]  
FROM dbo.Proposal
ORDER BY 
YEAR(CONVERT(varchar(20), DateAdd(day, 6, DateAdd(day, -(DatePart(dw, DateCreated) - 1), DateCreated)), 110)) DESC,
Month(CONVERT(varchar(20), DateAdd(day, 6, DateAdd(day, -(DatePart(dw, DateCreated) - 1), DateCreated)), 110)) DESC,
DAY(CONVERT(varchar(20), DateAdd(day, -(DatePart(dw, DateCreated) - 1), DateCreated), 110)) DESC 
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Saturday">
          <DataField>Saturday</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Year">
          <DataField>Year</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Month">
          <DataField>Month</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Day">
          <DataField>Day</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>genTrac</DataSourceName>
        <CommandText>SELECT COUNT(*) AS [Total Number of Proposals], L.ProposalStatus
FROM dbo.Proposal P
	INNER JOIN dbo.ProposalStatusLU L ON P.ProposalStatusID = L.ProposalStatusID
GROUP BY L.ProposalStatus</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Total_Number_of_Proposals">
          <DataField>Total Number of Proposals</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ProposalStatus">
          <DataField>ProposalStatus</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
