<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <FullPath>Debug</FullPath>
    <OutputPath>bin\Debug</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2008R2</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>genTracReportingServices</TargetReportFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <StartItem>Proposal Activity Report.rdl</StartItem>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <FullPath>Release</FullPath>
    <OutputPath>bin\Release</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2008</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>genTracReportingServices</TargetReportFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'DEV Deploy No Build' ">
    <FullPath>DEV Deploy No Build</FullPath>
    <OutputPath>bin\DEVDeployNoBuild</OutputPath>
    <ErrorLevel>0</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2008R2</TargetServerVersion>
    <Platform />
    <TargetReportFolder>/generation/genTRAC</TargetReportFolder>
    <TargetDatasetFolder>/generation/genTRAC</TargetDatasetFolder>
    <TargetDatasourceFolder>/generation/genTRAC</TargetDatasourceFolder>
    <TargetReportPartFolder>/generation/genTRAC</TargetReportPartFolder>
    <TargetServerURL>https://sscreports-dev.ssc.lmco.com/ReportServer_SSRS30D</TargetServerURL>
    <StartItem>Proposal Activity Report.rdl</StartItem>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'QAS Deploy No Build' ">
    <FullPath>QAS Deploy No Build</FullPath>
    <OutputPath>bin\QASDeployNoBuild</OutputPath>
    <ErrorLevel>0</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2008R2</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>/generation/genTRAC</TargetReportFolder>
    <TargetDatasetFolder>/generation/genTRAC</TargetDatasetFolder>
    <TargetDatasourceFolder>/generation/genTRAC</TargetDatasourceFolder>
    <TargetReportPartFolder>/generation/genTRAC</TargetReportPartFolder>
    <TargetServerURL>https://sscreports-qas.ssc.lmco.com/ReportServer_SSRS30A</TargetServerURL>
    <StartItem>Proposal Activity Report.rdl</StartItem>
  </PropertyGroup>
  <PropertyGroup>
    <State>$base64$</State>
    <DataSources>@(DataSource)</DataSources>
    <DataSets>@(DataSet)</DataSets>
    <Reports>@(Report)</Reports>
  </PropertyGroup>
  <ItemGroup>
    <DataSource Include="genTrac.rds" />
  </ItemGroup>
  <ItemGroup>
    <Report Include="ACV Usage Data - Complete.rdl" />
    <Report Include="ACV Usage Data.rdl" />
    <Report Include="DFARS Non-Standard Responses.rdl" />
    <Report Include="ManagementReport.rdl" />
    <Report Include="PAR Checklist Report.rdl" />
    <Report Include="Proposal Activity Report.rdl" />
    <Report Include="Proposal Dashboard Report.rdl" />
    <Report Include="Proposal Log Report.rdl" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Reporting Services\Microsoft.ReportingServices.MSBuilder.targets" />
</Project>