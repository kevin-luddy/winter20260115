  <Code>Public Function CurrencyFormat(ByVal str as String) As String
If String.IsNullOrEmpty(str) Then
  Return ""
Else
  Return FormatCurrency(str)
End If
End Function

Public Function DateFormat(ByVal dt as DateTime) As String
  Return Format(dt, "MM/dd/yyyy")
End Function
